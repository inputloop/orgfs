CSS
}

# the expanded declaration as HTML: headings, paragraphs, lists, property drawers and tables only
ORG_HTML_AWK='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
function inl(s,   out) {
  s = esc(s); out = ""
  while (match(s, /=[^= ][^=]*=/)) { out = out substr(s, 1, RSTART - 1) "<code>" substr(s, RSTART + 1, RLENGTH - 2) "</code>"; s = substr(s, RSTART + RLENGTH) }
  return out s
}
function closep() { if (para) { print "</p>"; para = 0 } if (inul) { print "</ul>"; inul = 0 } }
function closet() { if (intab) { print "</tbody>\n</table>\n</div>"; intab = 0 } }
BEGIN { para = 0; inul = 0; intab = 0; indrw = 0; ntab = 0 }
indrw { if ($0 == ":END:") { print "</dl>"; indrw = 0; next }
  if (match($0, /^:[A-Za-z_-]+:/)) { k = substr($0, 2, RLENGTH - 2); v = substr($0, RLENGTH + 1); sub(/^[ \t]+/, "", v); printf "<dt>%s</dt><dd>%s</dd>\n", esc(k), esc(v) }
  next }
/^\*+ / { closep(); closet(); n = 0; while (substr($0, n + 1, 1) == "*") n++; h = n + 1; if (h > 6) h = 6; t = substr($0, n + 2); printf "<h%d>%s</h%d>\n", h, inl(t), h; next }
/^:PROPERTIES:$/ { closep(); closet(); print "<dl>"; indrw = 1; next }
/^#\+NAME:/ { next }
/^\|/ {
  if ($0 ~ /^\|[-+|]*$/) next
  closep()
  n = split($0, c, "|")
  if (!intab) { ntab++; printf "<div class=\"scroll\" role=\"region\" aria-label=\"Table %d of the declaration\" tabindex=\"0\">\n<table>\n<caption>The table of atoms and their hashes</caption>\n<thead><tr>", ntab
    for (m = 2; m < n; m++) { sub(/^ +/, "", c[m]); sub(/ +$/, "", c[m]); printf "<th scope=\"col\">%s</th>", inl(c[m]) }
    print "</tr></thead>\n<tbody>"; intab = 1; next }
  printf "<tr>"
  for (m = 2; m < n; m++) { sub(/^ +/, "", c[m]); sub(/ +$/, "", c[m]); if (m == 2) printf "<th scope=\"row\">%s</th>", inl(c[m]); else printf "<td>%s</td>", inl(c[m]) }
  print "</tr>"; next }
/^[ \t]*$/ { closep(); closet(); next }
/^- / { closet(); if (para) { print "</p>"; para = 0 } if (!inul) { print "<ul>"; inul = 1 } printf "<li>%s</li>\n", inl(substr($0, 3)); next }
{ closet(); if (inul) { print "</ul>"; inul = 0 } if (!para) { printf "<p>"; para = 1 } else printf "\n"; printf "%s", inl($0) }
END { closep(); closet() }
'

html_head() { # TITLE PAGE
  cat <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'">
<title>$1 - orgfs</title>
<link rel="stylesheet" href="orgfs.css">
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<header>
<p class="brand">orgfs</p>
<nav aria-label="Site">
<ul>
<li><a href="index.html"$(cur index "$2")>About</a></li>
$([ "${_allpublic:-0}" != 1 ] || printf '<li><a href="declaration.html"%s>The declaration</a></li>\n' "$(cur declaration "$2")")
<li><a href="gaps.html"$(cur gaps "$2")>A view with its gaps</a></li>
<li><a href="licensing.html"$(cur licensing "$2")>Licensing stack</a></li>
<li><a href="rights.html"$(cur rights "$2")>Your rights on this site</a></li>
</ul>
</nav>
</header>
<main id="main">
EOF
}

html_foot() {
  cat <<EOF
</main>
<footer>
<p>orgfs $VERSION. Code: GPL-3.0-or-later. Prose and this site&#39;s text: CC-BY-SA-4.0.
Copyright 2026 Corwin Brust &lt;corwin@bru.st&gt; and Contributors.
Source: <a href="https://github.com/inputloop/orgfs">github.com/inputloop/orgfs</a>.</p>
</footer>
</body>
</html>
EOF
}

# one spoke, as the public site shows it (the site is a visitor: private roots and sealed spokes are gaps)
site_spoke() {
  _e=$(esc_s "$SPOKE")
  if [ "$VIS" = sealed ]; then
    cat <<EOF
<div class="gap">
<h3>Spoke $_e: withheld</h3>
<dl>
<dt>What</dt><dd>1 spoke, $(n_members) members; only its name is shown</dd>
<dt>Rule</dt><dd>VISIBILITY sealed: a non-member is told the spoke exists and what it is called, nothing more</dd>
<dt>Declared at</dt><dd>$(esc_s "$(at_spoke VISIBILITY)")</dd>
<dt>Why</dt><dd>the spoke is sealed and this site is not one of its members</dd>
<dt>Who can reach it</dt><dd>members of spoke $_e (names withheld: sealed)</dd>
<dt>Route</dt><dd>on a member: <code>orgfs materialize DECL --as MEMBER --spoke $_e</code></dd>
</dl>
</div>
EOF
    return 0
  fi
  make_plan
  cat <<EOF
<h3>Spoke $_e</h3>
<dl>
<dt>Spoke identity</dt><dd><code>$ID</code></dd>
<dt>Ring</dt><dd>$(esc_s "$RING")</dd>
<dt>Stripes</dt><dd>$(esc_s "$STRIPES")</dd>
<dt>Replicas</dt><dd>$(esc_s "$REPLICAS")</dd>
<dt>Visibility</dt><dd>$(esc_s "$VIS")</dd>
</dl>
<div class="scroll" role="region" aria-label="Members of spoke $_e" tabindex="0">
<table>
<caption>Members of spoke $_e</caption>
<thead><tr><th scope="col">Member</th><th scope="col">Transport</th><th scope="col">Root</th></tr></thead>
<tbody>
EOF
  for _h in $MEMBERS; do
    if [ "$VIS" = public ]; then _root="<code>$(esc_s "$(root_of "$_h")")</code>"
    else _root="withheld (private spoke; see the gap records)"; fi
    printf '<tr><th scope="row">%s</th><td>%s</td><td>%s</td></tr>\n' "$(esc_s "$_h")" "$(esc_s "$(tr_of "$_h")")" "$_root"
  done
  cat <<EOF
</tbody>
</table>
</div>
<div class="scroll" role="region" aria-label="Plan of spoke $_e" tabindex="0">
<table>
<caption>Which member holds which stripe of spoke $_e</caption>
<thead><tr><th scope="col">Stripe</th>
EOF
  for _h in $MEMBERS; do printf '<th scope="col">%s</th>' "$(esc_s "$_h")"; done
  printf '</tr></thead>\n<tbody>\n'
  $AWK -F'\t' -v members="$(printf '%s' "$MEMBERS" | tr '\n' ' ')" '
    BEGIN { nm = split(members, m, " ") }
    { split("", hold); n = split($2, a, " "); for (k = 1; k <= n; k++) hold[a[k]] = 1
      printf "<tr><th scope=\"row\">%s</th>", $1
      for (k = 1; k <= nm; k++) printf "%s", (m[k] in hold) ? "<td class=\"yes\">holds</td>" : "<td class=\"no\">no</td>"
      printf "</tr>\n" }' "$TMP/plan"
  cat <<EOF
</tbody>
</table>
</div>
EOF
}

cmd_site() {
  _decl=${1:-}; _out=${2:-}
  [ -n "$_decl" ] && [ -n "$_out" ] || die "site: need DECL OUT"
  load "$_decl"
  [ -f "$SHARE/licensing.tsv" ] || die "site: missing $SHARE/licensing.tsv"
  mkdir -p "$_out" || die "site: cannot create $_out"
  write_css "$_out/orgfs.css"
  cp "$SHARE/licensing.tsv" "$_out/licensing.tsv"
  $AWK "$REGISTER_TXT_AWK" "$SHARE/licensing.tsv" > "$_out/licensing.txt" || die "site: bad register"
  _allpublic=1
  for _s in $SPOKES; do load_spoke "$_s"; [ "$VIS" = public ] || _allpublic=0; done
  _nplural=spokes; [ "$NSP" != 1 ] || _nplural=spoke
  {
    html_head "About" index
    cat <<EOF
<h1>orgfs</h1>
<p class="status">Status: orgfs $VERSION, before 1.0. Tested on Linux (dash, bash, busybox sh; gawk, mawk); Windows, macOS and the BSDs not yet tested. Built by <code>orgfs site</code> from a declaration of $NSP $_nplural, file identity <code>$FILEID</code>. Nothing on this page says the tests passed; run <code>make check</code>.</p>

<h2>What you get</h2>
<p>You can spread a file over a group of machines and lose one without losing the
file. You can also hand a machine a <em>view</em> of the group&#39;s storage in which
nothing is silently left out: every omission is written down as a gap record that
says what is missing, why, which line of the declaration says so, who could reach
it and by which command. The group, the stripes and the copies come from one plain
Org file, the <em>declaration</em>, which every machine holds identically.</p>

<h2>What was asked</h2>
<p><span class="tag">asked</span>Corwin Brust, 2026-11-06, about the first cut (short quotes; the full text is kept with the project, not here):</p>
<blockquote>
<p>&quot;a file materialized per host should contains double linkage to information it fetches rather than displays&quot;</p>
<p>&quot;if we can scrub/redact/withold/drop some information we carry, then we can say how to do it and why each time, every time&quot;</p>
<p>&quot;we should always be able to assemble a collection at whatever grain/cross-grain intersection or collection that a user can reach&quot;</p>
<p>&quot;[ROOT as a path every member sees] is preferred, or at least &#39;my thoughts exactly&#39;&quot;</p>
<footer>on the page: &quot;good in that it doesn&#39;t look like other things not as good in the particulars&quot;</footer>
</blockquote>

<h2>What was observed</h2>
<p><span class="tag">observed</span>By <code>orgfs check</code> and <code>orgfs plan</code> on the declaration this site was built from.
The declaration is stored as atoms: small Org files, each beginning with its own heading, and a story that sets them in order with Org&#39;s own <code>#+INCLUDE</code>.
<code>orgfs compose</code> builds the one file that travels alone (what Org&#39;s export makes of the story) and <code>orgfs decompose</code> splits it back
at the <code>:ORGFS_ATOM:</code> headings, byte for byte; every command gives the same identity whichever form it is given.
Each spoke has its own identity (the SHA-256 of its normalized properties) and the file has one
made from the spokes&#39; identities, sorted, so neither the order of the spokes nor the prose changes either.</p>
EOF
    for _s in $SPOKES; do load_spoke "$_s"; site_spoke; done
    if [ "$_allpublic" = 1 ]; then
      cat <<EOF
<p>The declaration itself, prose included, as <a href="declaration.html">a page</a> and as the file <a href="declaration.org">declaration.org</a>.</p>
EOF
    else
      cat <<EOF
<p>The declaration file is not published because at least one spoke in it is not public.</p>
EOF
    fi
    cat <<EOF

<h2>What was judged</h2>
<ul>
<li><span class="tag">choice</span>The file is Org&#39;s own: atoms are brought in by <code>#+INCLUDE</code> and marked by an <code>:ORGFS_ATOM:</code> property. Reason: a marker of our own would be a small language to learn,
and Org already has both an include and a place for a property. Would be wrong if Org&#39;s export expands the same source to other bytes than <code>orgfs compose</code> writes;
<code>tests/org_check.el</code> asks Emacs, and says NOT CHECKED where there is none.</li>
<li><span class="tag">choice</span>Atoms are what is stored; the single file is composed from them. Reason: a change to one
member is a change to one small file, and the one literate file is still there to read, at any time, as the
composition. Would be wrong if reading a spoke means opening so many files that the composed file is what people
edit after all; <code>tests/test_atoms.py</code> composes, decomposes and compares the bytes to look for drift.</li>
<li><span class="tag">choice</span>Several spokes per declaration, each with its own identity and the declaration with one too.
Reason: the question names the spoke, so no rule outside the declaration says which spoke a host is asked about.
Would be wrong if two hosts given the same declaration and the same question
ever disagree about the answer; <code>tests/test_orgfs.py</code> shuffles spoke order to look for that.</li>
<li><span class="tag">choice</span>ROOT is the same path on every member. Reason: nothing host-specific then needs to be written
anywhere. Would be wrong if a host cannot mount another member&#39;s storage at the same path.</li>
<li><span class="tag">concern</span><code>--as HOST</code> is a claim, not a login; orgfs does not authenticate it. Would be wrong
(a non-issue) if every host that can run orgfs is already trusted to be any member.</li>
</ul>

<h2>Not checked</h2>
<ul>
<li>Anything on a real ghostwheel host: the tests use local directories for hosts.</li>
<li>Operating systems other than Linux, and sshfs mounts made for real.</li>
<li>That a browser shows this page as intended in any particular browser or printer.</li>
</ul>
EOF
    html_foot
  } > "$_out/index.html"
  if [ "$_allpublic" = 1 ]; then
    if [ -d "$_decl" ]; then ( compose_dir "$_decl" "$_out/declaration.org" m ) || die "site: cannot compose $_decl"
    else cp "$DECLFILE" "$_out/declaration.org"; fi
    {
      html_head "The declaration" declaration
      cat <<EOF
<h1>The declaration, as a story</h1>
<p class="status">Status: the declaration this site was built from (file identity <code>$FILEID</code>), composed from its atoms and shown as a page. The same text, as Org, is <a href="declaration.org">declaration.org</a>.</p>
EOF
      $AWK "$ORG_HTML_AWK" "$_out/declaration.org"
      cat <<EOF

<h2>Not checked</h2>
<ul>
<li>That the hosts named in the story are as it says; the story marks which sentences are facts, which are judgements and which are examples, and none of them was checked from this page.</li>
<li>That a browser shows this page as intended in any particular browser or printer.</li>
</ul>
EOF
      html_foot
    } > "$_out/declaration.html"
  fi

  # the demo world: a view for a visitor, gaps and all
  _w=$TMP/siteworld
  make_world "$_w"
  _w=$WORLD
  world_fill
  orgfs_run materialize "$_w/world.org" --as visitor --out "$_w/visitor.org" > /dev/null || die "site: demo materialize failed"
  sed "s#$_w#/demo#g" "$_w/visitor.org" > "$_out/view-visitor.org"
  $AWK -v mode=tsv "$GAPS_AWK" "$_w/visitor.org" | sed "s#$_w#/demo#g" > "$TMP/gaps.tsv" || die "site: demo view has an incomplete gap"
  _ngaps=$(wc -l < "$TMP/gaps.tsv" | tr -d ' ')
  _vid=$(tail -n 1 "$_w/visitor.org" | sed 's/^# view-id: //')
  {
    html_head "A view with its gaps" gaps
    cat <<EOF
<h1>A view with its gaps</h1>
<p class="status">Status: demo output, not a record of any real host. Built by <code>orgfs site</code> from a throwaway declaration of 3 spokes over local directories, then <code>orgfs materialize --as visitor</code>. $_ngaps gap records.</p>

<h2>What you get</h2>
<p>If you are a host that belongs to none of these spokes, this is what you may be shown of them.
Where something is left out you are not left guessing: each gap says what it stands for (by kind and shape, never content),
the rule that withheld it, the line of the declaration that states the rule, who could reach it and the command that would fill it.</p>

<h2>What was observed</h2>
<p><span class="tag">observed</span>The three spokes of the demo, as a visitor sees them:
<code>licensing</code> is public (its roots and objects are shown, each item naming its source);
<code>ring-notes</code> is private (members are named, roots withheld, the store is not read);
<code>vault</code> is sealed (the name only).</p>
<div class="scroll" role="region" aria-label="Gap records in the view" tabindex="0">
<table>
<caption>The $_ngaps gap records in the visitor&#39;s view</caption>
<thead><tr><th scope="col">Gap</th><th scope="col">Kind</th><th scope="col">What (shape)</th><th scope="col">Rule</th><th scope="col">Declared at</th><th scope="col">Who can reach it</th></tr></thead>
<tbody>
EOF
    $AWK -F'\t' '
      function e(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
      { printf "<tr><th scope=\"row\"><code>%s</code></th><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n", e($1), e($2), e($3), e($4), e($5), e($6) }' "$TMP/gaps.tsv"
    cat <<EOF
</tbody>
</table>
</div>

<h2>One gap, in full</h2>
<p>The private spoke&#39;s first member, as the visitor sees it. The root path is not in the view at all; the gap says where the rule is written and who can ask for it.</p>
<pre tabindex="0">$($AWK '/^\*+ gap ring-notes\/member-root\// { p = 1 } p { print } p && /^:END:/ { exit }' "$_w/visitor.org" | sed "s#$_w#/demo#g" | esc)</pre>

<h2>What an item that was fetched looks like</h2>
<p>An object of the public spoke, with its first slice. Every fetched item names its spoke, object, slice, member and path;
the member&#39;s store keeps a record of this view in the file named by <code>BACKLINK</code>, so either end can be followed to the other
(<code>orgfs trace</code>).</p>
<pre tabindex="0">$($AWK '/^\*\* object / { p = 1 } /^\*\*\* slice / { s++ } s > 1 { exit } p { print }' "$_w/visitor.org" | sed "s#$_w#/demo#g" | esc)</pre>

<h2>What was judged</h2>
<ul>
<li><span class="tag">choice</span>A view carries manifest rows, never slice bytes, so each slice has a gap record of its own. Reason: then the rule &quot;no withholding without a gap record&quot; has no exception. Would be wrong if readers find the slice gaps drown the others; the gap table above would show it.</li>
<li><span class="tag">concern</span>The demo&#39;s directory is replaced by <code>/demo</code> on this page and in <a href="view-visitor.org">view-visitor.org</a>.
The view-id <code>$_vid</code> was computed on the text before that replacement, so <code>orgfs trace</code> will not accept the rewritten copy. Would be wrong if you can rebuild the demo (<code>orgfs demo</code>) and see the same structure.</li>
</ul>

<h2>Not checked</h2>
<ul>
<li>Views of real hosts. Nothing here was produced on a ghostwheel host.</li>
<li>That the withholding rules are the ones the declaration&#39;s authors want for real spokes.</li>
</ul>
EOF
    html_foot
  } > "$_out/gaps.html"

  {
    html_head "Licensing stack" licensing
    cat <<EOF
<h1>The licensing stack</h1>
<p class="status">Status: register of $(( $(wc -l < "$SHARE/licensing.tsv" | tr -d ' ') - 1 )) entries, $(grep -c 'unchecked' "$SHARE/licensing.tsv") with a licence marked unchecked. Source URLs were not fetched when it was written.</p>
<h2>What you get</h2>
<p>You can see whose work this project uses to build, test, run and serve this site, and on what terms.
The table is also available as <a href="licensing.tsv">tab-separated data</a> and as <a href="licensing.txt">plain text</a>;
orgfs stores those same two files in its own demo spoke.</p>
<h2>What was observed</h2>
<p><span class="tag">observed</span>Where a licence could be read from a Debian <code>copyright</code> file on the machine the register was written on
(dash, gawk, mawk, make, git, OpenSSH), that is what it says. The others are stated from the project&#39;s own known licence.
A licence marked <strong>unchecked</strong> is one we have not confirmed from the project&#39;s own licence text. We say so instead of guessing.</p>
<div class="scroll" role="region" aria-label="Licensing stack table" tabindex="0">
<table>
<caption>Software in use, licence, source and reason</caption>
<thead><tr><th scope="col">Name</th><th scope="col">Licence</th><th scope="col">Source</th><th scope="col">Why we use it</th></tr></thead>
<tbody>
EOF
    $AWK -F'\t' '
      function e(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
      NR == 1 { next }
      { src = e($3)
        if ($3 ~ /^https?:\/\//) src = "<a href=\"" src "\">" src "</a>"
        printf "<tr><th scope=\"row\">%s</th><td>%s</td><td>%s</td><td>%s</td></tr>\n", e($1), e($2), src, e($4) }' "$SHARE/licensing.tsv"
    cat <<EOF
</tbody>
</table>
</div>
<h2>Not checked</h2>
<ul>
<li>The entries marked unchecked.</li>
<li>Every source URL: none was fetched.</li>
</ul>
EOF
    html_foot
  } > "$_out/licensing.html"

  {
    html_head "Your rights on this site" rights
    cat <<EOF
<h1>Your rights on this site</h1>
<p class="status">Status: this page replaces a terms-of-use screen. One of its three statements is a promise by the people who run the server; two you can check yourself.</p>
<h2>What you get</h2>
<p>You are told what this site does and does not do to you, in plain words, before you have to ask.</p>
<h2>What this site does not do</h2>
<ul>
<li>It keeps no access log.</li>
<li>It sets no cookies.</li>
<li>It loads nothing from another host: every page and the one style sheet come
from this same host. There are no scripts, fonts, images, embeds or analytics.</li>
</ul>
<h2>What you can check yourself</h2>
<p><span class="tag">observed</span>The first statement is a promise; your browser
cannot prove it. The other two you can look at: view the source of any page, or the
network panel of your browser. You will find no script and no address on another
host that the page fetches. <span class="tag">judged</span>Would be wrong if the network panel shows a request to a second host.</p>
<h2>Links to other places</h2>
<p>Some text links to other sites, such as the project&#39;s source. They are links
only. Nothing is fetched from them unless you choose to follow one, and then that
site&#39;s own rules apply.</p>
<h2>Your licence to the content</h2>
<p>The program is free software under the GNU General Public License, version 3 or
(at your option) any later version. The text of this site is licensed under
Creative Commons Attribution-ShareAlike 4.0. You may copy, study, change and share
both, on those terms. The <a href="licensing.html">licensing stack</a> page lists
the licences of the other software involved.</p>
<h2>Not checked</h2>
<ul>
<li>That the server is configured the way the first statement says; this tool cannot make it so.</li>
</ul>
EOF
    html_foot
  } > "$_out/rights.html"
  printf 'site: wrote %s (index.html gaps.html licensing.html rights.html orgfs.css view-visitor.org)\n' "$_out"
}

# ------------------------------------------------------------------ demo
_self=$HERE/$(basename "$0")
orgfs_run() { ${ORGFS_SHELL:-sh} "$_self" "$@"; }

# DIR gets world.d (the atoms), world.org (composed from them) and the files to store.
#   licensing  public   5 members  5 stripes 2 replicas   (the register, as .tsv and .txt)
#   ring-notes private  3 members  3 stripes 2 replicas   (one short note)
#   vault      sealed   2 members  2 stripes 1 replica    (nothing may be put in a sealed spoke)
mw_spoke() { # NAME RING STRIPES REPLICAS VISIBILITY
  mkdir -p "$mw/world.d/$1" || die "demo: cannot create $mw/world.d/$1"
  printf '* spoke %s\n:PROPERTIES:\n:ORGFS_ATOM: %s/spoke.org\n:RING: %s\n:STRIPES: %s\n:REPLICAS: %s\n:VISIBILITY: %s\n:END:\n' "$1" "$1" "$2" "$3" "$4" "$5" > "$mw/world.d/$1/spoke.org"
}
mw_member() { # SPOKE HOST ROOT
  printf '* member %s\n:PROPERTIES:\n:ORGFS_ATOM: %s/member-%s.org\n:ROOT: %s\n:TRANSPORT: local\n:END:\n' "$2" "$1" "$2" "$3" > "$mw/world.d/$1/member-$2.org"
}
make_world() {
  mw=$1; mkdir -p "$mw" || die "demo: cannot create $mw"
  WORLD=$(cd "$mw" && pwd); mw=$WORLD
  mw_n=1; while [ "$mw_n" -le 5 ]; do mkdir -p "$mw/demo$mw_n"; mw_n=$((mw_n + 1)); done
  mw_n=1; while [ "$mw_n" -le 3 ]; do mkdir -p "$mw/private/demo$mw_n"; mw_n=$((mw_n + 1)); done
  mkdir -p "$mw/vault/demo4" "$mw/vault/demo5" "$mw/world.d"
  printf '* world, a throwaway demo declaration\n:PROPERTIES:\n:ORGFS_ATOM: preface.org\n:END:\nThree spokes, three visibilities, over local directories standing in for hosts.\nThe atoms are the record; world.org is composed from them.\n' > "$mw/world.d/preface.org"
  mw_spoke licensing GREAT 5 2 public
  mw_n=1; while [ "$mw_n" -le 5 ]; do mw_member licensing "demo$mw_n" "$mw/demo$mw_n"; mw_n=$((mw_n + 1)); done
  mw_spoke ring-notes GRAIN 3 2 private
  mw_n=1; while [ "$mw_n" -le 3 ]; do mw_member ring-notes "demo$mw_n" "$mw/private/demo$mw_n"; mw_n=$((mw_n + 1)); done
  mw_spoke vault GRAIN 2 1 sealed
  mw_n=4; while [ "$mw_n" -le 5 ]; do mw_member vault "demo$mw_n" "$mw/vault/demo$mw_n"; mw_n=$((mw_n + 1)); done
  ( compose_dir "$mw/world.d" "$mw/world.org" m ) || die "demo: cannot compose the atoms"
  cp "$SHARE/licensing.tsv" "$mw/licensing.tsv"
  $AWK "$REGISTER_TXT_AWK" "$mw/licensing.tsv" > "$mw/licensing.txt" || die "demo: bad register"
  printf 'A short note kept in the private spoke of the demo.\nIts members may read it; a visitor is told it exists and nothing more.\n' > "$mw/note.txt"
}

world_fill() { # quiet puts; sets ID_TSV ID_TXT ID_NOTE
  ID_TSV=$(orgfs_run put "$WORLD/world.org" "$WORLD/licensing.tsv" --spoke licensing) || die "demo: put failed"
  ID_TXT=$(orgfs_run put "$WORLD/world.org" "$WORLD/licensing.txt" --spoke licensing) || die "demo: put failed"
  ID_NOTE=$(orgfs_run put "$WORLD/world.org" "$WORLD/note.txt" --spoke ring-notes) || die "demo: put failed"
}

cmd_demo() {
  _keep=${1:-}
  [ -f "$SHARE/licensing.tsv" ] || die "demo: missing $SHARE/licensing.tsv"
  if [ -n "$_keep" ]; then _d=$_keep; mkdir -p "$_d"; else _d=$(mktemp -d "${TMPDIR:-/tmp}/orgfs-demo.XXXXXX"); fi
  make_world "$_d"
  _d=$WORLD
  _w=$_d/world.org
  echo "== demo directory: $_d"
  echo "== check (the composed file, then the atoms it was composed from)"
  orgfs_run check "$_w" || exit 1
  _i1=$(orgfs_run check "$_w" --no-mounts | grep '^file-identity')
  _i2=$(orgfs_run check "$_d/world.d" --no-mounts | grep '^file-identity')
  [ "$_i1" = "$_i2" ] || die "demo: the atoms and the composed file disagree about identity"
  echo "same file identity from the atoms in world.d and from world.org: yes"
  orgfs_run compose "$_d/world.d" --out "$_d/again.org" > /dev/null || exit 1
  cmp "$_d/world.org" "$_d/again.org" || die "demo: composing twice gave different files"
  echo "composing the atoms again gives the same bytes: yes"
  echo "== plan (spoke licensing)"
  orgfs_run plan "$_w" --spoke licensing
  echo "== put"
  world_fill
  echo "licensing.tsv  $ID_TSV  (spoke licensing)"
  echo "licensing.txt  $ID_TXT  (spoke licensing)"
  echo "note.txt       $ID_NOTE  (spoke ring-notes)"
  echo "== get"
  mkdir -p "$_d/out"
  orgfs_run get "$_w" "$ID_TSV" "$_d/out/licensing.tsv" --spoke licensing || exit 1
  orgfs_run get "$_w" "$ID_TXT" "$_d/out/licensing.txt" --spoke licensing || exit 1
  cmp "$_d/licensing.tsv" "$_d/out/licensing.tsv" || die "demo: tsv came back different"
  cmp "$_d/licensing.txt" "$_d/out/licensing.txt" || die "demo: txt came back different"
  echo "bytes identical to the originals: yes"
  echo "== verify"
  orgfs_run verify "$_w" --spoke licensing || exit 1
  echo "== lose one member (demo3's stored data moved aside)"
  mv "$_d/demo3/.orgfs" "$_d/demo3-orgfs-aside"
  orgfs_run get "$_w" "$ID_TSV" "$_d/out/again.tsv" --spoke licensing || exit 1
  cmp "$_d/licensing.tsv" "$_d/out/again.tsv" || die "demo: degraded get came back different"
  echo "get still works with one member gone: yes"
  orgfs_run verify "$_w" --spoke licensing && echo "(unexpected: verify passed)" || echo "verify reports reduced redundancy, as it should"
  mv "$_d/demo3-orgfs-aside" "$_d/demo3/.orgfs"
  orgfs_run verify "$_w" --spoke licensing || exit 1
  echo "== materialize as visitor (a host in none of the spokes)"
  orgfs_run materialize "$_w" --as visitor --out "$_d/out/visitor.org" || exit 1
  _ng=$($AWK '/^\*+ gap /{ n++ } END { print n + 0 }' "$_d/out/visitor.org")
  echo "gap records in the visitor's view: $_ng"
  if grep -q "$_d/private" "$_d/out/visitor.org" || grep -q "$_d/vault" "$_d/out/visitor.org"; then
    die "demo: a private or sealed path leaked into the visitor's view"
  fi
  echo "private and sealed paths in the visitor's view: none"
  orgfs_run routes "$_d/out/visitor.org" | tail -n 1
  echo "== assemble as demo1 (a member of ring-notes)"
  orgfs_run assemble "$_w" --as demo1 --spoke ring-notes --into "$_d/asm" --out "$_d/out/demo1.org" || exit 1
  cmp "$_d/note.txt" "$_d/asm/ring-notes/$ID_NOTE" || die "demo: the assembled note differs"
  echo "the member's collection holds the private note, bytes identical: yes"
  echo "== trace (the note, back to the views that fetched it)"
  orgfs_run trace "$_w" --spoke ring-notes --object "$ID_NOTE"
  orgfs_run trace "$_d/out/demo1.org" || exit 1
  echo "== report"
  echo "3 spokes (public, private, sealed); both licensing files restored and verified; the visitor's view has $_ng gap records, each with its rule, its line and its routes."
  if [ -z "$_keep" ]; then rm -rf "$_d"; else echo "kept: $_d"; fi
}

# ------------------------------------------------------------------ main
_cmd=${1:-}
[ $# -gt 0 ] && shift
_n=$#
while [ "$_n" -gt 0 ]; do
  _a=$1; shift; _n=$((_n - 1))
  case $_a in
    --spoke|--as|--object|--out|--into|--root|--decl)
      [ "$_n" -gt 0 ] || die "$_a needs a value"
      _v=$1; shift; _n=$((_n - 1))
      case $_a in
        --spoke) O_SPOKE=$_v;; --as) O_AS=$_v;; --object) O_OBJECT=$_v;; --out) O_OUT=$_v;;
        --into) O_INTO=$_v;; --root) O_ROOT=$_v;; --decl) O_DECL=$_v;;
      esac;;
    --no-mounts) O_NOMOUNTS=1;;
    --source) O_SOURCE=1;;
    -*) die "unknown option: $_a";;
    *) set -- "$@" "$_a";;
  esac
done
case $_cmd in
  compose) cmd_compose "$@";;
  decompose) cmd_decompose "$@";;
  expand) cmd_expand "$@";;
  check) cmd_check "$@";;
  plan) cmd_plan "$@";;
  agree) cmd_agree "$@";;
  put) cmd_put "$@";;
  get) cmd_get "$@";;
  verify) cmd_verify "$@";;
  materialize) cmd_view materialize "$@";;
  assemble) cmd_view assemble "$@";;
  routes) cmd_routes "$@";;
  trace) cmd_trace "$@";;
  layout) cmd_layout "$@";;
  site) cmd_site "$@";;
  demo) cmd_demo "$@";;
  version|-V|--version) echo "orgfs $VERSION";;
  help|-h|--help|'') usage;;
  *) usage >&2; die "unknown command: $_cmd";;
esac
