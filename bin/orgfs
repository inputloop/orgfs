#!/bin/sh
# orgfs - fabricated spoke: literate distributed file systems per symmetric declaration
#
# Copyright 2026 Corwin Brust <corwin@bru.st> and Bryant Frankford (INPUTLOOP)
# SPDX-License-Identifier: GPL-3.0-or-later
#
# This program is free software: you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by the
# Free Software Foundation, either version 3 of the License, or (at your
# option) any later version.  It is distributed WITHOUT ANY WARRANTY; see
# the file COPYING.
#
# POSIX sh plus awk, sha256sum (or shasum -a 256), dd, sort, cut, tr, sed.
# No Python, no bashisms.  ORGFS_AWK picks the awk (default: awk).

set -u
LC_ALL=C
export LC_ALL
AWK=${ORGFS_AWK:-awk}
VERSION=0.5.0-dev
HERE=$(cd "$(dirname "$0")" && pwd)
SHARE=${ORGFS_SHARE:-$HERE/../share}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/orgfs.XXXXXX") || exit 1
trap 'rm -rf "$TMP"' EXIT
trap 'exit 1' INT TERM HUP

die() { printf 'orgfs: %s\n' "$*" >&2; exit 1; }
warn() { printf 'orgfs: warning: %s\n' "$*" >&2; }

if command -v sha256sum >/dev/null 2>&1; then
  sha_stdin() { sha256sum | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
  sha_stdin() { shasum -a 256 | cut -d' ' -f1; }
else
  die "need sha256sum or shasum"
fi
sha_str() { printf '%s' "$1" | sha_stdin; }
sha_file() { sha_stdin < "$1"; }
size_of() { wc -c < "$1" | tr -d ' '; }

usage() {
  cat <<'USAGE'
usage: orgfs COMMAND ...
  DECL is a declaration in any of its forms: a directory of atoms (the record: Org files, each
  beginning with its own heading, plus story.org that says where each belongs), the one expanded
  file made from them, or the source form of that file (the story, with #+INCLUDE lines).
  compose DIR [--source] [--out FILE]
                             the expanded file (what Org makes of the story's #+INCLUDE lines)
                             with its manifest table; --source: the story itself instead
  expand FILE [--out FILE]   expand the #+INCLUDE lines of a source form (the subset in README.org)
  decompose FILE DIR         split an expanded file at its :ORGFS_ATOM: headings back into the
                             atoms and story.org (byte for byte)
  check DECL [--spoke S] [--no-mounts]
                             parse and sanity-check a declaration; print identities
  plan DECL [--spoke S] [--as HOST]
                             which stripes each member holds (rendezvous hashing)
  agree DECL OTHER... [--spoke S]
                             refuse unless every declaration has the same identity
  put DECL FILE [--spoke S]  cut FILE into stripes and write them to the members
  get DECL ID OUT [--spoke S]
                             reassemble object ID into OUT, verifying every hash
  verify DECL [--spoke S]    every slice on REPLICAS members, every hash right
  materialize DECL --as HOST [--spoke S] [--object ID] [--out FILE]
                             the view HOST may have of DECL: what it fetches names its
                             source, what it may not see is a gap record that says why
  assemble DECL --as HOST --into DIR [--spoke S] [--object ID] [--out FILE]
                             gather what HOST may reach at that grain (bytes into DIR);
                             a gap record stands in for everything else
  routes VIEW                list every gap in a view and the routes that would fill it
  trace VIEW                 follow a view back to its sources and check they know it
  trace DECL --object ID [--spoke S]
                             follow an object to the hosts that materialized it
  layout [--root PREFIX] [--decl DECL]
                             check the host's fixed layout (/c4, /spokes, owners)
  site DECL OUT [--stack DIR [--live --build-run STAMP-HASH12 --build-commit SHA --build-log FILE]]
                             render a static, script-free HTML site into OUT; with --stack, also
                             stack.html from a stack directory (tools, licence guesses, corrections);
                             with --live that page says the machine that built the site read the
                             stack, but only if the atoms were read on this host during this build
  demo [DIR]                 the demo over 5 local directories and 3 spokes
  who REPO [PATH...] [--since DATE] [--until DATE] [--out FILE]
                             who worked on a local git repository, over time: an Org document in
                             which each contributor, path and commit links to the other two
  stack DIR [--seed FILE]    the tools this build stands on, one atom each, with versions, packages
                             and licences as read here; --seed starts from an earlier composed stack;
                             also a licence guess per package, with its confidence and history
  stack correct PACKAGE --says LICENCE --by NAME --why REASON [--stack DIR]
                             propose a correction to a guess (STATE proposed)
  stack approve CORRECTION --by NAME [--stack DIR]
                             approve a correction; its proposer may not
  version
USAGE
}

# ------------------------------------------------------------------ parse
# Reads the Org declaration, ignores prose.  Prints, unsorted, on stdout:
#   D <spoke> spoke  KEY VALUE             the normalized data (identity is made of it)
#   D <spoke> member HOST KEY VALUE
#   L <spoke> spoke  KEY WHERE             where the declaration says it (not in the identity)
#   L <spoke> member HOST KEY WHERE
# WHERE is "line N" in a plain file, and "ATOM line N" inside a composed file, ATOM being the
# atom file (SPOKE/spoke.org, SPOKE/member-HOST.org) that the line came from: the composed
# file starts each atom at a heading whose property drawer says  :ORGFS_ATOM: ATOM.
# Complaints on stderr, status 1 if anything is wrong.
#
# ATOM_AWK is the one rule for what an atom may be called; compose, decompose and the parser share it.
ATOM_AWK='
function atom_check(p,   n, a, i) {
  if (p == "story.org") return "story.org is the story that sets the atoms in order, not an atom"
  n = split(p, a, "/")
  if (n > 2) return "an atom sits at NAME.org, SPOKE/spoke.org or SPOKE/member-HOST.org, no deeper"
  for (i = 1; i <= n; i++) if (a[i] !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) return "bad path component " a[i] " (letters, digits, dot, dash, underscore)"
  if (p !~ /\.org$/) return "an atom is an .org file"
  if (n == 2) {
    if (a[1] !~ /^[a-z0-9][a-z0-9_-]*$/) return "the directory of a spoke must match [a-z0-9][a-z0-9_-]*"
    if (a[2] != "spoke.org" && a[2] !~ /^member-[A-Za-z0-9][A-Za-z0-9._-]*\.org$/) return "inside a spoke directory an atom is spoke.org or member-HOST.org"
  }
  return ""
}
'
# SCAN_AWK reads an expanded document and finds its atoms the Org way: an atom begins at a heading whose
# property drawer holds :ORGFS_ATOM: PATH and runs to the next heading that is not deeper than it (or the
# next atom, or the manifest section, or the end), without the blank lines at its tail.  Whatever is not
# an atom or the manifest is the story (the frame the atoms are set into).  Modes (-v mode=):
#   list      the atom paths, in order          map       "LINE TAB atom TAB line-in-atom" for atom lines
#   write     each atom and story.org into -v stage=DIR       manifest  "identity TAB X", "row TAB atom TAB sha"
#   check     only the checks
SCAN_AWK='
function fail(m, ln) { printf "orgfs: %s:%d: %s\n", file, ln, m > "/dev/stderr"; bad = 1 }
function blank(s) { return s ~ /^[ \t\r]*$/ }
function nocr(s) { sub(/\r$/, "", s); return s }
function lvl(s,   n) { if (s !~ /^\*+ /) return 0; n = 0; while (substr(s, n + 1, 1) == "*") n++; return n }
function keyval(t, key,   v) {
  if (toupper(substr(t, 1, length(key) + 2)) != ":" key ":") return ""
  v = substr(t, length(key) + 3); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); return v
}
function shut(e,   k) {
  if (kind == "A") { while (e > start && blank(L[e])) e--; aend[na] = e; for (k = start; k <= e; k++) own[k] = na }
  else if (kind == "M") { mend = e; for (k = start; k <= e; k++) own[k] = -1 }
  kind = ""
}
{ L[NR] = $0 }
END {
  N = NR; bad = 0; blk = 0; kind = ""; na = 0; nmf = 0
  for (i = 1; i <= N; i++) {
    s = L[i]
    if (blk) { if (toupper(s) ~ /^[ \t]*#\+END_/) blk = 0; continue }
    if (toupper(s) ~ /^[ \t]*#\+BEGIN_/) { blk = 1; continue }
    if ((lv = lvl(s)) == 0) continue
    level[i] = lv
    if (nocr(L[i + 1]) == ":PROPERTIES:")
      for (j = i + 2; j <= N; j++) {
        t = nocr(L[j])
        if (t == ":END:" || lvl(t) > 0) break
        if ((v = keyval(t, "ORGFS_ATOM")) != "") apath[i] = v
        else if ((v = keyval(t, "ORGFS_IDENTITY")) != "") mid[i] = v
      }
  }
  for (i = 1; i <= N; i++) {
    if (!(i in level)) continue
    if (i in apath) {
      shut(i - 1); kind = "A"; start = i; olv = level[i]; na++; astart[na] = i; ap[na] = apath[i]
      r = atom_check(apath[i])
      if (r != "") fail("atom " apath[i] ": " r, i)
      else if (apath[i] in seen) fail("atom " apath[i] " appears twice", i)
      seen[apath[i]] = 1
    } else if (i in mid) {
      shut(i - 1)
      if (++nmf > 1) fail("two manifest sections", i)
      kind = "M"; start = i; olv = level[i]; mident = mid[i]; mhead = i
    } else if (kind != "" && level[i] <= olv) shut(i - 1)
  }
  shut(N)
  if (nmf == 1) {
    j = mhead + 2
    while (j <= mend && nocr(L[j]) != ":END:") {
      if (keyval(nocr(L[j]), "ORGFS_IDENTITY") == "") fail("this line in the manifest drawer is not one orgfs wrote: " L[j], j)
      j++
    }
    if (length(mident) != 64 || mident ~ /[^0-9a-f]/) fail("the manifest identity is not a SHA-256", mhead)
    nrow = 0
    for (j++; j <= mend; j++) {
      t = nocr(L[j])
      if (blank(t) || t == msent || t == "#+NAME: orgfs-manifest") continue
      if (t ~ /^\|/) {
        if (t ~ /^\|[-+|]*$/) continue
        n = split(t, c, "|")
        for (m = 2; m < n; m++) { sub(/^ +/, "", c[m]); sub(/ +$/, "", c[m]) }
        if (n != 4) { fail("a manifest row has two cells, atom and sha256: " t, j); continue }
        if (c[2] == "atom" && c[3] == "sha256") continue
        if (length(c[3]) != 64 || c[3] ~ /[^0-9a-f]/) { fail("not a SHA-256 in the manifest: " c[3], j); continue }
        nrow++; rowp[nrow] = c[2]; rows[nrow] = c[3]
        continue
      }
      fail("this line in the manifest section is not one orgfs wrote: " t, j)
    }
  }
  if (bad) exit 1
  if (mode == "list") { for (k = 1; k <= na; k++) print ap[k]; exit 0 }
  if (mode == "map") {
    for (k = 1; k <= na; k++) for (i = astart[k]; i <= aend[k]; i++) printf "%d\t%s\t%d\n", i, ap[k], i - astart[k] + 1
    exit 0
  }
  if (mode == "manifest") {
    if (nmf == 1) { print "identity\t" mident; for (k = 1; k <= nrow; k++) print "row\t" rowp[k] "\t" rows[k] }
    exit 0
  }
  if (mode == "write") {
    for (k = 1; k <= na; k++) {
      out = stage "/" ap[k]; printf "" > out
      for (i = astart[k]; i <= aend[k]; i++) printf "%s\n", L[i] > out
      close(out)
    }
    out = stage "/story.org"; printf "" > out
    for (i = 1; i <= N; i++) {
      if (own[i] == -1) continue
      if (own[i] > 0) { if (i == astart[own[i]]) printf "#+INCLUDE: \"%s\"\n", ap[own[i]] > out; continue }
      if (nmf == 1 && i == mhead - 1 && blank(L[i])) continue
      printf "%s\n", L[i] > out
    }
    close(out)
  }
  exit 0
}
'
# LINT_AWK: what an atom must be, so that Org, expanding an #+INCLUDE of it, gives back exactly its bytes.
LINT_AWK='
function f(m) { printf "orgfs: atom %s: %s\n", path, m > "/dev/stderr"; bad = 1 }
function lvl(s,   n) { if (s !~ /^\*+ /) return 0; n = 0; while (substr(s, n + 1, 1) == "*") n++; return n }
function has_atom_prop(i,   j, t) {
  if (toupper(L[i + 1]) != ":PROPERTIES:") return 0
  for (j = i + 2; j <= n && L[j] != ":END:" && lvl(L[j]) == 0; j++) if (toupper(L[j]) ~ /^:ORGFS_ATOM:/) return 1
  return 0
}
{ L[NR] = $0 }
END {
  n = NR; bad = 0
  if (n < 2) { f("is too short: an atom is a heading, its :PROPERTIES: drawer and then its text"); exit 1 }
  first = lvl(L[1])
  if (first == 0) f("must begin with a heading line (stars, a space, the title), and begins with: " L[1])
  if (L[2] != ":PROPERTIES:") f("the heading must be followed at once by its :PROPERTIES: drawer")
  got = ""
  for (i = 3; i <= n && L[i] != ":END:"; i++) if (toupper(L[i]) ~ /^:ORGFS_ATOM:/) { got = L[i]; sub(/^:[A-Za-z_]+:[ \t]*/, "", got); sub(/[ \t]+$/, "", got) }
  if (got == "") f("the first drawer lacks  :ORGFS_ATOM: " path)
  else if (got != path) f(":ORGFS_ATOM: says " got ", but the atom is " path)
  blk = 0
  for (i = 1; i <= n; i++) {
    s = L[i]
    if (index(s, "\r") > 0) { f("line " i " holds a carriage return (atoms use LF line ends)"); break }
    if (blk) { if (toupper(s) ~ /^[ \t]*#\+END_/) blk = 0; if (lvl(s) > 0) f("line " i ": a line of stars inside a block (Org would move it as a heading)"); continue }
    if (toupper(s) ~ /^[ \t]*#\+BEGIN_/) blk = 1
    lv = lvl(s)
    if (lv > 0 && lv < first) f("line " i ": a heading shallower than the first one")
    if (lv > 0 && i > 1 && has_atom_prop(i)) f("line " i ": a second :ORGFS_ATOM: heading (one atom, one file)")
    if (s ~ /^\*+ COMMENT( |$)/) f("line " i ": a COMMENT heading is outside the supported subset")
    if (toupper(s) ~ /^[ \t]*#\+INCLUDE:/) f("line " i ": an atom holds no #+INCLUDE (the story does the including)")
    if (s ~ /^#\+NAME:[ \t]*orgfs-manifest/ || toupper(s) ~ /^:ORGFS_IDENTITY:/) f("line " i ": that is the manifest, which orgfs writes")
    if (index(s, "[fn:") > 0) f("line " i ": a footnote (Org renumbers footnotes of included files)")
    if (tolower(s) ~ /(^|[^a-z0-9])file:/ || s ~ /\[\[\.\.?\//) f("line " i ": a file link (Org rewrites relative file links of included files)")
  }
  if (L[n] ~ /^[ \t\r]*$/) f("ends with a blank line (Org drops blank lines around an include, so the atom would not come back byte for byte)")
  exit bad
}
'
# EXPAND_AWK: the subset of Org's #+INCLUDE this tool expands (README: "Org, not our own syntax").
# The one form  #+INCLUDE: "relative/path.org"  at the start of a line.  As Org does: an included
# file loses its blank lines at head and tail, and its headings are moved so that the shallowest has
# the level one below the heading the include sits under (level 1 under none); includes inside the
# included file are expanded the same way, relative to that file.  -v strict=1 refuses a move
# (compose: an atom must already have the level the story gives it).  Anything else is refused.
EXPAND_AWK='
function die(m) { printf "orgfs: %s: %s\n", ctx, m > "/dev/stderr"; exit 1 }
function isblank(s) { return s ~ /^[ \t\r]*$/ }
function lvl(s,   n) { if (s !~ /^\*+ /) return 0; n = 0; while (substr(s, n + 1, 1) == "*") n++; return n }
function slurp(f,   save, r, w) {
  save = RS; RS = "\034"
  w = ""; r = (getline w < f)
  RS = save
  if (r < 0) return -1
  close(f)
  SW = w
  return 0
}
function inc_path(s,   v, w, h) {
  if (s !~ /^#\+INCLUDE: "[^"]+"$/) {
    if (s ~ /^[ \t]/) die("an indented #+INCLUDE is outside the supported subset")
    h = substr(s, 1, 10)
    if (toupper(h) == "#+INCLUDE:" && h != "#+INCLUDE:") die("write the keyword in capitals, #+INCLUDE:")
    w = s
    if (w ~ /:lines/) die(":lines on #+INCLUDE is outside the supported subset")
    if (w ~ /:minlevel/) die(":minlevel on #+INCLUDE is outside the supported subset")
    if (w ~ /:only-contents/ || w ~ /:coding/) die(":only-contents and :coding on #+INCLUDE are outside the supported subset")
    if (w ~ /"[ \t]+[^ \t]/ || w ~ /::/) die("arguments after the file name (src, example, export, quote, a search, ...) are outside the supported subset")
    die("outside the supported subset: only  #+INCLUDE: \"relative/path.org\"  is expanded")
  }
  v = substr(s, 13, length(s) - 13)
  if (v ~ /^[\/~]/) die("an absolute path is outside the supported subset: " v)
  if (v ~ /^[A-Za-z][A-Za-z0-9+.-]*:/ || v ~ /::/) die("a URL or a search is outside the supported subset: " v)
  if (v ~ /\\/ || v ~ /\/\// ) die("a path with a backslash or an empty component is outside the supported subset: " v)
  if (v !~ /\.org$/) die("only .org files are included: " v)
  return v
}
function expand(f, d, induced, trim,   n, i, a, b, nonl, tmp, min, off, k, s, lv, cur, blk, drw, p, full, st, nm) {
  nm = (d == 0) ? label : f
  ctx = nm
  if (d > 16) die("includes nested more than 16 deep are outside the supported subset")
  dirs[d] = (d == 0) ? dir0 : f
  if (d > 0) sub(/\/?[^\/]*$/, "", dirs[d])
  stack[d] = f
  if (slurp(f) < 0) die("cannot read the file")
  n = 0; nonl = 0
  if (SW != "") { n = split(SW, tmp, "\n"); if (substr(SW, length(SW)) == "\n") n--; else nonl = 1 }
  for (i = 1; i <= n; i++) T[d, i] = tmp[i]
  a = 1; b = n
  if (trim) { while (a <= b && isblank(T[d, a])) a++; while (b >= a && isblank(T[d, b])) b-- }
  if (nonl && b == n && a <= b) die("does not end in a newline (Org would join the next line to its last one)")
  min = 0; blk = 0
  for (i = a; i <= b; i++) {
    s = T[d, i]; ctx = nm ":" i
    if (blk) {
      if (toupper(s) ~ /^[ \t]*#\+END_/) blk = 0
      if (lvl(s) > 0) die("a line of stars inside a block: Org would move it as a heading")
      continue
    }
    if (toupper(s) ~ /^[ \t]*#\+BEGIN_/) blk = 1
    lv = lvl(s)
    if (lv > 0 && (min == 0 || lv < min)) min = lv
    if (s ~ /^\*+ COMMENT( |$)/) die("a COMMENT heading is outside the supported subset")
    if (d > 0 && index(s, "[fn:") > 0) die("a footnote in an included file is outside the supported subset")
    if (d > 0 && (tolower(s) ~ /(^|[^a-z0-9])file:/ || s ~ /\[\[\.\.?\//)) die("a file link in an included file is outside the supported subset")
  }
  if (d > 0 && min > 0) {
    off = induced - min
    if (strict && d == 1 && off != 0) { ctx = nm; die(sprintf("its top heading is at level %d, but the story sets it at level %d; Org would change its stars, and orgfs will not (write the atom heading with %d star(s))", min, induced, induced)) }
    if (off != 0) for (i = a; i <= b; i++) if (lvl(T[d, i]) > 0) {
      if (off > 0) { st = ""; for (k = 0; k < off; k++) st = st "*"; T[d, i] = st T[d, i] }
      else T[d, i] = substr(T[d, i], 1 - off)
    }
  }
  cur = 0; blk = 0; drw = 0
  for (i = a; i <= b; i++) {
    s = T[d, i]; ctx = nm ":" i
    if ((lv = lvl(s)) > 0) cur = lv
    if (blk) { if (toupper(s) ~ /^[ \t]*#\+END_/) blk = 0 }
    else if (toupper(s) ~ /^[ \t]*#\+BEGIN_/) blk = 1
    else if (drw) { if (s ~ /^[ \t]*:END:[ \t]*$/) drw = 0 }
    else if (s ~ /^[ \t]*:[A-Za-z0-9_-]+:[ \t]*$/ && toupper(s) !~ /:END:/) drw = 1
    if (tolower(s) ~ /^[ \t]*#\+include:/) {
      if (blk || drw) die("#+INCLUDE inside a block or a drawer is outside the supported subset")
      p = inc_path(s)
      full = (dirs[d] == "" ? "" : dirs[d] "/") p
      for (k = 0; k <= d; k++) if (stack[k] == full) die("recursive inclusion of " p)
      if ((getline junk < full) < 0) die("cannot read " p)
      close(full)
      if (d == 0 && incl != "") print p >> incl
      expand(full, d + 1, cur + 1, 1)
    } else print s
  }
}
BEGIN { expand(top, 0, 1, 0); exit 0 }
'
PARSE_AWK='
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
function at(n) { return (atom != "") ? atom " line " arel[n] : "line " n }
function fail(m) { printf "orgfs: %s: %s\n", (atom != "") ? atom ":" arel[NR] : decl ":" NR, m > "/dev/stderr"; bad = 1 }
function afail(a, m) { printf "orgfs: %s: %s\n", a, m > "/dev/stderr"; bad = 1 }
function endfail(m) { printf "orgfs: %s: %s\n", decl, m > "/dev/stderr"; bad = 1 }
function spoke_ok(p, name,   a) { return split(p, a, "/") == 2 && a[1] == name && a[2] == "spoke.org" }
function member_ok(p, spoke, host,   a) { return split(p, a, "/") == 2 && a[1] == spoke && a[2] == "member-" host ".org" }
function atom_end(a,   n, b) {
  n = split(a, b, "/")
  if (n == 2 && b[2] == "spoke.org" && ns_in != 1) afail(a, "a spoke.org atom holds exactly one \"spoke NAME\" heading (found " ns_in ")")
  if (n == 2 && b[2] != "spoke.org" && nmem_in != 1) afail(a, "a member atom holds exactly one \"member HOST\" heading (found " nmem_in ")")
}
BEGIN {
  bad = 0; cur = ""; drawer = 0; nsp = 0; sname = ""; atom = ""; natoms = 0; outsideh = 0; prevatom = ""
  while ((getline mline < map) > 0) { split(mline, mf, "\t"); amap[mf[1]] = mf[2]; arel[mf[1]] = mf[3] }
  close(map)
}
{
  atom = (NR in amap) ? amap[NR] : ""
  if (atom != prevatom) {
    if (prevatom != "") atom_end(prevatom)
    if (atom != "") { ns_in = 0; nmem_in = 0; natoms++; aseen[atom] = 1 }
    prevatom = atom
  }
}
/^\*+[ \t]/ {
  drawer = 0; cur = ""
  n = 0
  while (substr($0, n + 1, 1) == "*") n++
  nw = split(trim(substr($0, n + 1)), w, /[ \t]+/)
  if (atom == "" && (w[1] == "spoke" || w[1] == "member")) outsideh++
  if (w[1] == "spoke") {
    if (nw != 2) fail("heading must read: spoke NAME")
    else if (atom != "" && !spoke_ok(atom, w[2])) fail("spoke " w[2] " belongs in " w[2] "/spoke.org, not in " atom)
    else if (w[2] in sseen) fail("duplicate spoke " w[2])
    else { sname = w[2]; sseen[sname] = 1; nsp++; sorder[nsp] = sname; nm[sname] = 0; kl[sname, "heading"] = at(NR); cur = "spoke"; ns_in++ }
  } else if (w[1] == "member") {
    if (nw != 2) fail("heading must read: member HOST")
    else if (sname == "") fail("member heading outside a spoke")
    else if (atom != "" && !member_ok(atom, sname, w[2])) fail("member " w[2] " of spoke " sname " belongs in " sname "/member-" w[2] ".org, not in " atom " (the spoke.org of a spoke comes before its members)")
    else if ((sname, w[2]) in seen) fail("duplicate member " w[2] " in spoke " sname)
    else { host = w[2]; seen[sname, host] = 1; nm[sname]++; order[sname, nm[sname]] = host; ml[sname, host, "heading"] = at(NR); cur = "member"; nmem_in++ }
  }
  next
}
/^[ \t]*:PROPERTIES:[ \t\r]*$/ { if (cur != "") drawer = 1; next }
/^[ \t]*:END:[ \t\r]*$/ { drawer = 0; next }
drawer {
  line = trim($0)
  if (line == "") next
  if (!match(line, /^:[A-Za-z_-]+:/)) { fail("not a property line: " line); next }
  key = toupper(substr(line, 2, RLENGTH - 2))
  val = trim(substr(line, RLENGTH + 1))
  if (key == "ORGFS_ATOM") next
  if (val == "") { fail("empty value for " key); next }
  if (cur == "spoke") {
    if (key !~ /^(RING|STRIPES|REPLICAS|VISIBILITY)$/) { fail("unknown spoke property " key); next }
    if ((sname, key) in sp) { fail("duplicate property " key); next }
    sp[sname, key] = val; kl[sname, key] = at(NR)
  } else {
    if (key !~ /^(ROOT|TRANSPORT)$/) { fail("unknown member property " key); next }
    if ((sname, host, key) in mp) { fail("duplicate property " key " on member " host); next }
    mp[sname, host, key] = val; ml[sname, host, key] = at(NR)
  }
  next
}
END {
  if (prevatom != "") atom_end(prevatom)
  if (natoms > 0 && outsideh > 0) endfail("a composed file declares only through its atoms, but " outsideh " spoke or member heading(s) stand outside any atom")
  if (bad) exit 1
  if (nsp == 0 && !(prose_ok + 0)) endfail("no \"* spoke NAME\" heading")
  split("RING STRIPES REPLICAS VISIBILITY", req, " ")
  for (si = 1; si <= nsp; si++) {
    s = sorder[si]
    if (s !~ /^[a-z0-9][a-z0-9_-]*$/) endfail("spoke name must match [a-z0-9][a-z0-9_-]*: " s)
    for (j = 1; j <= 4; j++) if (!((s, req[j]) in sp)) endfail("spoke " s " lacks property " req[j])
    ring = toupper(sp[s, "RING"]); vis = tolower(sp[s, "VISIBILITY"])
    st = sp[s, "STRIPES"]; rp = sp[s, "REPLICAS"]
    if (((s, "RING") in sp) && ring !~ /^(GRAIN|GREAT|GRAND)$/) endfail("spoke " s ": RING must be GRAIN, GREAT or GRAND")
    if (((s, "VISIBILITY") in sp) && vis !~ /^(public|private|sealed)$/) endfail("spoke " s ": VISIBILITY must be public, private or sealed")
    if (((s, "STRIPES") in sp) && (st !~ /^[0-9]+$/ || st + 0 < 1 || st + 0 > 256)) endfail("spoke " s ": STRIPES must be an integer 1..256")
    if (((s, "REPLICAS") in sp) && (rp !~ /^[0-9]+$/ || rp + 0 < 1)) endfail("spoke " s ": REPLICAS must be an integer >= 1")
    nring[s] = ring; nvis[s] = vis; nst[s] = st + 0; nrp[s] = rp + 0
    if (nm[s] < 1) endfail("spoke " s " has no \"** member HOST\" headings")
    else if (((s, "REPLICAS") in sp) && rp ~ /^[0-9]+$/ && rp + 0 > nm[s]) endfail("spoke " s ": REPLICAS (" rp ") exceeds the number of members (" nm[s] ")")
    for (j = 1; j <= nm[s]; j++) {
      h = order[s, j]
      if (h !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) endfail("bad member name " h)
      if (!((s, h, "ROOT") in mp)) endfail("member " h " lacks ROOT")
      if (!((s, h, "TRANSPORT") in mp)) endfail("member " h " lacks TRANSPORT")
      if ((s, h, "ROOT") in mp) {
        r = mp[s, h, "ROOT"]
        if (r !~ /^\// || r ~ /[ \t]/) endfail("member " h ": ROOT must be an absolute path without whitespace")
        sub(/\/+$/, "", r)
        if (r == "") endfail("member " h ": ROOT must not be /")
        mp[s, h, "ROOT"] = r
      }
      if ((s, h, "TRANSPORT") in mp) {
        t = tolower(mp[s, h, "TRANSPORT"])
        if (t !~ /^(local|sshfs)$/) endfail("member " h ": TRANSPORT must be local or sshfs")
        mp[s, h, "TRANSPORT"] = t
      }
    }
  }
  if (bad) exit 1
  for (si = 1; si <= nsp; si++) {
    s = sorder[si]
    printf "D\t%s\tspoke\tname\t%s\n", s, s
    printf "D\t%s\tspoke\tRING\t%s\n", s, nring[s]
    printf "D\t%s\tspoke\tSTRIPES\t%d\n", s, nst[s]
    printf "D\t%s\tspoke\tREPLICAS\t%d\n", s, nrp[s]
    printf "D\t%s\tspoke\tVISIBILITY\t%s\n", s, nvis[s]
    printf "L\t%s\tspoke\theading\t%s\n", s, kl[s, "heading"]
    split("RING STRIPES REPLICAS VISIBILITY", ks, " ")
    for (j = 1; j <= 4; j++) printf "L\t%s\tspoke\t%s\t%s\n", s, ks[j], kl[s, ks[j]]
    for (j = 1; j <= nm[s]; j++) {
      h = order[s, j]
      printf "D\t%s\tmember\t%s\tROOT\t%s\n", s, h, mp[s, h, "ROOT"]
      printf "D\t%s\tmember\t%s\tTRANSPORT\t%s\n", s, h, mp[s, h, "TRANSPORT"]
      printf "L\t%s\tmember\t%s\theading\t%s\n", s, h, ml[s, h, "heading"]
      printf "L\t%s\tmember\t%s\tROOT\t%s\n", s, h, ml[s, h, "ROOT"]
      printf "L\t%s\tmember\t%s\tTRANSPORT\t%s\n", s, h, ml[s, h, "TRANSPORT"]
    }
  }
}
'

# options, filled in by main
O_SAYS=; O_BY=; O_WHY=; O_STACK=; O_SINCE=; O_UNTIL=; O_SEED=; O_REPO=; O_SPOKE=; O_AS=; O_OBJECT=; O_OUT=; O_INTO=; O_ROOT=; O_DECL=; O_NOMOUNTS=0; O_SOURCE=0; O_LIVE=0; O_BRUN=; O_BCOMMIT=; O_BLOG=

spoke_norm() { # SPOKE -> its data rows in the 0.1.0 shape, sorted bytewise
  $AWK -F'\t' -v s="$1" '$1=="D"&&$2==s{ l=$3; for(i=4;i<=NF;i++) l=l "\t" $i; print l }' "$TMP/all" | sort
}

ident_of() { { printf 'orgfs-decl-1\n'; cat "$1"; } | sha_stdin; }

spoke_val() { $AWK -F'\t' -v k="$1" '$1=="spoke"&&$2==k{print $3}' "$TMP/norm"; }
member_val() { $AWK -F'\t' -v h="$1" -v k="$2" '$1=="member"&&$2==h&&$3==k{print $4}' "$TMP/norm"; }
root_of() { member_val "$1" ROOT; }
tr_of() { member_val "$1" TRANSPORT; }
spoke_line() { $AWK -F'\t' -v s="$SPOKE" -v k="$1" '$1=="L"&&$2==s&&$3=="spoke"&&$4==k{print $5}' "$TMP/all"; }
member_line() { $AWK -F'\t' -v s="$SPOKE" -v h="$1" -v k="$2" '$1=="L"&&$2==s&&$3=="member"&&$4==h&&$5==k{print $6}' "$TMP/all"; }

in_list() { # WORD LIST(newline or space separated)
  printf '%s\n' "$2" | tr ' ' '\n' | $AWK -v w="$1" '$0==w{f=1} END{exit f?0:1}'
}

load_spoke() { # NAME -> ID SPOKE RING STRIPES REPLICAS VIS MEMBERS
  SPOKE=$1
  cp "$TMP/norm.$1" "$TMP/norm"
  ID=$(ident_of "$TMP/norm")
  RING=$(spoke_val RING); STRIPES=$(spoke_val STRIPES); REPLICAS=$(spoke_val REPLICAS)
  VIS=$(spoke_val VISIBILITY)
  MEMBERS=$($AWK -F'\t' '$1=="member"&&$3=="ROOT"{print $2}' "$TMP/norm")
}

# ------------------------------------------------------------------ atoms, the story, composition
# The record is a directory of atoms.  An atom is one Org file that begins with its own heading and
# a :PROPERTIES: drawer whose :ORGFS_ATOM: says the atom's path: DIR/NAME.org (prose),
# DIR/SPOKE/spoke.org (a "spoke SPOKE" heading and its four properties) and DIR/SPOKE/member-HOST.org
# (a "member HOST" heading and its two).  DIR/story.org is the source form of the document: narrative
# Org text with one  #+INCLUDE: "PATH"  at the point in the story where each atom belongs (without it
# the atoms follow each other in a default order).  The expanded form, the file that travels alone, is
# what Org's own export makes of the story: each #+INCLUDE replaced by the atom.  A manifest table at
# its end records the atoms' hashes.

MANIFEST_SENTENCE='This table says which atoms the document above was composed from and the SHA-256 of each, so that a reader or a command can tell whether the atoms still say what this file says; the first row, story.org, is the story the atoms are set into. orgfs writes this section, so leave it as it is.'

scan() { # MODE FILE [STAGE]
  $AWK -v mode="$1" -v file="$2" -v stage="${3:-}" -v msent="$MANIFEST_SENTENCE" "$ATOM_AWK$SCAN_AWK" "$2"
}

# FILE STAGE -> the atoms and story.org that FILE holds, written under STAGE; their paths in $TMP/slist
scan_stage() {
  scan list "$1" > "$TMP/slist" || return 1
  rm -rf "$2"; mkdir -p "$2" || return 1
  while IFS= read -r ss_p; do mkdir -p "$2/$(dirname "$ss_p")"; done < "$TMP/slist"
  scan write "$1" "$2"
}

# DIR -> $TMP/atoms: the atoms' paths relative to DIR, in the default order
# (prose atoms first; then each spoke in name order, its spoke.org before its members).
atoms_list() {
  (cd "$1" && find . \( -path ./guesses -o -path ./references -o -path ./corrections \) -prune -o -type f -name '*.org' -print) | sed 's#^\./##' | grep -vx 'story.org' | $AWK "$ATOM_AWK"'
    { r = atom_check($0)
      if (r != "") { printf "orgfs: %s: %s\n", $0, r > "/dev/stderr"; bad = 1; next }
      n = split($0, a, "/")
      if (n == 1) printf "0\t\t0\t%s\n", $0
      else printf "1\t%s\t%s\t%s\n", a[1], (a[2] == "spoke.org") ? "0" : "1", $0 }
    END { exit bad + 0 }' > "$TMP/atoms.k" || return 1
  sort "$TMP/atoms.k" | cut -f4 > "$TMP/atoms"
  [ -s "$TMP/atoms" ] || { printf 'orgfs: %s holds no atoms (no *.org files)\n' "$1" >&2; return 1; }
  return 0
}

# DIR OUT: the story of DIR (its story.org, or the default: every atom included in turn)
story_of() {
  if [ -f "$1/story.org" ]; then
    cat "$1/story.org" > "$2"
  else
    atoms_list "$1" || return 1
    $AWK '{ if (NR > 1) print ""; printf "#+INCLUDE: \"%s\"\n", $0 }' "$TMP/atoms" > "$2"
  fi
}

expand_file() { # SOURCE OUT [strict]: expand the #+INCLUDE lines of SOURCE, relative to its directory
  $AWK -v top="$1" -v label="$1" -v dir0="$(dirname "$1")" -v strict="${3:-0}" -v incl= "$ATOM_AWK$EXPAND_AWK" > "$2"
}

relpath() { # FROMDIR TODIR (both exist): TODIR as a path relative to FROMDIR
  rp_a=$(cd "$1" && pwd -P) && rp_b=$(cd "$2" && pwd -P) || return 1
  $AWK -v a="$rp_a" -v b="$rp_b" 'BEGIN {
    na = split(a, A, "/"); nb = split(b, B, "/"); i = 2
    while (i <= na && i <= nb && A[i] == B[i]) i++
    out = ""
    for (j = i; j <= na; j++) out = out (out == "" ? "" : "/") ".."
    for (j = i; j <= nb; j++) out = out (out == "" ? "" : "/") B[j]
    print (out == "" ? "." : out) }'
}

# the manifest section: the declaration identity as a property of its heading, a sentence, the table
manifest_section() { # DIR  (uses FILEID, $TMP/incl, $TMP/story)
  printf '* Atoms and their hashes\n:PROPERTIES:\n:ORGFS_IDENTITY: %s\n:END:\n%s\n\n' "$FILEID" "$MANIFEST_SENTENCE"
  printf '#+NAME: orgfs-manifest\n| atom | sha256 |\n|------+--------|\n'
  printf '| story.org | %s |\n' "$(sha_file "$TMP/story")"
  while IFS= read -r ms_a; do printf '| %s | %s |\n' "$ms_a" "$(sha_file "$1/$ms_a")"; done < "$TMP/incl"
}

# DIR OUT [m|s]: the document composed from the atoms.  Without a mode, the expanded text alone; with m,
# the expanded form and its manifest; with s, the source form (the story, its includes relative to
# $CD_PREFIX) and its manifest.  Refuses an atom Org could not give back byte for byte.
compose_dir() {
  [ -d "$1" ] || { printf 'orgfs: not a directory: %s\n' "$1" >&2; return 1; }
  atoms_list "$1" || return 1
  cd_bad=0
  while IFS= read -r cd_a; do
    [ -z "$(tail -c 1 "$1/$cd_a")" ] || { printf 'orgfs: atom %s does not end in a newline\n' "$cd_a" >&2; cd_bad=1; }
    $AWK -v path="$cd_a" "$LINT_AWK" "$1/$cd_a" || cd_bad=1
  done < "$TMP/atoms"
  [ "$cd_bad" = 0 ] || return 1
  story_of "$1" "$TMP/story" || return 1
  [ -z "$(tail -c 1 "$TMP/story")" ] || { printf 'orgfs: %s/story.org does not end in a newline\n' "$1" >&2; return 1; }
  : > "$TMP/incl"
  $AWK -v top="$TMP/story" -v label="$1/story.org" -v dir0="$1" -v strict=1 -v incl="$TMP/incl" "$ATOM_AWK$EXPAND_AWK" > "$TMP/ebody" || return 1
  sort "$TMP/atoms" > "$TMP/atoms.s"
  $AWK 'NR == FNR { a[$0] = 1; next }
    { seen[$0]++
      if (!($0 in a)) { printf "orgfs: story.org includes %s, which is not an atom of this declaration\n", $0 > "/dev/stderr"; bad = 1 }
      else if (seen[$0] > 1) { printf "orgfs: story.org includes %s twice\n", $0 > "/dev/stderr"; bad = 1 } }
    END { for (p in a) if (!(p in seen)) { printf "orgfs: atom %s is not in story.org: the story has no #+INCLUDE for it\n", p > "/dev/stderr"; bad = 1 }
      exit bad + 0 }' "$TMP/atoms.s" "$TMP/incl" || return 1
  # the expanded text must split back into exactly these atoms and this story
  scan_stage "$TMP/ebody" "$TMP/cstage" || return 1
  while IFS= read -r cd_a; do
    cmp -s "$TMP/cstage/$cd_a" "$1/$cd_a" || { printf 'orgfs: atom %s does not come back out of the composed text: what the story puts straight after it is taken for part of it (set that text under a heading of its own)\n' "$cd_a" >&2; return 1; }
  done < "$TMP/atoms"
  cmp -s "$TMP/cstage/story.org" "$TMP/story" || { printf 'orgfs: story.org does not come back out of the composed text\n' >&2; return 1; }
  if [ -z "${3:-}" ]; then
    cp "$TMP/ebody" "$2" || return 1
    return 0
  fi
  # a record with no spoke atom (the stack of tools, for one) is prose and properties; it has no spokes to name
  PARSE_PROSE_OK=0; grep -q '/spoke\.org$' "$TMP/atoms" || PARSE_PROSE_OK=1
  parse_decl "$TMP/ebody" "$1"
  PARSE_PROSE_OK=0
  {
    if [ "$3" = s ]; then
      $AWK -v pfx="${CD_PREFIX:-}" '/^#\+INCLUDE: "/ && pfx != "" { i = index($0, "\""); $0 = substr($0, 1, i) pfx "/" substr($0, i + 1) } { print }' "$TMP/story"
    else
      cat "$TMP/ebody"
    fi
    printf '\n'
    manifest_section "$1"
  } > "$2" || return 1
}

# FILE NAME SRC: an expanded document's manifest against its own atoms and against the atoms beside it.
# SRC=1: FILE is the expansion of a source form, whose atoms are whatever it includes now.
# 0: fresh, or nothing to check against (then a warning says so); 1: STALE (lines on stderr).
# The atoms beside FILE.org are in FILE.d.  MF_IDENT is the identity the manifest states.
MF_IDENT=
check_fresh() {
  MF_IDENT=
  scan list "$1" > "$TMP/flist" || return 1
  [ -s "$TMP/flist" ] || return 0
  scan manifest "$1" > "$TMP/mfraw" || return 1
  if ! grep -q '^identity' "$TMP/mfraw"; then
    warn "$2: composed file has no manifest; freshness not checked"; return 0
  fi
  MF_IDENT=$($AWK -F'\t' '$1=="identity"{ print $2; exit }' "$TMP/mfraw")
  $AWK -F'\t' '$1=="row"{ print $2 "\t" $3 }' "$TMP/mfraw" | sort > "$TMP/mf"
  # what the text itself holds, atom by atom (and its story)
  scan_stage "$1" "$TMP/fstage" || return 1
  { cat "$TMP/slist"; echo story.org; } | while IFS= read -r cf_p; do printf '%s\t%s\n' "$cf_p" "$(sha_file "$TMP/fstage/$cf_p")"; done | sort > "$TMP/fe"
  cf_rc=0
  stale_diff "$TMP/mf" "$TMP/fe" "in the composed file itself" || cf_rc=1
  [ "${3:-0}" = 0 ] || return "$cf_rc"
  case $2 in *.org) cf_dir=${2%.org}.d;; *) cf_dir=$2.d;; esac
  if [ -d "$cf_dir" ]; then
    if atoms_list "$cf_dir" && story_of "$cf_dir" "$TMP/dstory"; then
      { cat "$TMP/atoms" | while IFS= read -r cf_p; do printf '%s\t%s\n' "$cf_p" "$(sha_file "$cf_dir/$cf_p")"; done
        printf 'story.org\t%s\n' "$(sha_file "$TMP/dstory")"; } | sort > "$TMP/fa"
      stale_diff "$TMP/mf" "$TMP/fa" "in the atoms beside it, $cf_dir" || cf_rc=1
    else
      cf_rc=1
    fi
  else
    warn "$2: composed file read without its atoms; freshness not checked"
  fi
  return "$cf_rc"
}

# MANIFEST NOW WHERE: both "path TAB sha", sorted; prints a STALE line for every difference
stale_diff() {
  $AWK -F'\t' -v where="$3" '
    NR == FNR { m[$1] = $2; next }
    { n[$1] = $2 }
    END {
      for (p in m) if (!(p in n)) printf "orgfs: STALE: %s removed since compose (%s)\n", p, where
                   else if (m[p] != n[p]) printf "orgfs: STALE: %s changed since compose (%s)\n", p, where
      for (p in n) if (!(p in m)) printf "orgfs: STALE: %s added since compose (%s)\n", p, where
    }' "$1" "$2" | sort > "$TMP/stale"
  [ -s "$TMP/stale" ] || return 0
  cat "$TMP/stale" >&2
  return 1
}

# DECL -> SPOKES NSP FILEID; and, when --spoke names one or the file has just one, that spoke is loaded
# DECL is an atom directory, an expanded file, a source form (a file with #+INCLUDE lines) or a plain
# single file; DECLFILE is the text that gets parsed.
load() {
  _src=0
  if [ -d "$1" ]; then
    compose_dir "$1" "$TMP/composed" || die "cannot compose the atoms in $1"
    DECLFILE=$TMP/composed
  elif [ -f "$1" ]; then
    DECLFILE=$1
    if grep -Eqi '^[[:space:]]*#\+include:' "$1"; then
      expand_file "$1" "$TMP/expanded" || die "cannot expand the #+INCLUDE lines of $1"
      DECLFILE=$TMP/expanded; _src=1
    fi
  else
    die "cannot read declaration: $1"
  fi
  if [ -f "$1" ]; then
    check_fresh "$DECLFILE" "$1" "$_src" || die "$1 is STALE: compose it again (orgfs compose DIR --out FILE), or decompose it if the composed text is what you meant to change"
  fi
  parse_decl "$DECLFILE" "$1"
  if [ -f "$1" ] && [ -n "$MF_IDENT" ] && [ "$MF_IDENT" != "$FILEID" ]; then
    die "STALE: the identity of $1 is $FILEID but its manifest says $MF_IDENT; compose it again"
  fi
  SPOKE=; ID=; MEMBERS=
  if [ -n "$O_SPOKE" ]; then
    in_list "$O_SPOKE" "$SPOKES" || die "$1 has no spoke $O_SPOKE (it has: $(echo $SPOKES))"
    load_spoke "$O_SPOKE"
  elif [ "$NSP" = 1 ]; then
    load_spoke "$SPOKES"
  fi
}

# FILE NAME -> SPOKES NSP FILEID and the normalized rows of each spoke ($TMP/norm.SPOKE)
parse_decl() {
  scan map "$1" > "$TMP/amap" || die "declaration rejected: $2"
  $AWK -v decl="$2" -v map="$TMP/amap" -v prose_ok="${PARSE_PROSE_OK:-0}" "$ATOM_AWK$PARSE_AWK" "$1" > "$TMP/raw" || die "declaration rejected: $2"
  sort "$TMP/raw" > "$TMP/all"
  SPOKES=$($AWK -F'\t' '$1=="D"&&$3=="spoke"&&$4=="name"{print $2}' "$TMP/all")
  NSP=$(printf '%s\n' "$SPOKES" | wc -l | tr -d ' ')
  : > "$TMP/ids"
  for _s in $SPOKES; do
    spoke_norm "$_s" > "$TMP/norm.$_s"
    ident_of "$TMP/norm.$_s" >> "$TMP/ids"
  done
  # the file's identity is made of the spokes' identities, sorted: spoke order cannot matter
  FILEID=$({ printf 'orgfs-file-1\n'; sort "$TMP/ids"; } | sha_stdin)
}

need_spoke() { # COMMAND
  [ -n "$SPOKE" ] || die "$1: this declaration has $NSP spokes ($(echo $SPOKES)); say which with --spoke NAME"
}

# ------------------------------------------------------------------ compose, expand, decompose
cmd_compose() {
  _dir=${1:-}; [ -n "$_dir" ] || die "compose: need DIR"
  [ -d "$_dir" ] || die "compose: $_dir is not a directory"
  case $O_OUT in "${_dir%/}"/*) die "compose: --out must not be inside $_dir (it would be taken for an atom)";; esac
  if [ "$O_SOURCE" = 1 ]; then
    if [ -n "$O_OUT" ]; then
      _od=$(dirname "$O_OUT"); [ -d "$_od" ] || die "compose: no directory $_od for $O_OUT"
      CD_PREFIX=$(relpath "$_od" "$_dir") || die "compose: cannot work out where $_dir is from $_od"
    else
      CD_PREFIX=${_dir%/}
    fi
    [ "$CD_PREFIX" != . ] || CD_PREFIX=
    compose_dir "$_dir" "$TMP/composed.out" s || die "compose: refused"
  else
    compose_dir "$_dir" "$TMP/composed.out" m || die "compose: refused"
  fi
  find "$_dir" -type f ! -name '*.org' | while IFS= read -r _x; do warn "not an atom, left out: $_x"; done
  _n=$(wc -l < "$TMP/atoms" | tr -d ' ')
  if [ -n "$O_OUT" ]; then
    cp "$TMP/composed.out" "$O_OUT" || die "compose: cannot write $O_OUT"
    printf 'compose: wrote %s (%s atoms)\n' "$O_OUT" "$_n"
  else
    cat "$TMP/composed.out"
  fi
}

cmd_expand() {
  _f=${1:-}; [ -n "$_f" ] || die "expand: need FILE"
  [ -f "$_f" ] || die "expand: cannot read $_f"
  expand_file "$_f" "$TMP/expand.out" || die "expand: refused"
  if [ -n "$O_OUT" ]; then cp "$TMP/expand.out" "$O_OUT" || die "expand: cannot write $O_OUT"; else cat "$TMP/expand.out"; fi
}

cmd_decompose() {
  _f=${1:-}; _dir=${2:-}
  [ -n "$_f" ] && [ -n "$_dir" ] || die "decompose: need FILE DIR"
  [ -f "$_f" ] || die "decompose: cannot read $_f"
  if grep -Eqi '^[[:space:]]*#\+include:' "$_f"; then
    expand_file "$_f" "$TMP/dexp" || die "decompose: cannot expand the #+INCLUDE lines of $_f"
    _f2=$TMP/dexp
  else
    _f2=$_f
  fi
  scan_stage "$_f2" "$TMP/stage" || die "decompose: refused"
  cp "$TMP/slist" "$TMP/dlist"
  if [ -s "$TMP/dlist" ]; then   # the text must be what Org makes of its own story, or compose could not give it back
    $AWK -v top="$TMP/stage/story.org" -v label="story.org of $_f" -v dir0="$TMP/stage" -v strict=1 -v incl= "$ATOM_AWK$EXPAND_AWK" > /dev/null || die "decompose: refused (the text of $_f is not what Org would make of its story)"
  fi
  [ -s "$TMP/dlist" ] || die "decompose: $_f holds no atoms (no heading with an :ORGFS_ATOM: property)"
  echo story.org >> "$TMP/dlist"
  _clash=0
  while IFS= read -r _p; do
    if [ -e "$_dir/$_p" ] && ! cmp -s "$TMP/stage/$_p" "$_dir/$_p"; then
      printf 'orgfs: decompose: %s/%s exists and differs from the atom in %s\n' "$_dir" "$_p" "$_f" >&2; _clash=1
    fi
  done < "$TMP/dlist"
  [ "$_clash" = 0 ] || die "decompose: nothing written; move the atoms aside, or compare them (diff), first"
  if [ -d "$_dir" ] && atoms_list "$_dir" 2>/dev/null; then
    grep -vxF -f "$TMP/dlist" "$TMP/atoms" | while IFS= read -r _x; do warn "atom $_x is in $_dir but not in $_f; left as it is"; done
  fi
  _n=0
  while IFS= read -r _p; do
    mkdir -p "$_dir/$(dirname "$_p")" && cp "$TMP/stage/$_p" "$_dir/$_p" || die "decompose: cannot write $_dir/$_p"
    _n=$((_n + 1))
  done < "$TMP/dlist"
  printf 'decompose: wrote %s atoms and story.org into %s\n' "$((_n - 1))" "$_dir"
}

# ------------------------------------------------------------------ mounts
is_mounted() {
  _f=${ORGFS_MOUNTS:-/proc/mounts}
  [ -r "$_f" ] || return 1
  $AWK -v p="$1" '$2==p{f=1} END{exit f?0:1}' "$_f"
}

WHY=
member_up() { # HOST: usable root? sets WHY when not
  WHY=
  _r=$(root_of "$1")
  [ -d "$_r" ] || { WHY="ROOT $_r is not a directory"; return 1; }
  if [ "$(tr_of "$1")" = sshfs ]; then
    is_mounted "$_r" || { WHY="TRANSPORT sshfs but $_r is not a mount point"; return 1; }
  fi
  return 0
}

sdir() { printf '%s/.orgfs/%s/%s' "$(root_of "$1")" "$SPOKE" "$2"; }

# ------------------------------------------------------------------ plan
make_plan() { # -> $TMP/plan, lines: stripe TAB holder holder ...
  : > "$TMP/plan"
  _i=1
  while [ "$_i" -le "$STRIPES" ]; do
    _hs=$(for _h in $MEMBERS; do printf '%s %s\n' "$(sha_str "$SPOKE|$_i|$_h")" "$_h"; done \
          | sort -r | head -n "$REPLICAS" | cut -d' ' -f2 | sort | tr '\n' ' ')
    printf '%s\t%s\n' "$_i" "${_hs% }" >> "$TMP/plan"
    _i=$((_i + 1))
  done
}
holders_of() { $AWK -F'\t' -v i="$1" '$1==i{print $2}' "$TMP/plan"; }
holds_of() { $AWK -F'\t' -v h="$1" '{ n = split($2, a, " "); for (k = 1; k <= n; k++) if (a[k] == h) printf "%s ", $1 }' "$TMP/plan" | sed 's/ $//'; }

print_spoke_block() {
  _n=$(printf '%s\n' "$MEMBERS" | wc -l | tr -d ' ')
  printf 'spoke\t%s\n' "$SPOKE"
  printf 'ring\t%s\n' "$RING"
  printf 'stripes\t%s\n' "$STRIPES"
  printf 'replicas\t%s\n' "$REPLICAS"
  printf 'visibility\t%s\n' "$VIS"
  printf 'members\t%s\n' "$_n"
  printf 'identity\t%s\n' "$ID"
}

cmd_check() {
  _decl=${1:-}; [ -n "$_decl" ] || die "check: need DECL"
  load "$_decl"
  _list=$SPOKES; [ -z "$O_SPOKE" ] || _list=$O_SPOKE
  _bad=0
  if [ "$O_NOMOUNTS" = 0 ]; then
    for _s in $_list; do
      load_spoke "$_s"
      for _h in $MEMBERS; do
        member_up "$_h" || { printf 'orgfs: member %s: %s\n' "$_h" "$WHY" >&2; _bad=1; }
      done
    done
  fi
  [ "$_bad" = 0 ] || die "check failed: $_decl"
  for _s in $_list; do load_spoke "$_s"; print_spoke_block; done
  if [ -n "$O_SPOKE" ]; then printf 'file-identity\t(not computed for one spoke; see the spoke identity)\n'
  else printf 'file-identity\t%s\n' "$FILEID"; fi
  printf 'check: OK\n'
}

cmd_plan() {
  _decl=${1:-}; [ -n "$_decl" ] || die "plan: need DECL"
  load "$_decl"; need_spoke plan
  if [ -n "$O_AS" ]; then
    in_list "$O_AS" "$MEMBERS" || die "plan: $O_AS is not a member of $SPOKE"
  fi
  make_plan
  printf '# spoke %s identity %s\n' "$SPOKE" "$ID"
  if [ -n "$O_AS" ]; then
    printf '# as %s\n' "$O_AS"
    $AWK -F'\t' -v h="$O_AS" '{ n = split($2, a, " "); for (k = 1; k <= n; k++) if (a[k] == h) { gsub(/ /, ",", $2); print $1 "\t" $2 } }' "$TMP/plan"
  else
    $AWK -F'\t' '{ gsub(/ /, ",", $2); print $1 "\t" $2 }' "$TMP/plan"
  fi
}

cmd_agree() {
  [ $# -ge 2 ] || die "agree: need DECL and at least one OTHER"
  _first=
  _differ=0
  for _f in "$@"; do
    load "$_f"
    if [ -n "$O_SPOKE" ]; then _id=$ID; else _id=$FILEID; fi
    printf '%s  %s\n' "$_id" "$_f"
    if [ -z "$_first" ]; then _first=$_id; elif [ "$_id" != "$_first" ]; then _differ=1; fi
  done
  [ "$_differ" = 0 ] || die "declarations DISAGREE: identities differ"
  printf 'agree: OK (%s declarations, identity %s)\n' "$#" "$_first"
}
# ------------------------------------------------------------------ slices
slice_ok() { # FILE SIZE SHA
  [ "$(size_of "$1")" = "$2" ] || return 1
  [ "$(sha_file "$1")" = "$3" ]
}
whole_ok() { # FILE ID
  [ "$(sha_file "$1")" = "$2" ]
}
manifest_ok() {
  $AWK -F'\t' -v n="$STRIPES" '
    NF != 3 || $1 != (NR ".of." n) || $2 !~ /^[0-9]+$/ || length($3) != 64 || $3 ~ /[^0-9a-f]/ { bad = 1 }
    END { exit (bad || NR != n) ? 1 : 0 }' "$TMP/manifest"
}
manifest_field() { $AWK -F'\t' -v i="$1" -v c="$2" 'NR==i{print $c}' "$TMP/manifest"; }

# 0 ok, 1 no manifest anywhere, 2 manifests disagree or malformed (MFAIL says)
MFAIL=; MSRC=
fetch_manifest() { # ID  (MSRC: the member whose MANIFEST was read)
  _have=0; MSRC=
  for _h in $MEMBERS; do
    member_up "$_h" || continue
    _m="$(sdir "$_h" "$1")/MANIFEST"
    [ -f "$_m" ] || continue
    if [ "$_have" = 0 ]; then
      cp "$_m" "$TMP/manifest"; _have=1; _mh=$_h; MSRC=$_h
    elif ! cmp -s "$_m" "$TMP/manifest"; then
      MFAIL="manifest on $_h differs from the one on $_mh"; return 2
    fi
  done
  [ "$_have" = 1 ] || return 1
  manifest_ok || { MFAIL="malformed manifest (from $_mh)"; return 2; }
  return 0
}

ASM_FAIL=
assemble() { # ID DEST [q]: any good copy of each slice, from any reachable member
  : > "$2"; : > "$TMP/asmsrc"
  a_i=1
  while [ "$a_i" -le "$STRIPES" ]; do
    a_size=$(manifest_field "$a_i" 2); a_sha=$(manifest_field "$a_i" 3)
    a_ok=0
    for a_h in $MEMBERS; do
      member_up "$a_h" || continue
      a_f="$(sdir "$a_h" "$1")/$a_i.of.$STRIPES"
      [ -f "$a_f" ] || continue
      if slice_ok "$a_f" "$a_size" "$a_sha"; then
        cat "$a_f" >> "$2"; a_ok=1; printf "%s\t%s\n" "$a_i" "$a_h" >> "$TMP/asmsrc"; break
      elif [ "${3:-}" != q ]; then
        warn "CORRUPT slice $a_i.of.$STRIPES on $a_h does not match the manifest (size or sha256)"
      fi
    done
    [ "$a_ok" = 1 ] || { ASM_FAIL="slice $a_i.of.$STRIPES has no good copy on any reachable member"; return 1; }
    a_i=$((a_i + 1))
  done
}

cmd_put() {
  _decl=${1:-}; _file=${2:-}
  [ -n "$_decl" ] && [ -n "$_file" ] || die "put: need DECL FILE"
  load "$_decl"; need_spoke put
  [ "$VIS" != sealed ] || die "put: VISIBILITY sealed needs encryption, which orgfs does not have yet; refusing"
  [ -f "$_file" ] || die "put: cannot read $_file"
  for _h in $MEMBERS; do
    member_up "$_h" || die "put: member $_h unusable: $WHY"
  done
  make_plan
  _size=$(size_of "$_file")
  _id=$(sha_file "$_file")
  _sz=$(( (_size + STRIPES - 1) / STRIPES ))
  [ "$_sz" -ge 1 ] || _sz=1
  [ "$_sz" -le 2000000000 ] || die "put: slices over 2 GB are not supported (file too large for $STRIPES stripes)"
  : > "$TMP/manifest"
  _i=1
  while [ "$_i" -le "$STRIPES" ]; do
    _sl="$TMP/slice.$_i"
    dd if="$_file" of="$_sl" bs="$_sz" skip=$((_i - 1)) count=1 2>/dev/null
    [ -f "$_sl" ] || : > "$_sl"
    printf '%s.of.%s\t%s\t%s\n' "$_i" "$STRIPES" "$(size_of "$_sl")" "$(sha_file "$_sl")" >> "$TMP/manifest"
    for _h in $(holders_of "$_i"); do
      _d=$(sdir "$_h" "$_id")
      mkdir -p "$_d" || die "put: cannot create $_d"
      cp "$_sl" "$_d/$_i.of.$STRIPES.part" && mv "$_d/$_i.of.$STRIPES.part" "$_d/$_i.of.$STRIPES" \
        || die "put: cannot write slice $_i to $_h"
    done
    rm -f "$_sl"
    _i=$((_i + 1))
  done
  for _h in $MEMBERS; do
    _d=$(sdir "$_h" "$_id")
    mkdir -p "$_d" && cp "$TMP/manifest" "$_d/MANIFEST" || die "put: cannot write manifest to $_h"
  done
  printf '%s\n' "$_id"
}

cmd_get() {
  _decl=${1:-}; _id=${2:-}; _out=${3:-}
  [ -n "$_decl" ] && [ -n "$_id" ] && [ -n "$_out" ] || die "get: need DECL ID OUT"
  case $_id in *[!0-9a-f]*) die "get: ID must be 64 lowercase hex digits";; esac
  [ "${#_id}" = 64 ] || die "get: ID must be 64 lowercase hex digits"
  load "$_decl"; need_spoke get
  for _h in $MEMBERS; do
    member_up "$_h" || warn "member $_h unavailable ($WHY); using the others"
  done
  fetch_manifest "$_id"; _rc=$?
  [ "$_rc" != 1 ] || die "get: no manifest for $_id on any reachable member"
  [ "$_rc" = 0 ] || die "get: $MFAIL"
  assemble "$_id" "$TMP/whole" || die "get: $ASM_FAIL"
  whole_ok "$TMP/whole" "$_id" || die "get: WHOLE-FILE HASH MISMATCH: reassembled bytes do not hash to $_id; not writing $_out"
  cp "$TMP/whole" "$_out" || die "get: cannot write $_out"
  printf 'get: OK %s -> %s (%s bytes)\n' "$_id" "$_out" "$(size_of "$_out")"
}

verify_object() { # ID -> prints OK/FAIL lines, status 0/1
  v_id=$1
  fetch_manifest "$v_id"; v_rc=$?
  case $v_rc in
    1) echo "FAIL $v_id: no manifest on any reachable member"; return 1;;
    2) echo "FAIL $v_id: $MFAIL"; return 1;;
  esac
  v_bad=0; v_i=1
  while [ "$v_i" -le "$STRIPES" ]; do
    v_size=$(manifest_field "$v_i" 2); v_sha=$(manifest_field "$v_i" 3)
    v_good=0; v_notes=
    for v_h in $(holders_of "$v_i"); do
      if ! member_up "$v_h"; then v_notes="$v_notes $v_h:down"; continue; fi
      v_f="$(sdir "$v_h" "$v_id")/$v_i.of.$STRIPES"
      if [ ! -f "$v_f" ]; then v_notes="$v_notes $v_h:missing"
      elif slice_ok "$v_f" "$v_size" "$v_sha"; then v_good=$((v_good + 1))
      else v_notes="$v_notes $v_h:corrupt"; fi
    done
    if [ "$v_good" -ge "$REPLICAS" ]; then :; else
      echo "FAIL $v_id slice $v_i.of.$STRIPES: $v_good of $REPLICAS copies good;$v_notes"; v_bad=1
    fi
    v_i=$((v_i + 1))
  done
  if assemble "$v_id" "$TMP/vwhole" q && whole_ok "$TMP/vwhole" "$v_id"; then :; else
    echo "FAIL $v_id: cannot reassemble a file hashing to the ID ${ASM_FAIL:+($ASM_FAIL)}"; v_bad=1
  fi
  [ "$v_bad" = 0 ] && echo "OK $v_id slices=$STRIPES replicas=$REPLICAS"
  return "$v_bad"
}

cmd_verify() {
  _decl=${1:-}; [ -n "$_decl" ] || die "verify: need DECL"
  load "$_decl"; need_spoke verify
  make_plan
  : > "$TMP/objs"
  for _h in $MEMBERS; do
    member_up "$_h" || { warn "member $_h unavailable ($WHY)"; continue; }
    ls "$(root_of "$_h")/.orgfs/$SPOKE" 2>/dev/null >> "$TMP/objs"
  done
  _ids=$(grep -E '^[0-9a-f]{64}$' "$TMP/objs" | sort -u)
  [ -n "$_ids" ] || { echo "verify: no objects in spoke $SPOKE"; return 0; }
  _fail=0; _n=0
  for _o in $_ids; do
    _n=$((_n + 1))
    verify_object "$_o" || _fail=1
  done
  if [ "$_fail" = 0 ]; then echo "verify: OK ($_n objects)"; else echo "verify: FAIL"; return 1; fi
}


# ------------------------------------------------------------------ gaps
# A view never just drops something.  Wherever it leaves something out it writes
# a gap record: WHAT is missing (kind and shape, never content) and HOW and WHY it
# is missing, which line of the declaration states the rule, who could reach it,
# and the routes that would fill it.  GAPS_AWK reads any view and refuses a gap
# record that lacks one of those parts.
GAPS_AWK='
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
function endgap(   i, ok) {
  if (!ing) return
  ing = 0; indr = 0; ok = 1; ngaps++
  for (i = 1; i <= nreq; i++) if (got[req[i]] == "") { printf "orgfs: gap %s lacks %s\n", gid, req[i] > "/dev/stderr"; ok = 0 }
  if (nroute < 1) { printf "orgfs: gap %s has no route that would fill it\n", gid > "/dev/stderr"; ok = 0 }
  if (!ok) { bad = 1; return }
  if (mode == "tsv") printf "%s\t%s\t%s\t%s\t%s\t%s\n", gid, got["WHAT_KIND"], got["WHAT_SHAPE"], got["RULE"], got["RULE_AT"], got["REACH"]
  if (mode == "list") {
    printf "gap %s (kind %s): %s\n", gid, got["WHAT_KIND"], got["WHAT_SHAPE"]
    printf "  rule: %s\n  declared at: %s\n  how: %s\n  why: %s\n  reach: %s\n", got["RULE"], got["RULE_AT"], got["HOW"], got["WHY"], got["REACH"]
    for (i = 1; i <= nroute; i++) printf "  fill by: %s\n", routes[i]
  }
}
BEGIN { nreq = split("GAP_ID WHAT_KIND WHAT_SHAPE RULE RULE_AT HOW WHY REACH", req, " "); ing = 0; indr = 0; bad = 0; ngaps = 0 }
/^\*+ gap / { endgap(); ing = 1; indr = 0; gid = $0; sub(/^\*+ gap /, "", gid); split("", got); split("", routes); nroute = 0; next }
ing && /^\*+ / { endgap() }
ing && /^:PROPERTIES:/ { indr = 1; next }
ing && /^:END:/ { endgap(); next }
ing && indr && match($0, /^:[A-Z_]+:/) {
  k = substr($0, 2, RLENGTH - 2); v = trim(substr($0, RLENGTH + 1))
  if (k == "ROUTE") { nroute++; routes[nroute] = v } else got[k] = v
  next
}
END { endgap(); if (mode == "list" && !bad) printf "routes: %d gaps, each with a rule, a declaring line, a reach and at least one route\n", ngaps; exit bad }
'

gap_open() { # LEVEL ID KIND SHAPE RULE RULE_AT HOW WHY REACH
  printf '%s gap %s\n:PROPERTIES:\n:ROLE: gap\n:GAP_ID: %s\n:WHAT_KIND: %s\n:WHAT_SHAPE: %s\n:RULE: %s\n:RULE_AT: %s\n:HOW: %s\n:WHY: %s\n:REACH: %s\n' \
    "$1" "$2" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9"
}
gap_route() { printf ':ROUTE: %s\n' "$1"; }
gap_close() { printf ':END:\n'; }

is_member() { in_list "$VHOST" "$MEMBERS"; }
at_spoke() { printf '%s (:%s:)' "$(spoke_line "$1")" "$1"; }
n_members() { printf '%s\n' "$MEMBERS" | wc -l | tr -d ' '; }

# who could reach what a gap stands for, and by which routes
reach_text() {
  rt_m=$(echo $MEMBERS)
  case $VIS in
    sealed) if is_member; then printf '%s' "$rt_m"; else printf 'members of spoke %s (names withheld: sealed)' "$SPOKE"; fi;;
    public) printf '%s; any host that mounts their ROOT paths (VISIBILITY public)' "$rt_m";;
    *) printf '%s' "$rt_m";;
  esac
}
routes_for() { # VERB TAIL
  if [ "$VIS" = sealed ] && ! is_member; then
    gap_route "on a member of spoke $SPOKE: orgfs $1 DECL --as MEMBER $2"
    return 0
  fi
  for rf_m in $MEMBERS; do gap_route "on $rf_m: orgfs $1 DECL --as $rf_m $2"; done
  [ "$VIS" != public ] || gap_route "on any host that mounts the ROOT paths: orgfs $1 DECL --as THAT_HOST $2"
  return 0
}

gap_spoke_grain() {
  gap_open '*' "$SPOKE/grain" spoke "1 spoke, $(n_members) members" \
    "assemble and materialize gather only the grain asked for" \
    "not in the declaration: the command line named --spoke $G_SPOKE" \
    "the spoke was left out of this collection" \
    "a narrower grain was asked for; the declaration withholds nothing by this" "$(reach_text)"
  routes_for "$VERB" "--spoke $SPOKE${G_INTO:+ --into DIR}"
  gap_close
}

gap_sealed() {
  gap_open '*' "$SPOKE/sealed" spoke "1 spoke, $(n_members) members" \
    "VISIBILITY sealed: a non-member is told the spoke exists and what it is called, nothing more" \
    "$(at_spoke VISIBILITY)" \
    "$VERB left the whole spoke out of this view: its properties, member names, roots and objects" \
    "the spoke is sealed and $VHOST is not one of its members" "$(reach_text)"
  routes_for "$VERB" "--spoke $SPOKE"
  gap_close
}

gap_member_root() { # HOST
  gm_n=$(root_of "$1" | $AWK -F/ '{print NF - 1}')
  gap_open '**' "$SPOKE/member-root/$1" member-root "1 absolute path, $gm_n components" \
    "VISIBILITY private: a non-member sees who the members are, not where they keep their slices" \
    "$(at_spoke VISIBILITY); withheld field declared at $(member_line "$1" ROOT) (:ROOT:)" \
    "$VERB left the :ROOT: property of member $1 out of this view" \
    "the spoke is private and $VHOST is not one of its members" "$(reach_text)"
  routes_for materialize "--spoke $SPOKE"
  gap_close
}

gap_objects_hidden() {
  gap_open '**' "$SPOKE/objects" objects "unknown number of objects with their manifests; the store is not read" \
    "VISIBILITY private: only members read a private spoke's store" \
    "$(at_spoke VISIBILITY)" \
    "$VERB did not read the stores of spoke $SPOKE for this host" \
    "the spoke is private and $VHOST is not one of its members" "$(reach_text)"
  routes_for assemble "--spoke $SPOKE --into DIR"
  gap_close
}

gap_member_store() { # HOST WHY
  gap_open '**' "$SPOKE/member-store/$1" member-store "1 store: the .orgfs tree under one ROOT" \
    "a member's store is read only if its ROOT is a directory, and a mount point for TRANSPORT sshfs" \
    "$(member_line "$1" ROOT) (:ROOT:), $(member_line "$1" TRANSPORT) (:TRANSPORT:)" \
    "$VERB could not read the store of member $1: $2" \
    "the store is not reachable from the machine that built this view" \
    "$1; any host that has $1's ROOT mounted at the same path"
  gap_route "on $1: orgfs $VERB DECL --as $VHOST --spoke $SPOKE${G_INTO:+ --into DIR}"
  gap_route "on any host where $1's ROOT is mounted at the same path: orgfs $VERB DECL --as $VHOST --spoke $SPOKE${G_INTO:+ --into DIR}"
  gap_close
}

gap_object_grain() { # OBJECT
  gap_open '**' "$SPOKE/object-grain/$1" object "1 object" \
    "assemble and materialize gather only the grain asked for" \
    "not in the declaration: the command line named --object $G_OBJECT" \
    "the object was left out of this collection" \
    "a narrower grain was asked for; the declaration withholds nothing by this" "$(reach_text)"
  routes_for "$VERB" "--spoke $SPOKE --object $1${G_INTO:+ --into DIR}"
  gap_close
}

gap_manifest() { # OBJECT WHY
  gap_open '**' "$SPOKE/manifest/$1" manifest "1 MANIFEST of $STRIPES rows" \
    "an object is shown only if one MANIFEST exists and every reachable member holds the same one" \
    "$(at_spoke STRIPES)" \
    "$VERB left object $1 out: $2" \
    "the manifest could not be fetched in a form every reachable member agrees on" "$(reach_text)"
  routes_for verify "--spoke $SPOKE"
  gap_close
}

gap_backlink() { # LEVEL OBJECT MEMBER
  gap_open "$1" "$SPOKE/backlink/$2/$3" backlink "1 record: one line in a MATERIALIZED file" \
    "the source side keeps a record of which hosts materialized an object" \
    "$(member_line "$3" ROOT) (:ROOT:)" \
    "$VERB could not write the record on member $3: its store directory for the object is not writable from here" \
    "the view links to this source one way only until the record exists" "$3; any host that can write $3's store"
  gap_route "on $3: orgfs $VERB DECL --as $VHOST --spoke $SPOKE --object $2${G_INTO:+ --into DIR}"
  gap_close
}

gap_slice_bytes() { # OBJECT STRIPE SIZE HOLDERS HELD WHYEXTRA
  gs_id="$STRIPES"
  if [ "$5" = yes ]; then
    gs_rule="a view carries manifest rows, never slice bytes"
    gs_at="not in the declaration: a rule of orgfs materialize (README, Views)"
    gs_why="a view is a record of where things are; bytes travel by assemble or get${6:+; $6}"
  else
    gs_rule="rendezvous plan: only the REPLICAS highest-scoring members hold a stripe"
    gs_at="$(spoke_line STRIPES) (:STRIPES:), $(spoke_line REPLICAS) (:REPLICAS:)"
    gs_why="$VHOST holds no copy of stripe $2 under the plan, and a view carries no bytes either way${6:+; $6}"
  fi
  gap_open '****' "$SPOKE/slice-bytes/$1/$2.of.$STRIPES" slice-bytes "1 slice, $3 bytes" \
    "$gs_rule" "$gs_at" \
    "$VERB left the bytes of slice $2.of.$STRIPES out of this view" "$gs_why" "$4"
  for gs_h in $4; do gap_route "on $gs_h: orgfs assemble DECL --as $gs_h --spoke $SPOKE --object $1 --into DIR"; done
  gap_close
}

# ------------------------------------------------------------------ views
list_objects() { # -> $TMP/objs2 (sorted ids), $TMP/downs (host TAB why)
  : > "$TMP/objs"; : > "$TMP/downs"
  for lo_h in $MEMBERS; do
    if member_up "$lo_h"; then
      ls "$(root_of "$lo_h")/.orgfs/$SPOKE" 2>/dev/null >> "$TMP/objs"
    else
      printf '%s\t%s\n' "$lo_h" "$WHY" >> "$TMP/downs"
    fi
  done
  grep -E '^[0-9a-f]{64}$' "$TMP/objs" | sort -u > "$TMP/objs2"
}

view_object() { # ID
  vo=$1
  fetch_manifest "$vo"; vo_rc=$?
  if [ "$vo_rc" = 1 ]; then gap_manifest "$vo" "no MANIFEST for it on any reachable member"; return 0; fi
  if [ "$vo_rc" = 2 ]; then gap_manifest "$vo" "$MFAIL"; return 0; fi
  vo_msrc=$MSRC
  vo_mdir=$(sdir "$vo_msrc" "$vo")
  vo_total=$($AWK -F'\t' '{ s += $2 } END { print s + 0 }' "$TMP/manifest")
  vo_bytes=0; vo_extra=
  if [ -n "$G_INTO" ]; then
    if assemble "$vo" "$TMP/obytes" q && whole_ok "$TMP/obytes" "$vo"; then
      mkdir -p "$G_INTO/$SPOKE" && cp "$TMP/obytes" "$G_INTO/$SPOKE/$vo" || die "$VERB: cannot write $G_INTO/$SPOKE/$vo"
      vo_bytes=1
    else
      vo_extra="assemble could not rebuild the object: ${ASM_FAIL:-the bytes do not hash to the ID}"
    fi
  fi
  # the members this object's items come from: where the manifest was read, and where bytes were
  : > "$TMP/bl"; : > "$TMP/blgap"
  { printf '%s\n' "$vo_msrc"; [ "$vo_bytes" = 0 ] || cut -f2 "$TMP/asmsrc"; } | sort -u > "$TMP/srcm"
  for vo_m in $(cat "$TMP/srcm"); do
    vo_d=$(sdir "$vo_m" "$vo")
    if [ -d "$vo_d" ] && [ -w "$vo_d" ]; then
      printf ':BACKLINK: %s/MATERIALIZED\n' "$vo_d" >> "$TMP/bl"
      printf '%s\t%s\t%s\t%s\n' "$vo_d" "$vo_m" "$SPOKE" "$vo" >> "$TMP/srcs"
    else
      printf '%s\n' "$vo_m" >> "$TMP/blgap"
    fi
  done
  printf '** object %s\n:PROPERTIES:\n:ROLE: fetched\n:SOURCE_SPOKE: %s\n:SOURCE_OBJECT: %s\n:SOURCE_MEMBER: %s\n:SOURCE_PATH: %s/MANIFEST\n:SIZE: %s\n:SLICES: %s\n' \
    "$vo" "$SPOKE" "$vo" "$vo_msrc" "$vo_mdir" "$vo_total" "$STRIPES"
  [ "$vo_bytes" = 0 ] || printf ':BYTES_AT: %s/%s/%s\n' "$G_INTO" "$SPOKE" "$vo"
  cat "$TMP/bl"
  printf ':END:\n'
  for vo_m in $(cat "$TMP/blgap"); do gap_backlink '***' "$vo" "$vo_m"; done
  vo_i=1
  while [ "$vo_i" -le "$STRIPES" ]; do
    vo_size=$(manifest_field "$vo_i" 2); vo_sha=$(manifest_field "$vo_i" 3)
    vo_hold=$(holders_of "$vo_i" | tr '\n' ' ' | sed 's/ $//')
    if in_list "$VHOST" "$vo_hold"; then vo_held=yes; else vo_held=no; fi
    if [ "$vo_bytes" = 1 ]; then
      vo_sm=$($AWK -F'\t' -v i="$vo_i" '$1==i{print $2}' "$TMP/asmsrc")
      vo_sp="$(sdir "$vo_sm" "$vo")/$vo_i.of.$STRIPES"
    else
      vo_sm=$vo_msrc; vo_sp="$vo_mdir/MANIFEST"
    fi
    printf '*** slice %s.of.%s\n:PROPERTIES:\n:ROLE: fetched\n:SOURCE_SPOKE: %s\n:SOURCE_OBJECT: %s\n:SOURCE_SLICE: %s.of.%s\n:SOURCE_MEMBER: %s\n:SOURCE_PATH: %s\n:SIZE: %s\n:SHA256: %s\n:HOLDERS: %s\n:HELD_HERE: %s\n:END:\n' \
      "$vo_i" "$STRIPES" "$SPOKE" "$vo" "$vo_i" "$STRIPES" "$vo_sm" "$vo_sp" "$vo_size" "$vo_sha" "$vo_hold" "$vo_held"
    [ "$vo_bytes" = 1 ] || gap_slice_bytes "$vo" "$vo_i" "$vo_size" "$vo_hold" "$vo_held" "$vo_extra"
    vo_i=$((vo_i + 1))
  done
}

view_spoke() {
  if [ -n "$G_SPOKE" ] && [ "$G_SPOKE" != "$SPOKE" ]; then gap_spoke_grain; return 0; fi
  if is_member; then vs_acc=member; elif [ "$VIS" = public ]; then vs_acc=read; else vs_acc=none; fi
  if [ "$VIS" = sealed ] && [ "$vs_acc" != member ]; then gap_sealed; return 0; fi
  make_plan
  printf '* spoke %s\n:PROPERTIES:\n:ROLE: displayed\n:SPOKE_ID: %s\n:RING: %s\n:STRIPES: %s\n:REPLICAS: %s\n:VISIBILITY: %s\n:ACCESS: %s\n:DECLARED_AT: %s\n:END:\n' \
    "$SPOKE" "$ID" "$RING" "$STRIPES" "$REPLICAS" "$VIS" "$vs_acc" "$(spoke_line heading)"
  for vs_h in $MEMBERS; do
    printf '** member %s\n:PROPERTIES:\n:ROLE: displayed\n:TRANSPORT: %s\n' "$vs_h" "$(tr_of "$vs_h")"
    [ "$vs_acc" = none ] || printf ':ROOT: %s\n' "$(root_of "$vs_h")"
    printf ':HOLDS: %s\n:DECLARED_AT: %s\n:END:\n' "$(holds_of "$vs_h")" "$(member_line "$vs_h" heading)"
    [ "$vs_acc" != none ] || gap_member_root "$vs_h"
  done
  if [ "$vs_acc" = none ]; then gap_objects_hidden; return 0; fi
  list_objects
  while IFS="$TAB" read -r vs_dh vs_dw; do
    [ -z "$vs_dh" ] || gap_member_store "$vs_dh" "$vs_dw"
  done < "$TMP/downs"
  if [ -n "$G_OBJECT" ] && [ "$SPOKE" = "$G_OBJSPOKE" ]; then
    grep -qx -- "$G_OBJECT" "$TMP/objs2" || die "$VERB: object $G_OBJECT is not stored in spoke $SPOKE on any reachable member"
  fi
  for vs_o in $(cat "$TMP/objs2"); do
    if [ -n "$G_OBJECT" ] && [ "$SPOKE" = "$G_OBJSPOKE" ] && [ "$vs_o" != "$G_OBJECT" ]; then
      gap_object_grain "$vs_o"
    else
      view_object "$vs_o"
    fi
  done
}

TAB=$(printf '\t')

make_view() { # -> $TMP/view  (and the records on the source side)
  : > "$TMP/srcs"
  if [ -n "$G_OBJECT" ]; then vm_grain="object $G_OBJECT in spoke $G_OBJSPOKE"
  elif [ -n "$G_SPOKE" ]; then vm_grain="spoke $G_SPOKE"
  else vm_grain="all spokes"; fi
  case $VERB in materialize) vm_kind=materialized;; *) vm_kind=assembled;; esac
  {
    printf '#+TITLE: orgfs view of a declaration, as %s\n' "$VHOST"
    printf '* view\n:PROPERTIES:\n:KIND: %s\n:AS: %s\n:ORGFS: %s\n:FILE_ID: %s\n:GRAIN: %s\n:SPOKES: %s\n:END:\n' \
      "$vm_kind" "$VHOST" "$VERSION" "$FILEID" "$vm_grain" "$NSP"
    for vm_s in $SPOKES; do load_spoke "$vm_s"; view_spoke; done
  } > "$TMP/view.body"
  $AWK -v mode=check "$GAPS_AWK" "$TMP/view.body" || die "$VERB: refusing to emit a view with an incomplete gap record"
  VIEWID=$(sha_file "$TMP/view.body")
  { cat "$TMP/view.body"; printf '# view-id: %s\n' "$VIEWID"; } > "$TMP/view"
  # the source side learns who materialized it (idempotent: same view, same line)
  sort -u "$TMP/srcs" > "$TMP/srcs2"
  while IFS="$TAB" read -r vm_d vm_m vm_sp vm_o; do
    [ -n "$vm_d" ] || continue
    vm_row="$VIEWID$TAB$VHOST$TAB$vm_kind$TAB$FILEID$TAB$vm_sp$TAB$vm_o"
    grep -qxF -- "$vm_row" "$vm_d/MATERIALIZED" 2>/dev/null || printf '%s\n' "$vm_row" >> "$vm_d/MATERIALIZED" \
      || die "$VERB: cannot write the record on member $vm_m"
  done < "$TMP/srcs2"
}

cmd_view() { # VERB DECL...
  VERB=$1; shift
  _decl=${1:-}; [ -n "$_decl" ] || die "$VERB: need DECL"
  [ -n "$O_AS" ] || die "$VERB: need --as HOST"
  case $O_AS in *[!A-Za-z0-9._-]*|[!A-Za-z0-9]*) die "$VERB: bad host name: $O_AS";; esac
  VHOST=$O_AS
  G_INTO=
  if [ "$VERB" = assemble ]; then
    [ -n "$O_INTO" ] || die "assemble: need --into DIR (where the bytes go)"
    mkdir -p "$O_INTO" || die "assemble: cannot create $O_INTO"
    G_INTO=$(cd "$O_INTO" && pwd)
  else
    [ -z "$O_INTO" ] || die "materialize carries no bytes; use assemble --into DIR"
  fi
  load "$_decl"
  G_SPOKE=$O_SPOKE; G_OBJECT=$O_OBJECT; G_OBJSPOKE=
  if [ -n "$G_OBJECT" ]; then
    case $G_OBJECT in *[!0-9a-f]*) die "$VERB: --object must be 64 lowercase hex digits";; esac
    [ "${#G_OBJECT}" = 64 ] || die "$VERB: --object must be 64 lowercase hex digits"
    if [ -n "$O_SPOKE" ]; then G_OBJSPOKE=$O_SPOKE
    elif [ "$NSP" = 1 ]; then G_OBJSPOKE=$SPOKES
    else die "$VERB: --object needs --spoke when the declaration holds several spokes ($(echo $SPOKES))"; fi
  fi
  make_view
  _gaps=$($AWK '/^\*+ gap /{ n++ } END { print n + 0 }' "$TMP/view")
  if [ -n "$O_OUT" ]; then
    cp "$TMP/view" "$O_OUT" || die "$VERB: cannot write $O_OUT"
    printf '%s: wrote %s (view-id %s; %s gap records)\n' "$VERB" "$O_OUT" "$VIEWID" "$_gaps"
  else
    cat "$TMP/view"
  fi
}

cmd_routes() {
  _v=${1:-}; [ -f "$_v" ] || die "routes: need a view file"
  $AWK -v mode=list "$GAPS_AWK" "$_v" || die "routes: $_v holds an incomplete gap record"
}

trace_view() {
  _v=${1:-}; [ -f "$_v" ] || die "trace: need a view file (or DECL with --object ID)"
  _last=$(tail -n 1 "$_v")
  case $_last in "# view-id: "*) ;; *) die "trace: $_v has no view-id trailer";; esac
  _vid=${_last#"# view-id: "}
  _calc=$(sed '$d' "$_v" | sha_stdin)
  _bad=0
  if [ "$_calc" != "$_vid" ]; then
    echo "BROKEN  the text does not hash to its own view-id $_vid (edited since it was made?)"; _bad=1
  fi
  _host=$($AWK '/^:AS: /{ sub(/^:AS: /, ""); print; exit }' "$_v")
  grep '^:BACKLINK: ' "$_v" | sed 's/^:BACKLINK: //' | sort -u > "$TMP/bls"
  _n=0
  for _p in $(cat "$TMP/bls"); do
    _n=$((_n + 1))
    if [ -f "$_p" ] && $AWK -F'\t' -v v="$_vid" -v h="$_host" '$1==v&&$2==h{f=1} END{exit f?0:1}' "$_p"; then
      echo "linked  $_p lists view $_vid as host $_host"
    else
      echo "BROKEN  $_p does not list view $_vid for host $_host"; _bad=1
    fi
  done
  if [ "$_bad" = 0 ]; then echo "trace: OK ($_n source records)"; else echo "trace: FAIL"; return 1; fi
}

trace_object() {
  _decl=${1:-}; [ -n "$_decl" ] || die "trace: need DECL"
  case $O_OBJECT in *[!0-9a-f]*) die "trace: --object must be 64 lowercase hex digits";; esac
  [ "${#O_OBJECT}" = 64 ] || die "trace: --object must be 64 lowercase hex digits"
  load "$_decl"; need_spoke trace
  _n=0
  for _h in $MEMBERS; do
    member_up "$_h" || { warn "member $_h unavailable ($WHY)"; continue; }
    _f="$(sdir "$_h" "$O_OBJECT")/MATERIALIZED"
    [ -f "$_f" ] || continue
    $AWK -F'\t' -v m="$_h" '{ printf "view %s  as %s  (%s, file %s)  recorded on %s\n", $1, $2, $3, $4, m }' "$_f"
    _n=$((_n + $(wc -l < "$_f" | tr -d ' ')))
  done
  echo "trace: $_n record(s) for object $O_OBJECT in spoke $SPOKE"
}

cmd_trace() {
  if [ -n "$O_OBJECT" ]; then trace_object "$@"; else trace_view "$@"; fi
}

# ------------------------------------------------------------------ layout
LAY_HELD=0; LAY_BAD=0; LAY_NC=0
lay() { # STATE RULE DETAIL
  printf '%s\t%s\t%s\n' "$1" "$2" "$3"
  case $1 in
    held) LAY_HELD=$((LAY_HELD + 1));;
    broken) LAY_BAD=$((LAY_BAD + 1));;
    *) LAY_NC=$((LAY_NC + 1));;
  esac
}

lay_owner() { # RULE PATH
  lo_ids=$(ls -ldn "$2/." 2>/dev/null | $AWK '{ print $3 " " $4 }')
  [ -n "$lo_ids" ] || { lay "not checked" "$1" "cannot read the owner of $2"; return 0; }
  lo_u=${lo_ids% *}; lo_g=${lo_ids#* }
  if [ "$lo_u" = 0 ]; then lay held "$1" "$2 is owned by root"; return 0; fi
  lo_cg=; lo_hg=
  if [ -r "$LAY_P/etc/passwd" ]; then
    lo_cg=$($AWK -F: '$1=="c4"{ print $4; exit }' "$LAY_P/etc/passwd")
    [ -z "$LAY_HN" ] || lo_hg=$($AWK -F: -v n="$LAY_HN" '$1==n{ print $4; exit }' "$LAY_P/etc/passwd")
  fi
  if [ -n "$lo_cg" ] && [ "$lo_g" = "$lo_cg" ]; then
    lay held "$1" "$2 belongs to group $lo_g, the primary group of account c4"
  elif [ -n "$lo_hg" ] && [ "$lo_g" = "$lo_hg" ]; then
    lay held "$1" "$2 belongs to group $lo_g, the primary group of account $LAY_HN"
  else
    lay broken "$1" "$2 is owned by uid $lo_u gid $lo_g; it should belong to root, or to the primary group of account c4${LAY_HN:+ or of account $LAY_HN} (found: c4 group ${lo_cg:-none}, host-account group ${lo_hg:-none})"
  fi
}

cmd_layout() {
  LAY_P=${O_ROOT%/}
  LAY_HN=${ORGFS_HOSTNAME:-}
  [ -n "$LAY_HN" ] || { [ -r "$LAY_P/etc/hostname" ] && LAY_HN=$(head -n 1 "$LAY_P/etc/hostname" | tr -d ' \r'); }
  [ -n "$LAY_HN" ] || LAY_HN=$(hostname 2>/dev/null || true)
  LAY_HN=${LAY_HN%%.*}
  case $LAY_HN in
    [a-z][a-z][0-9][0-9]) lay_note="follows the gwNN pattern (two letters, two digits)";;
    '') lay_note="not known";;
    *) lay_note="its own identifier; it follows no gwNN pattern, which is allowed and is not a fault";;
  esac
  printf '# layout of %s (host name: %s; %s)\n' "${LAY_P:-/}" "${LAY_HN:-unknown}" "$lay_note"
  if [ -d "$LAY_P/c4" ]; then lay held c4-present "/c4 is a directory (it seats the host's principal registry)"
  else lay broken c4-present "/c4 is not a directory here (it should seat the host's principal registry)"; fi
  if [ -d "$LAY_P/spokes" ]; then lay held spokes-present "/spokes is a directory (it seats every cross-mounted spoke)"
  else lay broken spokes-present "/spokes is not a directory here (it should seat every cross-mounted spoke)"; fi
  if [ -d "$LAY_P/c4" ]; then lay_owner c4-owner "$LAY_P/c4"
  else lay "not checked" c4-owner "/c4 does not exist, so its owner cannot be read"; fi
  if [ -d "$LAY_P/etc/c4" ]; then lay_owner etc-c4-owner "$LAY_P/etc/c4"
  else lay "not checked" etc-c4-owner "/etc/c4 does not exist; the rule applies where it exists"; fi
  if [ -z "$O_DECL" ]; then
    lay "not checked" spokes-roots "no --decl given; this rule reads the sshfs members' ROOT paths from a declaration"
  else
    load "$O_DECL"
    lr_bad=0; lr_n=0
    for lr_s in $SPOKES; do
      load_spoke "$lr_s"
      for lr_h in $MEMBERS; do
        [ "$(tr_of "$lr_h")" = sshfs ] || continue
        lr_n=$((lr_n + 1))
        case $(root_of "$lr_h") in
          /spokes/*) ;;
          *) lay broken spokes-roots "spoke $SPOKE member $lr_h: sshfs ROOT $(root_of "$lr_h") is not under /spokes"; lr_bad=1;;
        esac
      done
    done
    [ "$lr_bad" = 1 ] || lay held spokes-roots "all $lr_n sshfs ROOT paths in $O_DECL are under /spokes"
  fi
  printf 'layout: %s held, %s broken, %s not checked\n' "$LAY_HELD" "$LAY_BAD" "$LAY_NC"
  [ "$LAY_BAD" = 0 ]
}
# ------------------------------------------------------------------ register
REGISTER_TXT_AWK='
BEGIN { FS = "\t" }
NR == 1 { next }
NF != 4 { printf "orgfs: register line %d has %d fields, want 4\n", NR, NF > "/dev/stderr"; bad = 1; next }
{ printf "%s\n  licence: %s\n  source:  %s\n  why:     %s\n\n", $1, $2, $3, $4 }
END { exit bad ? 1 : 0 }
'

# ------------------------------------------------------------------ who
# orgfs who REPO [PATH...] [--since DATE] [--until DATE]: "who worked on my stuff over time?"
# Reads git log (local, no network), writes an Org document in which the contributor, the path and
# the commit are each a target (a heading with :CUSTOM_ID:) and each links to the other two, both ways.
# Identities are the author name and email exactly as the commits give them: never merged, never
# normalised (no .mailmap).  Every identifier is made from the data (a commit's abbreviated hash, a
# path or an identity with the bytes outside [A-Za-z0-9.-] written as _XX hex); none is invented.
WHO_FMT='%x01%h%x1f%H%x1f%an%x1f%ae%x1f%ad%x1f%aI%x1f%s'

WHO_PARSE_AWK='
function init_ord(   i) { for (i = 1; i < 256; i++) ORD[sprintf("%c", i)] = i }
BEGIN {
  init_ord(); FS = "\037"; SOH = sprintf("%c", 1); n = 0; bad = 0
}
substr($0, 1, 1) == SOH {
  n++; short[n] = substr($1, 2); full[n] = $2; pn[n] = $3; pe[n] = $4; ds[n] = $5; iso[n] = $6
  subj = $7; for (k = 8; k <= NF; k++) subj = subj FS $k
  subject[n] = subj; npath[n] = 0; cur = n; next
}
$0 == "" { next }
{
  if (cur == 0) next
  if (index($0, "\t") > 0) { printf "orgfs: who: commit %s lists a path that holds a tab, which this tool does not carry: %s\n", short[cur], $0 > "/dev/stderr"; bad = 1; next }
  npath[cur]++; P[cur, npath[cur]] = $0
}
END {
  if (bad) exit 1
  np = 0
  for (s = 1; s <= n; s++) {
    i = n - s + 1; key = pn[i] SUBSEP pe[i]
    if (!(key in ord)) { np++; ord[key] = np; pname[np] = pn[i]; pemail[np] = pe[i]; pfirst[np] = ds[i]; pcnt[np] = 0 }
    o = ord[key]; pcnt[o]++; plast[o] = ds[i]
    printf "%d\t%s\t%s\t%d\t%s\t%s\t%s\n", s, short[i], full[i], o, ds[i], iso[i], subject[i] > cfile
    for (k = 1; k <= npath[i]; k++) printf "%d\t%s\t%d\n", o, P[i, k], s > ffile
  }
  for (o = 1; o <= np; o++) printf "%d\t%s\t%s\t%s\t%s\t%d\n", o, pname[o], pemail[o], pfirst[o], plast[o], pcnt[o] > pfile
  close(cfile); close(ffile); close(pfile)
}
'

WHO_COMMON_AWK='
function init_ord(   i) { for (i = 1; i < 256; i++) ORD[sprintf("%c", i)] = i }
function enc(s,   i, c, o) {
  o = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c ~ /^[A-Za-z0-9.-]$/) o = o c; else o = o sprintf("_%02x", ORD[c])
  }
  return o
}
function orgsafe(s,   i, c, d, o) {
  o = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1); d = substr(s, i + 1, 1); o = o c
    if ((c == "[" && d == "[") || c == "]" || (c == "<" && d == "<") || (c == "{" && d == "{")) o = o ZW
  }
  return o
}
function load(   line, a, n, i, s, o, subj) {
  nseq = 0; npers = 0; nf = 0
  while ((getline line < cfile) > 0) {
    n = split(line, a, "\t"); s = a[1] + 0; if (s > nseq) nseq = s
    cshort[s] = a[2]; cfull[s] = a[3]; cord[s] = a[4] + 0; cdate[s] = a[5]; ciso[s] = a[6]
    subj = a[7]; for (i = 8; i <= n; i++) subj = subj "\t" a[i]
    csubj[s] = subj
  }
  close(cfile)
  while ((getline line < pfile) > 0) {
    split(line, a, "\t"); o = a[1] + 0; if (o > npers) npers = o
    pname[o] = a[2]; pemail[o] = a[3]; pfirst[o] = a[4]; plast[o] = a[5]; pcnt[o] = a[6] + 0
  }
  close(pfile)
  while ((getline line < ffile) > 0) { split(line, a, "\t"); nf++; fo[nf] = a[1] + 0; fp[nf] = a[2]; fs[nf] = a[3] + 0 }
  close(ffile)
}
function pid(o) { return "person-" enc(pname[o] " <" pemail[o] ">") }
function plabel(o) { return orgsafe(pname[o] " <" pemail[o] ">") }
function pl(o) { return "[[#" pid(o) "][" plabel(o) "]]" }
function cl(s) { return "[[#commit-" cshort[s] "][" cshort[s] "]]" }
function xid(p) { return "path-" enc(p) }
function xl(p) { return "[[#" xid(p) "][" orgsafe(p) "]]" }
function nn(n, one, many) { return n == 1 ? "1 " one : n " " many }
'

# the Contributors section: F sorted by contributor, path, commit
WHO_PEOPLE_AWK='
BEGIN {
  init_ord(); load()
  for (i = 1; i <= nf; i++) { hasp[fs[i]] = 1; if (!(fo[i] in pstart)) pstart[fo[i]] = i; pend[fo[i]] = i }
  for (s = 1; s <= nseq; s++) if (!(s in hasp)) { o = cord[s]; empt[o] = (o in empt) ? empt[o] ", " cl(s) : cl(s) }
  print "* Contributors"
  for (o = 1; o <= npers; o++) {
    mp = 0; last = ""
    if (o in pstart) for (i = pstart[o]; i <= pend[o]; i++) if (fp[i] != last || i == pstart[o]) { mp++; last = fp[i] }
    printf "** %s\n:PROPERTIES:\n:CUSTOM_ID: %s\n:NAME: %s\n:EMAIL: %s\n:END:\n", plabel(o), pid(o), pname[o], pemail[o]
    printf "Observed: %s by this contributor, the first on %s and the last on %s, touching %s.\n", nn(pcnt[o], "commit", "commits"), pfirst[o], plast[o], nn(mp, "path", "paths")
    if (o in pstart) {
      print ""
      last = ""
      for (i = pstart[o]; i <= pend[o]; i++) {
        if (i == pstart[o] || fp[i] != last) { printf "- %s\n", xl(fp[i]); last = fp[i] }
        printf "  - %s %s\n", cdate[fs[i]], cl(fs[i])
      }
    }
    if (o in empt) printf "\nCommits of this contributor that list no path in this range (a merge or an empty commit): %s\n", empt[o]
  }
}
'

# the Paths section: F sorted by path, commit
WHO_PATHS_AWK='
function flush(   ) {
  if (cur == "") return
  printf "** %s\n:PROPERTIES:\n:CUSTOM_ID: %s\n:PATH: %s\n:END:\n", orgsafe(cur), xid(cur), cur
  printf "Observed: touched by %s, by %s, the first on %s and the last on %s.\n\n", nn(ncm, "commit", "commits"), nn(nps, "contributor", "contributors"), mind, maxd
  printf "%s", body
}
BEGIN {
  init_ord(); load(); cur = ""; print "* Paths"
  for (i = 1; i <= nf; i++) {
    if (fp[i] != cur) { flush(); cur = fp[i]; body = ""; ncm = 0; nps = 0; mind = ""; maxd = ""; split("", seen) }
    d = cdate[fs[i]]; ncm++
    if (!(fo[i] in seen)) { seen[fo[i]] = 1; nps++ }
    if (mind == "" || d < mind) mind = d
    if (d > maxd) maxd = d
    body = body sprintf("- %s %s by %s\n", d, cl(fs[i]), pl(fo[i]))
  }
  flush()
}
'

# the Commits section: F sorted by commit, path
WHO_COMMITS_AWK='
BEGIN {
  init_ord(); load()
  for (i = 1; i <= nf; i++) { if (!(fs[i] in cstart)) cstart[fs[i]] = i; cend[fs[i]] = i }
  print "* Commits"
  for (s = 1; s <= nseq; s++) {
    printf "** %s\n:PROPERTIES:\n:CUSTOM_ID: commit-%s\n:COMMIT: %s\n:AUTHOR_DATE: %s\n:END:\n", cshort[s], cshort[s], cfull[s], ciso[s]
    printf "Subject: %s\n\n", orgsafe(csubj[s])
    printf "- Author: %s\n- Date: %s\n", pl(cord[s]), cdate[s]
    if (s in cstart) for (i = cstart[s]; i <= cend[s]; i++) printf "- Path: %s\n", xl(fp[i])
    else print "- Path: none listed (a merge or an empty commit lists no path)"
  }
}
'

who_sentence_awk='BEGIN { FS = "\t" } { n++; if ($5 != "") { if (mn == "" || $5 < mn) mn = $5; if ($5 > mx) mx = $5 } } END { printf "%d\t%s\t%s\n", n, mn, mx }'

# REPO LABEL OUT [PATH...]  (WHO_SINCE, WHO_UNTIL) -> OUT
who_doc() {
  wd_repo=$1; wd_label=$2; wd_out=$3; shift 3
  command -v git >/dev/null 2>&1 || die "who: git is needed (and nothing else beyond sh and awk)"
  wd_err=$(git -C "$wd_repo" rev-parse --git-dir 2>&1 >/dev/null) || die "who: $wd_label is not a git repository that git can read (git says: $wd_err)"
  wd_ZW=$(printf '\342\200\213')
  case ${WHO_SINCE:-} in -*) die "who: --since needs a date, not $WHO_SINCE";; esac
  case ${WHO_UNTIL:-} in -*) die "who: --until needs a date, not $WHO_UNTIL";; esac
  # a bare YYYY-MM-DD would mean that day at the current time of day (git's rule); say the whole day instead
  case ${WHO_SINCE:-} in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) WHO_SINCE="$WHO_SINCE 00:00:00";; esac
  case ${WHO_UNTIL:-} in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) WHO_UNTIL="$WHO_UNTIL 23:59:59";; esac
  : > "$TMP/who.raw"
  if git -C "$wd_repo" rev-parse --verify -q HEAD >/dev/null 2>&1; then
    git -C "$wd_repo" -c core.quotepath=off -c log.showSignature=false -c log.mailmap=false -c color.ui=false \
      log --no-color --no-renames --name-only --date=short --format="$WHO_FMT" \
      ${WHO_SINCE:+"--since=$WHO_SINCE"} ${WHO_UNTIL:+"--until=$WHO_UNTIL"} -- "$@" > "$TMP/who.raw" \
      || die "who: git log failed in $wd_label"
    wd_head=$(git -C "$wd_repo" rev-parse --short HEAD 2>/dev/null)
  else
    wd_head=
  fi
  wd_shallow=$(git -C "$wd_repo" rev-parse --is-shallow-repository 2>/dev/null)
  $AWK -v cfile="$TMP/who.c" -v ffile="$TMP/who.f0" -v pfile="$TMP/who.p" "$WHO_PARSE_AWK" "$TMP/who.raw" || die "who: could not read the log"
  [ -f "$TMP/who.c" ] || { : > "$TMP/who.c"; : > "$TMP/who.f0"; : > "$TMP/who.p"; }
  sort -t "$TAB" -k1,1n -k2,2 -k3,3n "$TMP/who.f0" > "$TMP/who.fp"
  sort -t "$TAB" -k2,2 -k3,3n "$TMP/who.f0" > "$TMP/who.fx"
  sort -t "$TAB" -k3,3n -k2,2 "$TMP/who.f0" > "$TMP/who.fc"
  wd_cmd="git -C ${WHO_CMD_REPO:-$wd_label} -c core.quotepath=off -c log.showSignature=false -c log.mailmap=false -c color.ui=false log --no-color --no-renames --name-only --date=short --format=$WHO_FMT"
  [ -z "${WHO_SINCE:-}" ] || wd_cmd="$wd_cmd --since=$WHO_SINCE"
  [ -z "${WHO_UNTIL:-}" ] || wd_cmd="$wd_cmd --until=$WHO_UNTIL"
  wd_cmd="$wd_cmd --"
  for wd_a in "$@"; do wd_cmd="$wd_cmd $wd_a"; done
  IFS=$TAB read -r wd_nc wd_first wd_last <<EOS
$($AWK "$who_sentence_awk" "$TMP/who.c")
EOS
  wd_np=$(wc -l < "$TMP/who.p" | tr -d ' ')
  wd_nx=$(cut -f2 "$TMP/who.f0" | sort -u | wc -l | tr -d ' ')
  wd_shared=$($AWK -F'\t' '$3 != "" { c[$3]++ } END { for (e in c) if (c[e] > 1) { d++; m += c[e] } printf "%d\t%d", m, d }' "$TMP/who.p")
  wd_shm=${wd_shared%%"$TAB"*}; wd_shd=${wd_shared#*"$TAB"}
  wd_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  wd_range="every commit reachable from HEAD"
  [ -z "$wd_head" ] || wd_range="every commit reachable from HEAD (commit $wd_head)"
  [ -n "$wd_head" ] || wd_range="no commit at all (the repository has none yet)"
  [ -z "${WHO_SINCE:-}" ] || wd_range="$wd_range, since $WHO_SINCE"
  [ -z "${WHO_UNTIL:-}" ] || wd_range="$wd_range, until $WHO_UNTIL"
  [ "$#" -eq 0 ] || wd_range="$wd_range, limited to the paths given"
  {
    printf '#+TITLE: Who worked on this, over time\n\n'
    printf '* About this document\n:PROPERTIES:\n:READ_AT: %s\n:REPO: %s\n:COMMITS: %s\n:CONTRIBUTORS: %s\n:PATHS: %s\n:END:\n' "$wd_now" "$wd_label" "$wd_nc" "$wd_np" "$wd_nx"
    printf 'Observed: This document was written by orgfs who (orgfs %s) on %s from the git history of %s, with the command below. It made no network call and read nothing but the log.\n\n' "$VERSION" "$wd_now" "$($AWK -v ZW="$wd_ZW" "$WHO_COMMON_AWK"'BEGIN { print orgsafe(ARGV[1]) }' "$wd_label")"
    printf '#+BEGIN_EXAMPLE\n%s\n#+END_EXAMPLE\n\n' "$wd_cmd"
    printf 'Observed: The range is %s. It holds %s by %s, touching %s. The earliest author date among them is %s and the latest is %s.\n\n' \
      "$wd_range" "$(plur "$wd_nc" commit commits)" "$(plur "$wd_np" contributor contributors)" "$(plur "$wd_nx" path paths)" "${wd_first:-none}" "${wd_last:-none}"
    printf 'A contributor here is the author name and email exactly as a commit gives them. Nothing is merged, normalised or guessed: two spellings are two headings even where one person may be behind both, and a .mailmap file is not read.\n'
    if [ "${wd_shd:-0}" -gt 0 ]; then
      printf '\nObserved: %s share one email address with another heading (%s address%s in all). They stay separate headings.\n' "$(plur "$wd_shm" heading headings)" "$wd_shd" "$([ "$wd_shd" = 1 ] || printf es)"
    else
      printf '\nObserved: No two headings share an email address.\n'
    fi
    printf '\nDates are author dates in the time zone each author recorded. --since and --until select by git'"'"'s own rule, which is the commit date. Only authors are listed, not committers; a commit that lists no path (a merge or an empty one) has a contributor and a commit but no path.\n'
    [ "$wd_shallow" != true ] || printf '\nObserved: This is a shallow clone, so history before its cut-off is not here.\n'
    printf '\nJudged: Nothing. This tool counts and links; it does not say who matters, who is the same person or what a commit was for.\n\n'
    for wd_k in people:fp paths:fx commits:fc; do
      case ${wd_k%%:*} in people) wd_prog=$WHO_PEOPLE_AWK;; paths) wd_prog=$WHO_PATHS_AWK;; commits) wd_prog=$WHO_COMMITS_AWK;; esac
      $AWK -v ZW="$wd_ZW" -v cfile="$TMP/who.c" -v pfile="$TMP/who.p" -v ffile="$TMP/who.${wd_k#*:}" "$WHO_COMMON_AWK$wd_prog" < /dev/null
      printf '\n'
    done
  } > "$wd_out.tmp" || die "who: could not write the document"
  # no blank line at the very end
  $AWK '{ L[NR] = $0 } END { n = NR; while (n > 0 && L[n] == "") n--; for (i = 1; i <= n; i++) print L[i] }' "$wd_out.tmp" > "$wd_out"
  rm -f "$wd_out.tmp"
}

cmd_who() {
  _repo=${1:-}; [ -n "$_repo" ] || die "who: need REPO (a local git repository)"
  shift
  WHO_SINCE=$O_SINCE; WHO_UNTIL=$O_UNTIL
  _o=${O_OUT:-$TMP/who.org}
  who_doc "$_repo" "$_repo" "$_o" "$@"
  [ -n "$O_OUT" ] || cat "$_o"
}

# ------------------------------------------------------------------ stack
# orgfs stack DIR [--seed FILE]: the tools this build stands on, one atom each (DIR/tool-NAME.org) and a
# story (DIR/story.org) that sets them in order, so `orgfs compose DIR` makes the one file.
# Each atom quotes the exact command that gave the version and what it printed, the package and its
# source package and upstream version (dpkg-query, where there is one), the licences the package's own
# copyright file states, and where and when it was read.  What could not be read is a gap record (the
# form of the views) that says what is missing, why and what would fill it.  No network is used.
#
# A heading tag says where an atom's facts come from:
#   :SEEN_HERE:  every fact in it was read on this host, now
#   :CARRIED:    it came from the seed (a stack an earlier run made, perhaps elsewhere); only the version
#                command was run again here, and the atom says so in its own properties.
ST_TOOLS="sh awk make git python3 emacs org rsync nginx"
ST_NOTE_COMMITS='NOT CHECKED (needs the upstream tree; intake is a later slice)'

st_sane() { printf '%s' "$1" | tr '\t' ' ' | tr -d '\000-\010\013-\037' | head -n 1; }

# DISPLAY CMD...: run CMD with no input, quote it and the first lines of its output in $TMP/st.block
st_try() {
  _disp=$1; shift
  "$@" < /dev/null > "$TMP/st.out" 2>&1; _rc=$?
  { printf '$ %s\n' "$_disp"
    head -n 5 "$TMP/st.out" | sed -e 's/^\*/,*/' -e 's/^#+/,#+/'
    _nl=$(wc -l < "$TMP/st.out" | tr -d ' ')
    [ "$_nl" -le 5 ] || printf '[%s more lines not quoted]\n' "$((_nl - 5))"
    [ "$_rc" = 0 ] || printf '[exit status %s]\n' "$_rc"
  } >> "$TMP/st.block"
  if [ -z "$ST_VERSION" ]; then
    ST_VERSION=$(head -n 5 "$TMP/st.out" | $AWK '/[0-9]+\.[0-9]+/ || /[Vv]ersion [0-9]+/ { print; exit }')
    ST_VERSION=$(st_sane "$ST_VERSION")
  fi
}

# NAME -> the first executable file of that name on PATH (busybox ash's command -v prints a bare applet name)
st_which() {
  case $1 in */*|'') return 0;; esac
  _w_old=$IFS; IFS=:
  for _w_d in $PATH; do
    [ -n "$_w_d" ] || _w_d=.
    case $_w_d in /*) [ -f "$_w_d/$1" ] && [ -x "$_w_d/$1" ] && { IFS=$_w_old; printf '%s\n' "$_w_d/$1"; return 0; };; esac
  done
  IFS=$_w_old
  return 0
}

# TOOL -> ST_PATH ST_REAL ST_VERSION and the quoted commands in $TMP/st.block
st_cheap() {
  ST_PATH=; ST_REAL=; ST_VERSION=; : > "$TMP/st.block"
  case $1 in
    sh) ST_PATH=$(command -v sh 2>/dev/null);;
    awk) ST_PATH=$(command -v "$AWK" 2>/dev/null);;
    org) ST_PATH=$(command -v emacs 2>/dev/null);;
    *) ST_PATH=$(command -v "$1" 2>/dev/null);;
  esac
  case $ST_PATH in /*) :;; *) ST_PATH=$(st_which "${ST_PATH:-$1}");; esac
  [ -n "$ST_PATH" ] || return 1
  ST_REAL=$(readlink -f "$ST_PATH" 2>/dev/null) || ST_REAL=
  [ -n "$ST_REAL" ] || ST_REAL=$ST_PATH
  case $1 in
    sh)
      case ${ST_REAL##*/} in
        busybox) st_try "$ST_REAL" "$ST_REAL";;
        *) st_try "$ST_REAL --version" "$ST_REAL" --version;;
      esac;;
    awk)
      case ${ST_REAL##*/} in
        busybox) st_try "$ST_REAL" "$ST_REAL";;
        *) st_try "$ST_REAL --version" "$ST_REAL" --version
           [ -n "$ST_VERSION" ] || st_try "$ST_REAL -W version" "$ST_REAL" -W version;;
      esac;;
    git) st_try "git --version" git --version;;
    python3) st_try "python3 --version" python3 --version;;
    emacs) st_try "emacs --version" emacs --version;;
    org)
      st_try "emacs -Q --batch --eval '(progn (require (quote org)) (princ (concat (org-release) \"\\n\" (locate-library \"org\") \"\\n\")))'" \
        emacs -Q --batch --eval '(progn (require (quote org)) (princ (concat (org-release) "\n" (locate-library "org") "\n")))'
      _ol=$(sed -n 2p "$TMP/st.out")
      [ -z "$_ol" ] || ST_REAL=$_ol;;
    nginx) st_try "nginx -v" nginx -v;;
    *) st_try "$1 --version" "$1" --version;;
  esac
  return 0
}

st_gap() { # TOOL FIELD KIND SHAPE HOW WHY REACH ROUTE
  gap_open '**' "stack-$1-$2" "$3" "$4" \
    "orgfs stack writes a gap record for every fact it could not read, and reads nothing from the network" \
    "bin/orgfs, cmd_stack (orgfs $VERSION); README.org, The tools we stand on" "$5" "$6" "$7"
  gap_route "$8"
  gap_close
  ST_NGAPS=$((ST_NGAPS + 1))
}

# TOOL -> ST_PKG ST_PKGVER ST_SRC ST_UPSTREAM ST_UPCOMMIT ST_HOME ST_PKGARCH and $TMP/st.pkgblock
st_package() {
  ST_PKG=; ST_PKGVER=; ST_SRC=; ST_UPSTREAM=; ST_UPCOMMIT=; ST_HOME=; ST_PKGARCH=; : > "$TMP/st.pkgblock"
  command -v dpkg-query >/dev/null 2>&1 || return 1
  _cands="$ST_REAL $ST_PATH"
  case $ST_REAL in /usr/*) _cands="$_cands ${ST_REAL#/usr}";; /bin/*|/sbin/*|/lib/*|/lib64/*) _cands="$_cands /usr$ST_REAL";; esac
  ST_PKG=
  for _c in $_cands; do
    if dpkg-query -S "$_c" > "$TMP/st.out" 2>&1; then
      { printf '$ dpkg-query -S %s\n' "$_c"; head -n 3 "$TMP/st.out"; } >> "$TMP/st.pkgblock"
      ST_PKG=$(head -n 1 "$TMP/st.out" | sed -e 's/: .*//' -e 's/, .*//')
      break
    fi
    { printf '$ dpkg-query -S %s\n' "$_c"; head -n 2 "$TMP/st.out"; } >> "$TMP/st.pkgblock"
  done
  [ -n "$ST_PKG" ] || return 1
  _f='${Package}|${Version}|${Source}|${Architecture}|${Homepage}'
  if dpkg-query -W -f "$_f\\n" "$ST_PKG" > "$TMP/st.out" 2>&1; then
    { printf '$ dpkg-query -W -f '"'"'%s\\n'"'"' %s\n' "$_f" "$ST_PKG"; head -n 2 "$TMP/st.out"; } >> "$TMP/st.pkgblock"
    ST_PKGVER=$($AWK -F'|' 'NR == 1 { print $2 }' "$TMP/st.out")
    ST_SRC=$($AWK -F'|' 'NR == 1 { s = $3; sub(/ .*/, "", s); print s }' "$TMP/st.out")
    ST_PKGARCH=$($AWK -F'|' 'NR == 1 { print $4 }' "$TMP/st.out")
    ST_HOME=$($AWK -F'|' 'NR == 1 { print $5 }' "$TMP/st.out")
  else
    return 1
  fi
  [ -n "$ST_SRC" ] || ST_SRC=${ST_PKG%%:*}
  ST_UPSTREAM=$(printf '%s\n' "$ST_PKGVER" | sed -e 's/^[0-9][0-9]*://' -e 's/-[^-]*$//')
  ST_UPCOMMIT=$(printf '%s\n' "$ST_UPSTREAM" | sed -n 's/.*[+~]git[0-9]\{8\}[+~.]\([0-9a-f]\{7,40\}\).*/\1/p')
  return 0
}

# the distinct License: lines of the package's copyright file, in file order -> $TMP/st.lic
st_licences() { # PKG
  _cf=${ORGFS_DOC:-/usr/share/doc}/${1%%:*}/copyright
  ST_COPYRIGHT=$_cf
  [ -r "$_cf" ] || return 1
  $AWK '/^License:/ { sub(/^License:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); if ($0 != "" && !seen[$0]++) print }' "$_cf" > "$TMP/st.lic"
  [ -s "$TMP/st.lic" ]
}

# NAMES... -> the first row of the register whose first word is one of them: ST_REGLINE ST_REGNAME ST_REGLIC
st_register() {
  ST_REGLINE=; ST_REGNAME=; ST_REGLIC=
  [ -f "$SHARE/licensing.tsv" ] || return 1
  _r=$($AWK -F'\t' -v names="$*" 'NR > 1 { n = $1; sub(/[ (].*$/, "", n); n = tolower(n)
      m = split(tolower(names), w, " "); for (i = 1; i <= m; i++) if (w[i] != "" && w[i] == n) { printf "%d\t%s\t%s\n", NR, $1, $2; exit } }' "$SHARE/licensing.tsv")
  [ -n "$_r" ] || return 1
  ST_REGLINE=$(printf '%s\n' "$_r" | cut -f1); ST_REGNAME=$(printf '%s\n' "$_r" | cut -f2); ST_REGLIC=$(printf '%s\n' "$_r" | cut -f3)
}

# TOOL -> the whole atom in $TMP/st.atom: every fact read on this host, now
st_full() {
  _t=$1; ST_NGAPS=0; ST_COPYRIGHT=; : > "$TMP/st.lic"; ST_REGLINE=
  _tag=SEEN_HERE
  : > "$TMP/st.gaps"
  st_cheap "$_t" || true
  _body=$TMP/st.body; : > "$_body"
  if [ -z "$ST_PATH" ]; then
    {
      if [ "$_t" = org ]; then _need=emacs; else _need=$_t; fi
      printf 'Observed on %s at %s: %s was not found on PATH (command -v printed no path)%s.\n' "$ST_HOST" "$ST_NOW" "$_need" "$([ "$_t" = org ] && printf ', and Org is read by running it')"
    } >> "$_body"
    ST_PKG=; ST_REGLINE=
    st_gap "$_t" absent tool "$_t, its version, package and licence" "not read" "$_need is not on PATH on this host" "anyone on a host that has $_need" "install $_need here, or run orgfs stack on a host that has it, then run orgfs stack DIR again" >> "$TMP/st.gaps"
  else
    st_package "$_t" || true
    {
      printf 'Observed on %s at %s: %s is at %s' "$ST_HOST" "$ST_NOW" "$_t" "$ST_PATH"
      [ "$ST_REAL" = "$ST_PATH" ] || printf ', which resolves to %s' "$ST_REAL"
      printf '. The commands below were run and printed what is quoted.\n\n'
      printf '#+BEGIN_EXAMPLE\n'; cat "$TMP/st.block"; printf '#+END_EXAMPLE\n'
    } >> "$_body"
    if [ -z "$ST_VERSION" ]; then
      st_gap "$_t" version version "the version as the tool reports it" "the commands above printed no line that looks like a version" "$_t does not report a version this way" "anyone who can read the package metadata or the source" "read the package version below if there is one, or run $_t with the flag its manual names" >> "$TMP/st.gaps"
    fi
    if [ -n "$ST_PKG" ]; then
      {
        printf '\nObserved: Debian names the owner of that file as package %s, version %s, built from source package %s; the upstream version derived from it (epoch and the last hyphen-part dropped) is %s.\n\n' "$ST_PKG" "$ST_PKGVER" "$ST_SRC" "$ST_UPSTREAM"
        printf '#+BEGIN_EXAMPLE\n'; cat "$TMP/st.pkgblock"; printf '#+END_EXAMPLE\n'
      } >> "$_body"
      if st_licences "$ST_PKG"; then
        {
          printf '\nObserved: the distinct License: lines of %s, in file order, are quoted here. They are what the file says; this tool does not say whether they are right or how they combine.\n\n' "$ST_COPYRIGHT"
          printf '#+BEGIN_EXAMPLE\n'; sed -e 's/^/License: /' -e 's/^\*/,*/' "$TMP/st.lic"; printf '#+END_EXAMPLE\n'
        } >> "$_body"
      else
        st_gap "$_t" licence licence "the licence the package states" "not read" "$ST_COPYRIGHT is missing or has no License: line (a free-form copyright file)" "anyone with the package's copyright file" "read $ST_COPYRIGHT by eye, or the licence file the upstream source ships" >> "$TMP/st.gaps"
      fi
      if [ -n "$ST_UPCOMMIT" ]; then
        printf '\nObserved: the package version names an upstream commit, %s.\n' "$ST_UPCOMMIT" >> "$_body"
      fi
    else
      if command -v dpkg-query >/dev/null 2>&1; then _why="dpkg-query -S found no package that owns $ST_REAL (see the quoted tries, or the file is not from a package)"
      else _why="there is no dpkg-query on this host, so no package, source package or copyright file was read"; fi
      st_gap "$_t" package package "package, source package, upstream version and licence" "not read" "$_why" "anyone on a Debian or Ubuntu host with the same file" "run orgfs stack on a host where dpkg-query -S $ST_REAL names a package" >> "$TMP/st.gaps"
    fi
    if [ -n "$ST_PKG" ]; then
      st_gap "$_t" vcs vcs-url "the Vcs-Git URL and the upstream tag of the source package" "not read: dpkg-query -W -f offers only the fields in the status database, and Vcs-Git is not one" "the source package's own metadata is not on this box and no network is used" "anyone with the source package index or the upstream project" "apt-cache showsrc $ST_SRC (the Vcs- lines), after apt-get update where the source indices are missing" >> "$TMP/st.gaps"
    fi
    st_gap "$_t" commits commits "the commits that make this version distinct" "$ST_NOTE_COMMITS" "that needs the upstream tree, which this slice does not fetch" "anyone who can clone the upstream tree" "a later intake slice: clone the upstream tree at the version's tag and run orgfs who on it" >> "$TMP/st.gaps"
    if st_register "$_t" "${ST_PKG%%:*}" "$ST_SRC"; then
      printf '\nObserved: share/licensing.tsv, the register the licensing page is made from, has a row for %s (line %s) that reads: %s. It is a different source from the copyright file above, and this tool does not say whether the two agree.\n' "$ST_REGNAME" "$ST_REGLINE" "$ST_REGLIC" >> "$_body"
    else
      printf '\nObserved: share/licensing.tsv, the register the licensing page is made from, has no row whose first word is %s.\n' "$_t${ST_PKG:+ or ${ST_PKG%%:*}}" >> "$_body"
    fi
  fi
  printf '\nJudged: nothing here. The facts above are copied from the commands and files named, and the gaps say what was not read.\n' >> "$_body"
  {
    printf '* %s :%s:\n:PROPERTIES:\n:ORGFS_ATOM: tool-%s.org\n:ROLE: stack-tool\n:TOOL: %s\n:READ_AT: %s\n:READ_ON: %s\n:READ_ENV: %s\n' "$_t" "$_tag" "$_t" "$_t" "$ST_NOW" "$ST_HOST" "$ST_ENV"
    printf ':PRESENT: %s\n' "$([ -n "$ST_PATH" ] && echo yes || echo no)"
    [ -z "$ST_PATH" ] || printf ':COMMAND_PATH: %s\n:RESOLVED_PATH: %s\n' "$(st_sane "$ST_PATH")" "$(st_sane "$ST_REAL")"
    [ -z "$ST_VERSION" ] || printf ':VERSION: %s\n' "$ST_VERSION"
    [ ! -s "$TMP/st.block" ] || printf ':VERSION_TEXT_SHA256: %s\n' "$(sha_file "$TMP/st.block")"
    if [ -n "$ST_PKG" ]; then
      printf ':PACKAGE: %s\n:PACKAGE_VERSION: %s\n:SOURCE_PACKAGE: %s\n:UPSTREAM_VERSION: %s\n' "$ST_PKG" "$(st_sane "$ST_PKGVER")" "$ST_SRC" "$(st_sane "$ST_UPSTREAM")"
      [ -z "$ST_UPCOMMIT" ] || printf ':UPSTREAM_COMMIT: %s\n' "$ST_UPCOMMIT"
      [ -z "$ST_HOME" ] || printf ':HOMEPAGE: %s\n' "$(st_sane "$ST_HOME")"
      [ ! -r "$ST_COPYRIGHT" ] || printf ':COPYRIGHT_PATH: %s\n' "$ST_COPYRIGHT"
      if [ -s "$TMP/st.lic" ] && [ -r "$ST_COPYRIGHT" ]; then
        printf ':LICENSES: %s\n' "$(st_sane "$(tr '\n' ';' < "$TMP/st.lic" | sed -e 's/;$//' -e 's/;/; /g')")"
      fi
    fi
    [ -z "$ST_REGLINE" ] || printf ':REGISTER_ROW: %s (line %s of share/licensing.tsv)\n' "$(st_sane "$ST_REGNAME")" "$ST_REGLINE"
    [ -z "${ST_SEED_SAID:-}" ] || printf ':SEED_SAID_VERSION: %s\n' "$ST_SEED_SAID"
    printf ':END:\n'
    cat "$_body"
    [ ! -s "$TMP/st.gaps" ] || { printf '\n'; cat "$TMP/st.gaps"; }
  } | $AWK '{ L[NR] = $0 } END { n = NR; while (n > 0 && L[n] == "") n--; for (i = 1; i <= n; i++) print L[i] }' > "$TMP/st.atom"
}

# SEEDATOM NOW REREADTEXT -> $TMP/st.atom: the seed atom, kept as it was, marked CARRIED, with what was run again here
st_carry() {
  $AWK -v now="$ST_NOW" -v from="$ST_SEEDNAME" -v reread="$1" -v gone="$2" '
    function strip(s) { sub(/[ \t]+:[A-Za-z0-9_@:]+:[ \t]*$/, "", s); return s }
    NR == 1 { print strip($0) " :CARRIED:"; next }
    !done && /^:(CARRIED_FROM|CARRIED_AT|REREAD_HERE|REREAD_AT|ABSENT_HERE|NOT_REREAD_HERE):/ { next }
    !done && /^:END:/ {
      printf ":CARRIED_FROM: %s\n:CARRIED_AT: %s\n", from, now
      if (gone == "") printf ":REREAD_HERE: %s\n:REREAD_AT: %s\n", reread, now
      else if (gone == "unknown") printf ":NOT_REREAD_HERE: this version of orgfs has no way to read this tool\n"
      else printf ":ABSENT_HERE: yes\n"
      done = 1 }
    { print }' "$TMP/st.seedatom" > "$TMP/st.atom"
}

cmd_stack() {
  case ${1:-} in
    correct) shift; st_correct "$@"; return;;
    approve) shift; st_approve "$@"; return;;
  esac
  _dir=${1:-}; [ -n "$_dir" ] || die "stack: need DIR (where the atoms are written)"
  ST_NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  ST_HOST=$(st_sane "$(uname -n 2>/dev/null)")
  ST_ENV=$(st_sane "$(uname -sr 2>/dev/null)")
  _osr=${ORGFS_OS_RELEASE:-/etc/os-release}   # overridable so tests describe a host of their own, not the machine running them
  if [ -r "$_osr" ]; then _pn=$(sed -n 's/^PRETTY_NAME=//p' "$_osr" | head -n 1 | tr -d '"'); [ -z "$_pn" ] || ST_ENV="$ST_ENV; $_pn"; fi
  ST_SEEDNAME=
  mkdir -p "$TMP/seed" || die "stack: no temp space"
  if [ -n "$O_SEED" ]; then
    if [ -d "$O_SEED" ]; then
      compose_dir "$O_SEED" "$TMP/seedfile" m || die "stack: cannot compose the seed atoms in $O_SEED"
      _sf=$TMP/seedfile
    elif [ -f "$O_SEED" ]; then
      _sf=$O_SEED
    else
      die "stack: cannot read the seed: $O_SEED"
    fi
    check_fresh "$_sf" "$O_SEED" 1 || die "stack: the seed $O_SEED is STALE: its atoms no longer match its manifest, so nothing in it is carried"
    scan_stage "$_sf" "$TMP/seed" || die "stack: the seed $O_SEED is not a composed stack"
    ST_SEEDNAME=$(basename "$O_SEED")
  fi
  # everything is read before DIR is touched: DIR may be the seed's own directory
  mkdir -p "$TMP/new"; rm -f "$TMP/new"/*
  _list=; _nseen=0; _ncar=0; _ngap=0; _absent=
  for _t in $ST_TOOLS; do
    _seeded=0; [ -f "$TMP/seed/tool-$_t.org" ] && _seeded=1
    ST_SEED_SAID=
    if [ "$_seeded" = 1 ]; then
      cp "$TMP/seed/tool-$_t.org" "$TMP/st.seedatom"
      _want=$($AWK '/^:VERSION_TEXT_SHA256:/ { sub(/^:[A-Z0-9_]+:[ \t]*/, ""); print; exit }' "$TMP/st.seedatom")
      ST_SEED_SAID=$($AWK '/^:VERSION:/ { sub(/^:[A-Z0-9_]+:[ \t]*/, ""); print; exit }' "$TMP/st.seedatom")
      if st_cheap "$_t"; then
        _got=; [ ! -s "$TMP/st.block" ] || _got=$(sha_file "$TMP/st.block")
        if [ -n "$_want" ] && [ "$_want" = "$_got" ]; then
          st_carry "the version command (its quoted text hashes to the seed's)" ""
          cp "$TMP/st.atom" "$TMP/new/tool-$_t.org"; _list="$_list $_t"; _ncar=$((_ncar + 1)); continue
        fi
      else
        st_carry "" gone
        ST_NGAPS=0
        {
          printf '\n'
          st_gap "$_t" reread version "re-reading the version here" "not read: $_t is not on PATH on this host, so the atom above is the seed's and nothing more" "the tool is absent here" "anyone on a host that has $_t" "install $_t here and run orgfs stack DIR --seed SEED again" 
        } > "$TMP/st.g1"
        ST_NGAPS=0
        cat "$TMP/st.g1" >> "$TMP/st.atom"
        $AWK '{ L[NR] = $0 } END { n = NR; while (n > 0 && L[n] == "") n--; for (i = 1; i <= n; i++) print L[i] }' "$TMP/st.atom" > "$TMP/st.atom2"; mv "$TMP/st.atom2" "$TMP/st.atom"
        cp "$TMP/st.atom" "$TMP/new/tool-$_t.org"; _list="$_list $_t"; _ncar=$((_ncar + 1)); continue
      fi
    fi
    # not seeded, or the tool here is not the one the seed described: read it all, here
    if [ "$_t" = nginx ] && ! command -v nginx >/dev/null 2>&1; then _absent="$_absent $_t"; continue; fi
    st_full "$_t"
    cp "$TMP/st.atom" "$TMP/new/tool-$_t.org"; _list="$_list $_t"; _nseen=$((_nseen + 1))
  done
  # atoms in the seed that this version of orgfs does not know are carried as they are
  for _f in "$TMP/seed"/tool-*.org; do
    [ -f "$_f" ] || continue
    _b=${_f##*/}; _n=${_b#tool-}; _n=${_n%.org}
    case " $ST_TOOLS " in *" $_n "*) continue;; esac
    cp "$_f" "$TMP/st.seedatom"; st_carry "" unknown
    cp "$TMP/st.atom" "$TMP/new/$_b"; _list="$_list $_n"; _ncar=$((_ncar + 1))
  done
  # the story
  {
    printf '#+TITLE: The tools orgfs stands on\n\n'
    printf 'Observed: orgfs stack (orgfs %s) wrote this on %s on the host %s (%s). It reads the tools by running them and the files Debian keeps about them; it makes no network call.\n\n' "$VERSION" "$ST_NOW" "$ST_HOST" "$ST_ENV"
    if [ -n "$ST_SEEDNAME" ]; then
      printf 'It started from the seed %s. An atom tagged CARRIED came from that seed: only its version command was run again here, and the atom says so in its own properties. An atom tagged SEEN_HERE was read here, all of it.\n\n' "$ST_SEEDNAME"
    else
      printf 'There was no seed, so every atom below was read here and is tagged SEEN_HERE. An atom tagged CARRIED would have come from a seed instead.\n\n'
    fi
    [ -z "$_absent" ] || printf 'Observed: not found on PATH, so without an atom:%s.\n\n' "$_absent"
    for _t in $_list; do printf '#+INCLUDE: "tool-%s.org"\n\n' "$_t"; done
    printf '* How to read one of these\nEach tool is one atom: a heading, a drawer of properties for programs, and prose with the quoted commands for people. What could not be read is a gap record, in the same form as the gaps in a view of a spoke, with the command that would fill it.\n'
  } > "$TMP/new/story.org"
  # DIR now: the old atoms of this kind go, the new come
  mkdir -p "$_dir" || die "stack: cannot create $_dir"
  rm -f "$_dir"/tool-*.org "$_dir/story.org"
  cp "$TMP/new"/*.org "$_dir/" || die "stack: cannot write into $_dir"
  # the licence guess of every package whose copyright file was read here (append-only records beside the atoms)
  mkdir -p "$TMP/sc" || die "stack: no temp space"
  sc_all "$_dir"
  # the result must be a declaration of atoms orgfs itself accepts, and its gaps whole
  compose_dir "$_dir" "$TMP/stackcheck" m || die "stack: what was written in $_dir is not a set of atoms orgfs accepts (this is a bug in orgfs stack)"
  $AWK -v mode=list "$GAPS_AWK" "$TMP/stackcheck" > "$TMP/stackgaps" || die "stack: a gap record is incomplete (this is a bug in orgfs stack)"
  _ngap=$($AWK '/^\*+ gap /{ n++ } END { print n + 0 }' "$TMP/stackcheck")
  printf 'stack: wrote %s: %s atoms (%s SEEN_HERE, %s CARRIED), %s gap records\n' "$_dir" "$((_nseen + _ncar))" "$_nseen" "$_ncar" "$_ngap"
}

# ------------------------------------------------------------------ licence confidence
# `orgfs stack` also scores how well the words of a package's copyright file match licence texts the host
# already holds in a machine-readable form (the reference set).  README.org, "Licence confidence", says it
# in full; the short version:
#   reference set  /usr/share/common-licenses/* (each by file name) and the License: paragraphs of DEP-5
#                  copyright files on this host that carry a standard short name and a text of their own
#   the measure    shingle-containment, version 1: normalise to words (lower case, everything but a-z0-9
#                  is a separator), cut into runs of 4 words (shingles), and count which words of the
#                  stanza lie inside a run that the reference also holds.  The score is that share.
#   the bands      a gap of at most 4, 9 or 17 per cent of the words is high, moderate or low confidence;
#                  beyond that it stays a gap and is named by kind.  4, 9 and 17 are the house numbers,
#                  invented, not measured.
#   a guess        is an append-only atom, DIR/guesses/PACKAGE/STAMP-METHOD.org, linked to the one before
#                  and after it.  No network call and no model call is made anywhere in this part.
SC_METHOD=shingle4-containment
SC_VERSION=1
SC_K=4
SC_MINW=12
SC_B1=4
SC_B2=9
SC_B3=17

# the one rule for turning text into words, shared by every awk program of this part
NORM_AWK='
function nwords(s, W,   t) {
  t = tolower(s); gsub(/\047/, "", t); gsub(/[^a-z0-9]+/, " ", t)
  sub(/^ /, "", t); sub(/ $/, "", t)
  if (t == "") return 0
  return split(t, W, " ")
}
function stripcr(s) { sub(/\r$/, "", s); return s }
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function tsv(s) { gsub(/[\t\r\n]/, " ", s); return s }
'

# DEP-5 reading, shared by the stanza cutter and the reference builder.  L[1..n] holds the lines.
DEP5_AWK='
function is_dep5(n,   i) {
  for (i = 1; i <= n && i <= 5; i++) if (L[i] ~ /^[Ff]ormat:.*[Cc]opyright-?[Ff]ormat/) return 1
  return 0
}
function load_std(f,   l) {
  while ((getline l < f) > 0) { sub(/#.*/, "", l); gsub(/[ \t]/, "", l); if (l != "") STD[tolower(l)] = l }
  close(f)
}
function canon_comp(c,   t, plus) {
  t = trim(c); plus = ""
  if (t ~ /\+$/) { plus = "+"; sub(/\+$/, "", t) }
  if (tolower(t) in STD) return STD[tolower(t)] plus
  return ""
}
function all_std(name,   t, m, a, i) {
  t = name; gsub(/,/, " | ", t); gsub(/ [Aa][Nn][Dd] /, " | ", t); gsub(/ [Oo][Rr] /, " | ", t)
  m = split(t, a, "|")
  for (i = 1; i <= m; i++) if (canon_comp(a[i]) == "") return 0
  return m > 0
}
# D_start D_end D_has D_name D_files D_body for the paragraphs 1..nd
function dep5_scan(n,   i, s, curf, v, t, inpara) {
  nd = 0; inpara = 0; curf = ""
  for (i = 1; i <= n + 1; i++) {
    s = (i <= n) ? L[i] : ""
    if (s ~ /^#/) continue
    if (s ~ /^[ \t]*$/) { if (inpara) { D_end[nd] = i - 1; inpara = 0 } curf = ""; continue }
    if (!inpara) { nd++; inpara = 1; D_start[nd] = i; D_name[nd] = ""; D_body[nd] = ""; D_has[nd] = 0; D_files[nd] = "" }
    if (s ~ /^[A-Za-z][A-Za-z0-9-]*:/) {
      curf = tolower(substr(s, 1, index(s, ":") - 1)); v = trim(substr(s, index(s, ":") + 1))
      if (curf == "license") { D_has[nd] = 1; D_name[nd] = v }
      else if (curf == "files") D_files[nd] = v
    } else if (s ~ /^[ \t]/) {
      t = substr(s, 2)
      if (t ~ /^[ \t]*\.[ \t]*$/) t = ""
      if (curf == "license") D_body[nd] = D_body[nd] t "\n"
      else if (curf == "files") D_files[nd] = D_files[nd] " " trim(t)
    }
  }
}
'

# STZ_AWK: cut one copyright file into stanzas.  -v std=FILE (the standard short names) -v outdir=DIR -v idx=FILE
# -v minw=N.  Writes DIR/stz_N.w (one normalised word per line) and, to idx, tab-separated records:
#   X key value                   a fact about the whole file (format, how many standard stanzas, ...)
#   S n kind name l1 l2 words holders cites vocab   a stanza to score
#   G n kind name l1 l2 why       a gap with nothing to score (a non-standard name with no text of its own)
STZ_AWK='
function clean(text,   m, a, i, t, out) {
  holders = 0; out = ""
  m = split(text, a, "\n")
  for (i = 1; i <= m; i++) {
    t = tolower(a[i]); sub(/^[ \t#*;\/>|-]+/, "", t)
    if (t ~ /^(copyright|\(c\))/) { holders++; continue }
    out = out a[i] "\n"
  }
  return out
}
function vocab(W, n,   i) {
  for (i = 1; i <= n; i++) if (W[i] ~ /^(licen|warrant|redistribut|permiss|copying|copyleft|gpl|lgpl)/) return 1
  return 0
}
function cites_of(text,   t, r) {
  if (!match(text, /\/usr\/share\/common-licenses\/[A-Za-z0-9._+-]+/)) return ""
  t = substr(text, RSTART, RLENGTH); sub(/^.*\//, "", t); sub(/[.]+$/, "", t)
  return t
}
function emit(kind, name, l1, l2, raw,   txt, n, W, i, v, c) {
  txt = clean(raw); n = nwords(txt, W)
  v = vocab(W, n); c = cites_of(raw)
  if (kind == "free" && (n < 3 || (n < minw && !v))) { nshort++; return }
  ns++
  f = outdir "/stz_" ns ".w"
  printf "" > f
  for (i = 1; i <= n; i++) print W[i] > f
  close(f)
  printf "S\t%d\t%s\t%s\t%d\t%d\t%d\t%d\t%s\t%d\n", ns, kind, tsv(name), l1, l2, n, holders, c, v > idx
}
function blankish(s) { return s ~ /^[ \t#*=_~-]*$/ }
{ L[NR] = stripcr($0) }
END {
  n = NR; ns = 0; nshort = 0; nstd = 0; stdlist = ""
  load_std(std)
  if (is_dep5(n)) {
    printf "X\tformat\tdep5\n" > idx
    dep5_scan(n)
    for (p = 1; p <= nd; p++) {
      if (!D_has[p]) continue
      nm = D_name[p]
      if (all_std(nm)) { nstd++; if (!(nm in seenstd)) { seenstd[nm] = 1; stdlist = stdlist (stdlist == "" ? "" : "; ") nm } continue }
      body = clean(D_body[p]); k = nwords(body, W)
      if (k > 0) { hasbody[nm] = 1; emit("dep5", nm, D_start[p], D_end[p], D_body[p]) }
      else if (!(nm in firstl)) { firstl[nm] = D_start[p]; order[++no] = nm }
    }
    for (q = 1; q <= no; q++) if (!(order[q] in hasbody))
      printf "G\t0\tdep5\t%s\t%d\t%d\tname-without-text\n", tsv(order[q]), firstl[order[q]], firstl[order[q]] > idx
    printf "X\tstandard_stanzas\t%d\nX\tstandard_names\t%s\n", nstd, tsv(stdlist) > idx
  } else {
    printf "X\tformat\tfree-text\n" > idx
    i = 1
    while (i <= n) {
      while (i <= n && blankish(L[i])) i++
      if (i > n) break
      s = i; raw = ""
      while (i <= n && !blankish(L[i])) { raw = raw L[i] "\n"; i++ }
      emit("free", "", s, i - 1, raw)
    }
    printf "X\tshort_blocks\t%d\n", nshort > idx
  }
  printf "X\tstanzas_to_score\t%d\n", ns > idx
  close(idx)
}
'

# REFDEP_AWK: the DEP-5 License: paragraphs on this host that can serve as reference texts.  Input: a list of
# copyright paths (-v list=FILE); prints  name TAB packages TAB onlypkg TAB firstpath TAB text(words joined by space).
# One text per standard name: the one held by the most packages (ties: the smaller text).
REFDEP_AWK='
function readfile(f,   l, n) { n = 0; while ((getline l < f) > 0) L[++n] = stripcr(l); close(f); return n }
BEGIN {
  load_std(std)
  while ((getline path < list) > 0) {
    n = readfile(path)
    if (!is_dep5(n)) { split("", L); continue }
    pkg = path; sub(/\/copyright$/, "", pkg); sub(/^.*\//, "", pkg)
    dep5_scan(n)
    for (p = 1; p <= nd; p++) {
      if (!D_has[p]) continue
      nm = D_name[p]
      if (nm ~ /( [Aa][Nn][Dd] | [Oo][Rr] |,)/) continue
      cn = canon_comp(nm)
      if (cn == "") continue
      if (D_body[p] ~ /\/usr\/share\/common-licenses/) continue
      k = nwords(D_body[p], W)
      if (k < 20) continue
      t = W[1]; for (i = 2; i <= k; i++) t = t " " W[i]
      key = cn SUBSEP t
      if (!(key in lastpkg) || lastpkg[key] != pkg) { pk[key]++; lastpkg[key] = pkg; if (pk[key] == 1) { only[key] = pkg; first[key] = path } else only[key] = "" }
      names[cn] = 1
    }
    split("", L)
  }
  for (key in pk) {
    split(key, kk, SUBSEP); cn = kk[1]; t = kk[2]
    if (!(cn in best) || pk[key] > bestn[cn] || (pk[key] == bestn[cn] && t < bestt[cn])) { best[cn] = key; bestn[cn] = pk[key]; bestt[cn] = t }
  }
  for (cn in best) printf "%s\t%d\t%s\t%s\t%s\n", cn, bestn[cn], only[best[cn]], first[best[cn]], bestt[cn]
}
'

# SC_AWK: score the stanzas of idx against the references.  -v refs=FILE (refno TAB name TAB wordsfile TAB onlypkg TAB
# sha TAB path TAB namefrom) -v idx=FILE -v dir=STANZADIR -v pkg=PACKAGE -v cfile=PATH -v k= -v minw= -v b1= -v b2= -v b3=
# Writes the Org text of the stanzas to stdout and, to -v sumf=FILE, "key TAB value" lines.
SC_AWK='
function pm(c, n) { return int(c * 1000 / n) }
function pct(c, n,   v) { v = pm(c, n); return sprintf("%d.%d%%", int(v / 10), v % 10) }
# the band of a stanza whose n words leave unc uncovered: integers only, so a boundary is exact
function band(unc, n) {
  if (unc * 100 <= b1 * n) return "high"
  if (unc * 100 <= b2 * n) return "moderate"
  if (unc * 100 <= b3 * n) return "low"
  return "gap"
}
function bandwords(b) {
  if (b == "high") return "high confidence (at most " b1 " per cent of the words are outside the match)"
  if (b == "moderate") return "moderate confidence (more than " b1 " and at most " b2 " per cent of the words are outside the match)"
  if (b == "low") return "low confidence (more than " b2 " and at most " b3 " per cent of the words are outside the match)"
  return "no confidence: a gap (more than " b3 " per cent of the words are outside any match)"
}
function lc(s) { s = tolower(s); sub(/\+$/, "", s); return s }
function score(s, n, kind, name, l1, l2, holders, cites, vocabflag,   m, j, t, key, ne, E, e, rp, r, i, p, bestg, bestr, g, ncomp, comp, anyn, cov, cw, any, seen, prev, cur, run, bestrun, covered, tot, unc, b, gapk, top, used, ti, bc, c, gl, runs, st, en, words, nruns, line, w, ex, first) {
  m = n - k + 1
  split("", cov); split("", cw); split("", any); split("", seen); split("", prev); split("", bestrun)
  for (j = 1; j <= m; j++) {
    key = wv[j]; for (t = 1; t < k; t++) key = key " " wv[j + t]
    split("", cur)
    if (key in idx) {
      ne = split(idx[key], E, " ")
      for (e = 1; e <= ne; e++) {
        split(E[e], rp, ":"); r = rp[1] + 0; i = rp[2] + 0
        if (!((r, j) in seen)) { seen[r, j] = 1; for (t = 0; t < k; t++) if (!((r, j + t) in cw)) { cw[r, j + t] = 1; cov[r]++ } }
        run = (((r ":" (i - 1)) in prev) ? prev[r ":" (i - 1)] : 0) + 1
        cur[E[e]] = run
        if (run > bestrun[r]) bestrun[r] = run
      }
    }
    split("", prev); for (t in cur) prev[t] = cur[t]
  }
  anyn = 0
  for (r = 1; r <= nr; r++) if (cov[r] > 0) for (p = 1; p <= n; p++) if ((r, p) in cw) any[p] = 1
  for (p = 1; p <= n; p++) if (p in any) anyn++
  # components: the reference that covers most words nothing before it covers, up to 4, each one adding at least minw words after the first
  ncomp = 0; split("", covered); tot = 0
  while (ncomp < 4) {
    bestg = 0; bestr = 0
    for (r = 1; r <= nr; r++) if (cov[r] > 0) {
      g = 0; for (p = 1; p <= n; p++) if (((r, p) in cw) && !(p in covered)) g++
      if (g > bestg) { bestg = g; bestr = r }
    }
    if (bestr == 0 || bestg < (ncomp == 0 ? 1 : minw)) break
    ncomp++; comp[ncomp] = bestr; compadd[ncomp] = bestg
    # references that add exactly as many words are tied with it: the choice among them is only the order of their names
    ctien[ncomp] = 0; ctie[ncomp] = ""
    for (r = 1; r <= nr; r++) if (r != bestr && cov[r] > 0) {
      g = 0; for (p = 1; p <= n; p++) if (((r, p) in cw) && !(p in covered)) g++
      if (g == bestg) { ctien[ncomp]++; if (ctien[ncomp] <= 5) ctie[ncomp] = ctie[ncomp] (ctie[ncomp] == "" ? "" : ", ") RL[r] }
    }
    for (p = 1; p <= n; p++) if (((bestr, p) in cw)) covered[p] = 1
    tot += bestg
  }
  unc = n - tot
  b = (n < minw) ? "gap" : band(unc, n)
  gapk = ""
  if (b == "gap") gapk = (n < minw) ? "too-short" : ((cites != "" && (lc(cites) in HAVE)) ? "points-at-reference" : (ncomp == 0 ? "no-reference" : "partial-text"))
  if (kind == "free" && b == "gap" && !vocabflag) { nprose++; return }
  nst++
  summ = summ (summ == "" ? "" : "; ") "stanza " s ": " (ncomp > 0 ? RL[comp[1]] (ctien[1] > 0 ? " [tied with " ctien[1] "]" : "") : "no match") " (" b ")"
  # closest three references by standalone coverage
  split("", used); top = ""
  for (ti = 1; ti <= 3; ti++) {
    bc = 0; c = 0
    for (r = 1; r <= nr; r++) if (cov[r] > bc && !(r in used)) { bc = cov[r]; c = r }
    if (c == 0) break
    used[c] = 1; top = top (top == "" ? "" : "; ") RL[c] " (" pct(cov[c], n) ")"
  }
  ex = ""; first = (n < 12) ? n : 12
  for (j = 1; j <= first; j++) ex = ex (j > 1 ? " " : "") wv[j]
  printf "** stanza %d\n:PROPERTIES:\n:STANZA: %d\n:KIND: %s\n", s, s, kind
  if (name != "") printf ":NAME: %s\n", name
  printf ":LINES: %d-%d\n:WORDS: %d\n:HOLDER_LINES_SET_ASIDE: %d\n", l1, l2, n, holders
  printf ":BAND: %s\n:CONFIDENCE: %s\n:COVERED_WORDS: %d\n:OUTSIDE_THE_MATCH_WORDS: %d\n", b, (n < minw ? "not scored" : pct(tot, n) " of the words matched"), tot, unc
  printf ":NOT_IN_ANY_REFERENCE_WORDS: %d\n", n - anyn
  if (gapk != "") printf ":GAP_KIND: %s\n", gapk
  if (ncomp > 0) printf ":BEST: %s\n", RL[comp[1]]
  for (j = 1; j <= ncomp; j++) {
    r = comp[j]
    printf ":COMPONENT_%d: %s; alone %s; adds %d words%s; longest shared run %d words; sha256 %s; %s\n", j, RL[r], pct(cov[r], n), compadd[j], (ctien[j] > 0 ? "; tied with " ctien[j] " other" (ctien[j] > 1 ? "s that add" : " that adds") " as many (" ctie[j] (ctien[j] > 5 ? ", and more" : "") ")" : ""), bestrun[r] + k - 1, RSHA[r], RPATH[r]
  }
  if (top != "") printf ":CLOSEST: %s\n", top
  if (name != "" && name !~ /( [Aa][Nn][Dd] | [Oo][Rr] |,)/ && ncomp > 0) printf ":NAME_AGREES: %s\n", (lc(name) == lc(RN[comp[1]]) ? "yes" : "no")
  else if (name != "" && ncomp > 0) printf ":NAME_AGREES: not compared (the name joins several licences)\n"
  if (cites != "") {
    ag = "no"; for (j = 1; j <= ncomp; j++) if (lc(RN[comp[j]]) == lc(cites)) ag = "yes"
    printf ":CITES: %s\n:CITES_IN_COMPONENTS: %s\n", cites, ag
  }
  printf ":STARTS: %s\n:END:\n", ex
  if (n < minw) printf "Observed: %d words (fewer than %d), so there is too little to compare; it was not scored.\n", n, minw
  else {
    printf "Observed: %d words after setting aside %d copyright-holder lines; %d of them lie in 4-word runs that a reference also holds (%s).\n", n, holders, tot, pct(tot, n)
    for (j = 1; j <= ncomp; j++) printf "Observed: %s covers %s of the stanza alone and adds %d words here; the longest run it shares with the stanza is %d words.\n", RL[comp[j]], pct(cov[comp[j]], n), compadd[j], bestrun[comp[j]] + k - 1
    printf "Observed: %d words match no reference at all.\n", n - anyn
  }
  printf "Judged: %s. The bands are house numbers (4, 9, 17), invented here, not measured.\n", bandwords(b)
  if (gapk == "no-reference") printf "Judged: a gap of kind no-reference: the stanza mentions licensing but shares no 4-word run with any reference held on this host.\n"
  if (gapk == "partial-text") printf "Judged: a gap of kind partial-text: some of its words are in a reference, but more than %d per cent are not, so it may be another licence that shares phrases, or an altered text.\n", b3
  if (gapk == "too-short") printf "Judged: a gap of kind too-short.\n"
  if (gapk == "points-at-reference") printf "Judged: a gap of kind points-at-reference: the stanza names %s by path instead of carrying its text. The pointer is observed; the text it points at was not compared with anything the stanza says.\n", cites
  if (n - anyn > 0) {
    printf "\nObserved: the words that match no reference (normalised: lower case, punctuation gone), in order:\n#+BEGIN_EXAMPLE\n"
    nruns = 0; p = 1
    while (p <= n) {
      if (p in any) { p++; continue }
      st = p; line = ""
      while (p <= n && !(p in any)) { line = line (p > st ? " " : "") wv[p]; p++ }
      nruns++
      if (nruns <= 25) { if (length(line) > 300) line = substr(line, 1, 300) " ..."; printf "words %d-%d: %s\n", st, p - 1, line }
    }
    if (nruns > 25) printf "[%d more runs not listed]\n", nruns - 25
    printf "#+END_EXAMPLE\n"
  }
  if (cites != "") printf "\nObserved: the stanza cites /usr/share/common-licenses/%s by path.\n", cites
}
BEGIN {
  FS = "\t"; summ = ""; nr = 0; nst = 0; nprose = 0; ngap = 0
  while ((getline line < refs) > 0) {
    split(line, f, "\t")
    if (f[4] != "" && f[4] == pkg) continue
    nr++; HAVE[tolower(f[2])] = 1; RN[nr] = f[2]; RL[nr] = f[2] (f[7] ~ /DEP-5/ ? " (DEP-5 paragraph)" : ""); RSHA[nr] = f[5]; RPATH[nr] = f[6]
    mlen = 0
    while ((getline w < f[3]) > 0) { mlen++; rw[mlen] = w }
    close(f[3])
    for (i = 1; i + k - 1 <= mlen; i++) { key = rw[i]; for (t = 1; t < k; t++) key = key " " rw[i + t]; idx[key] = idx[key] " " nr ":" i }
  }
  close(refs)
  while ((getline line < stz) > 0) {
    split(line, f, "\t")
    if (f[1] == "G") { ngap++; GAPS[ngap] = line; continue }
    if (f[1] != "S") continue
    n = 0; split("", wv)
    while ((getline w < (dir "/stz_" f[2] ".w")) > 0) wv[++n] = w
    close(dir "/stz_" f[2] ".w")
    score(f[2], n, f[3], f[4], f[5], f[6], f[8], f[9], f[10] + 0)
  }
  for (q = 1; q <= ngap; q++) {
    split(GAPS[q], f, "\t")
    printf "** stanza name %s\n:PROPERTIES:\n:KIND: %s\n:NAME: %s\n:LINES: %d-%d\n:BAND: gap\n:GAP_KIND: %s\n:END:\n", f[4], f[3], f[4], f[5], f[6], f[7]
    printf "Observed: the name %s is not one of the standard short names, and no License: paragraph of this file carries a text under it.\n", f[4]
    printf "Judged: a gap of kind name-without-text: there are no words of its own to compare, so nothing is scored.\n"
  }
  printf "summary\t%s\nstanzas\t%d\nprose_blocks_set_aside\t%d\nname_gaps\t%d\nreferences\t%d\n", summ, nst, nprose, ngap, nr > sumf
  close(sumf)
}
'

SC_COMMON=${ORGFS_COMMON_LICENSES:-/usr/share/common-licenses}

# every property line of the drawers of the files named, flat:  FILE TAB HEADING TAB KEY TAB VALUE
PROPS_AWK='
FNR == 1 { inp = 0; head = "" }
/^\*+ / { s = $0; sub(/^\*+ +/, "", s); sub(/ +:[A-Za-z0-9_@:]+:$/, "", s); head = s; inp = 0; next }
$0 == ":PROPERTIES:" { inp = 1; next }
$0 == ":END:" { inp = 0; next }
inp && /^:[A-Za-z0-9_-]+:/ { k = $0; sub(/^:/, "", k); sub(/:.*$/, "", k); v = $0; sub(/^:[A-Za-z0-9_-]+:[ \t]*/, "", v); printf "%s\t%s\t%s\t%s\n", FILENAME, head, k, v }
'

# the property KEY of the first drawer of FILE
prop_of() { $AWK -v key="$1" 'NR == 1 { next } $0 == ":END:" { exit } { p = ":" key ":"; if (index($0, p) == 1) { v = substr($0, length(p) + 1); sub(/^[ \t]+/, "", v); print v; exit } }' "$2"; }

sc_slug() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-24; }

# the reference set: $TMP/sc/refs.tsv (refno, name, words file, onlypkg, sha256, path, name-from) and one atom per
# reference in DIR/references/ (named NAME-SHA8.org; an atom that is there is never written again)
sc_refs() { # DIR
  _US=$(printf '\037')
  mkdir -p "$TMP/sc/refw" || die "stack: no temp space"
  : > "$TMP/sc/refs.raw"
  _nr=0
  # (1) the texts Debian ships, named by their file names; a symlink is an alias of its target
  if [ -d "$SC_COMMON" ]; then
    : > "$TMP/sc/cl.seen"
    for _f in "$SC_COMMON"/*; do
      [ -f "$_f" ] && [ ! -L "$_f" ] || continue
      _b=${_f##*/}
      _nr=$((_nr + 1)); _w=$TMP/sc/refw/c$_nr
      $AWK "$NORM_AWK"' { n = nwords($0, W); for (i = 1; i <= n; i++) print W[i] }' "$_f" > "$_w"
      _al=
      for _g in "$SC_COMMON"/*; do
        [ -L "$_g" ] || continue
        [ "$(readlink -f "$_g")" = "$(readlink -f "$_f")" ] && _al="$_al ${_g##*/}"
      done
      _al=${_al# }
      printf '%s\t%s\t%s\t\t%s\t%s\t%s\t%s\n' "$_nr" "$_b" "$_w" "$(sha_file "$_f")" "$_f" "the file name in $SC_COMMON" "$_al" >> "$TMP/sc/refs.raw"
    done
  fi
  # (2) License: paragraphs of DEP-5 copyright files on this host: a standard short name and a text of its own
  _doc=${ORGFS_DOC:-/usr/share/doc}
  : > "$TMP/sc/list"
  for _f in "$_doc"/*/copyright; do [ -r "$_f" ] && printf '%s\n' "$_f" >> "$TMP/sc/list"; done
  if [ -s "$TMP/sc/list" ]; then
    $AWK -v std="$SHARE/dep5-names.txt" -v list="$TMP/sc/list" "$NORM_AWK$DEP5_AWK$REFDEP_AWK" /dev/null | sort > "$TMP/sc/dep.tsv"
    tr '\t' '\037' < "$TMP/sc/dep.tsv" > "$TMP/sc/dep.us"
    while IFS="$_US" read -r _n _cnt _only _first _text; do
      [ -n "$_n" ] || continue
      _nr=$((_nr + 1)); _w=$TMP/sc/refw/d$_nr
      printf '%s\n' "$_text" | tr ' ' '\n' > "$_w"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$_nr" "$_n" "$_w" "$_only" "$(sha_file "$_w")" "$_first" "the License: field of a DEP-5 paragraph in $_first (held by $_cnt packages)" "" >> "$TMP/sc/refs.raw"
    done < "$TMP/sc/dep.us"
  fi
  sort -t "$(printf '\t')" -k2,2 -k5,5 "$TMP/sc/refs.raw" > "$TMP/sc/refs.sorted"
  $AWK -F'\t' '{ printf "%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", NR, $2, $3, $4, $5, $6, $7, $8 }' "$TMP/sc/refs.sorted" > "$TMP/sc/refs.tsv"
  # the atoms
  mkdir -p "$1/references" || die "stack: cannot create $1/references"
  tr '\t' '\037' < "$TMP/sc/refs.tsv" > "$TMP/sc/refs.us"
  while IFS="$_US" read -r _rn _n _w _only _sha _path _from _al; do
    _ra=$1/references/$(printf '%s' "$_n" | tr -c 'A-Za-z0-9.+_\n-' '_')-$(printf '%s' "$_sha" | cut -c1-8).org
    [ ! -e "$_ra" ] || continue
    _nw=$(wc -l < "$_w" | tr -d ' ')
    {
      printf '* reference %s :REFERENCE:\n:PROPERTIES:\n:ORGFS_REFERENCE: %s\n:NAME: %s\n:PATH: %s\n:SHA256: %s\n' "$_n" "${_ra##*/}" "$_n" "$(st_sane "$_path")" "$_sha"
      case $_from in the\ file\ name*) printf ':SHA256_OF: the file bytes\n';; *) printf ':SHA256_OF: the normalised words, one per line\n';; esac
      printf ':NAME_FROM: %s\n:WORDS: %s\n:WRITTEN_AT: %s\n' "$(st_sane "$_from")" "$_nw" "$ST_NOW"
      [ -z "$_al" ] || printf ':ALIASES: %s\n' "$(st_sane "$_al")"
      [ -z "$_only" ] || printf ':ONLY_PACKAGE: %s\n' "$_only"
      printf ':END:\nObserved: the reference %s, read on %s, is the text at %s; %s.\n' "$_n" "$ST_HOST" "$(st_sane "$_path")" "$(st_sane "$_from")"
      printf 'Judged: nothing here. It is a reference because the host holds it in a machine-readable form, not because it was checked to be the licence it is named for.\n'
    } > "$_ra"
  done < "$TMP/sc/refs.us"
}

# PKG COPYRIGHTPATH DIR -> $TMP/sc/body (the stanzas as Org), $TMP/sc/sum, $TMP/sc/index.tsv; the inputs key in SC_KEY
sc_run() {
  _pkg=$1; _cp=$2
  rm -rf "$TMP/sc/stz"; mkdir -p "$TMP/sc/stz"
  : > "$TMP/sc/index.tsv"
  $AWK -v std="$SHARE/dep5-names.txt" -v outdir="$TMP/sc/stz" -v idx="$TMP/sc/index.tsv" -v minw="$SC_MINW" "$NORM_AWK$DEP5_AWK$STZ_AWK" "$_cp" || return 1
  : > "$TMP/sc/sum"
  $AWK -v refs="$TMP/sc/refs.tsv" -v stz="$TMP/sc/index.tsv" -v dir="$TMP/sc/stz" -v pkg="$_pkg" -v cfile="$_cp" -v sumf="$TMP/sc/sum" \
    -v k="$SC_K" -v minw="$SC_MINW" -v b1="$SC_B1" -v b2="$SC_B2" -v b3="$SC_B3" "$NORM_AWK$SC_AWK" /dev/null > "$TMP/sc/body" || return 1
  # the references this package was scored against (a reference only this package holds is left out)
  SC_REFSET=$($AWK -F'\t' -v pkg="$_pkg" '!($4 != "" && $4 == pkg) { print $2 "\t" $5 }' "$TMP/sc/refs.tsv" | sort | sha_stdin)
  SC_KEY=$(sha_str "$SC_METHOD|$SC_VERSION|$SC_K|$SC_MINW|$SC_B1|$SC_B2|$SC_B3|$(sha_file "$_cp")|$SC_REFSET")
  return 0
}

sc_fact() { $AWK -F'\t' -v key="$1" '$1 == "X" && $2 == key { print $3; exit }' "$TMP/sc/index.tsv"; }
sc_sum() { $AWK -F'\t' -v key="$1" '$1 == key { print $2; exit }' "$TMP/sc/sum"; }

# the newest guess of PKG in DIR (the one nothing follows); a forked or broken chain is an error
sc_head() { # DIR PKG -> SC_HEAD (a path, or empty)
  SC_HEAD=
  _gd=$1/guesses/$2
  [ -d "$_gd" ] || return 0
  _heads=
  for _g in "$_gd"/*.org; do
    [ -f "$_g" ] || continue
    [ -n "$(prop_of NEXT "$_g")" ] || _heads="$_heads $_g"
  done
  set -- $_heads
  [ $# -le 1 ] || die "stack: the history of guesses for $2 in $_gd is forked: more than one guess has no NEXT ($*)"
  SC_HEAD=${1:-}
  return 0
}

# PKG COPYRIGHTPATH DIR: append a guess if the inputs changed since the newest one; say which
sc_record() {
  _pkg=$1; _cp=$2; _dir=$3
  sc_run "$_pkg" "$_cp" || { warn "stack: could not score $_cp"; return 1; }
  sc_head "$_dir" "$_pkg"; _old=$SC_HEAD
  if [ -n "$_old" ] && [ "$(prop_of INPUTS_KEY "$_old")" = "$SC_KEY" ]; then
    printf 'stack: guess for %s unchanged (same inputs and method as %s): nothing written\n' "$_pkg" "guesses/$_pkg/${_old##*/}"
    return 0
  fi
  _gd=$_dir/guesses/$_pkg
  mkdir -p "$_gd" || die "stack: cannot create $_gd"
  _stamp=$(printf '%s' "$ST_NOW" | tr -d ':-')
  _base=$_stamp-$SC_METHOD-v$SC_VERSION; _n=1
  while [ -e "$_gd/$_base.org" ]; do _n=$((_n + 1)); _base=$_stamp-$_n-$SC_METHOD-v$SC_VERSION; done
  _new=$_gd/$_base.org
  {
    printf '* guess %s :GUESS:\n:PROPERTIES:\n:ORGFS_GUESS: guesses/%s/%s.org\n:PACKAGE: %s\n' "$_pkg" "$_pkg" "$_base" "$_pkg"
    printf ':METHOD: %s\n:METHOD_VERSION: %s\n:SHINGLE_WORDS: %s\n:MIN_STANZA_WORDS: %s\n:BAND_PERCENTS: %s %s %s (house numbers, invented)\n' "$SC_METHOD" "$SC_VERSION" "$SC_K" "$SC_MINW" "$SC_B1" "$SC_B2" "$SC_B3"
    printf ':MADE_AT: %s\n:MADE_ON: %s\n' "$ST_NOW" "$ST_HOST"
    printf ':FILE_READ: %s\n:FILE_SHA256: %s\n:REFERENCE_SET_SHA256: %s\n:REFERENCES_USED: %s\n:INPUTS_KEY: %s\n' "$(st_sane "$_cp")" "$(sha_file "$_cp")" "$SC_REFSET" "$(sc_sum references)" "$SC_KEY"
    printf ':FORMAT: %s\n:STANDARD_STANZAS_NOT_SCORED: %s\n:STANDARD_NAMES: %s\n' "$(sc_fact format)" "$(sc_fact standard_stanzas)" "$(sc_fact standard_names)"
    printf ':STANZAS_SCORED: %s\n:PROSE_BLOCKS_SET_ASIDE: %s\n:SHORT_BLOCKS_SET_ASIDE: %s\n:NAME_GAPS: %s\n' "$(sc_sum stanzas)" "$(sc_sum prose_blocks_set_aside)" "$(sc_fact short_blocks | grep . || echo 'not applicable')" "$(sc_sum name_gaps)"
    printf ':SUMMARY: %s\n' "$(st_sane "$(sc_sum summary)")"
    if [ -n "$_old" ]; then printf ':PREVIOUS: [[file:%s]]\n' "${_old##*/}"; else printf ':PREVIOUS: none\n'; fi
    printf ':END:\n'
    printf 'Observed: orgfs stack (orgfs %s) made this guess on %s on %s from the %s copyright file %s (sha256 %s), against the reference set %s (%s references; atoms in references/). The method is %s, version %s. No network call and no model call was made.\n' \
      "$VERSION" "$ST_NOW" "$ST_HOST" "$(sc_fact format)" "$(st_sane "$_cp")" "$(sha_file "$_cp")" "$SC_REFSET" "$(sc_sum references)" "$SC_METHOD" "$SC_VERSION"
    if [ "$(sc_fact format)" = dep5 ]; then
      printf 'Observed: %s paragraphs carry only standard short names (%s); the file states those in a machine-readable form, so they are taken as stated and not scored.\n' "$(sc_fact standard_stanzas)" "$(st_sane "$(sc_fact standard_names)")"
    fi
    printf 'Judged: nothing in this guess is a finding about the law. It says how much of the wording of the file also stands in a text the host already holds in a machine-readable form.\n'
    cat "$TMP/sc/body"
  } > "$TMP/sc/newguess"
  cp "$TMP/sc/newguess" "$_new" || die "stack: cannot write $_new"
  if [ -n "$_old" ]; then
    # the one change ever made to an old guess: NEXT is written on it, once
    $AWK -v nx="[[file:$_base.org]]" 'BEGIN { done = 0 } !done && $0 == ":END:" { print ":NEXT: " nx; done = 1 } { print }' "$_old" > "$TMP/sc/oldguess" && cp "$TMP/sc/oldguess" "$_old" || die "stack: cannot write NEXT on $_old"
    printf 'stack: guess for %s changed: wrote guesses/%s/%s.org after %s (%s)\n' "$_pkg" "$_pkg" "$_base" "${_old##*/}" "$(sc_sum summary)"
  else
    printf 'stack: guess for %s: wrote guesses/%s/%s.org (%s)\n' "$_pkg" "$_pkg" "$_base" "$(sc_sum summary)"
  fi
  return 0
}

# SECTION_AWK: the "licence guess" section of a tool atom, from the flat properties of the guesses and the corrections of one package
#   -v pkg= -v head=BASENAME-OF-THE-NEWEST-GUESS (or empty) -v why=reason there is no guess
SECTION_AWK='
function base(p) { sub(/^.*\//, "", p); return p }
function nowords(s) { return s }
BEGIN { FS = "\t"; ng = 0; nz = 0 }
{
  f = $1; h = $2; k = $3; v = $4
  if (f ~ /\/guesses\//) {
    b = base(f)
    if (!(b in G)) { G[b] = 1; gorder[++ng] = b }
    if (h ~ /^guess /) GP[b, k] = v
    else if (h ~ /^stanza /) {
      if (k == "STANZA") { ns[b]++; cur[b] = h }
      S[b, h, k] = v
      if (!((b, h) in seenh)) { seenh[b, h] = 1; sorder[b, ++sn[b]] = h }
      if (k ~ /^COMPONENT_/) { c = v; sub(/;.*$/, "", c); comps[b, h] = comps[b, h] (comps[b, h] == "" ? "" : ", ") c }
    }
  } else if (f ~ /\/corrections\//) {
    b = base(f)
    if (!(b in Z)) { Z[b] = 1; zorder[++nz] = b }
    ZP[b, k] = v
  }
}
END {
  inEffect = "none"; best = ""
  for (i = 1; i <= nz; i++) {
    b = zorder[i]
    if (ZP[b, "STATE"] == "approved") {
      na++
      if (best == "" || ZP[b, "APPROVED_AT"] > ZP[best, "APPROVED_AT"] || (ZP[b, "APPROVED_AT"] == ZP[best, "APPROVED_AT"] && b > best)) best = b
    } else np++
  }
  if (best != "") inEffect = "approved correction"
  else if (head != "") inEffect = "machine guess"
  printf "** licence guess\n:PROPERTIES:\n:ROLE: licence-guess\n:PACKAGE: %s\n:IN_EFFECT: %s\n", pkg, inEffect
  if (head != "") printf ":GUESS_CURRENT: guesses/%s/%s\n:GUESS_HISTORY: guesses/%s/ (%s)\n", pkg, head, pkg, (ng == 1 ? "1 guess" : ng " guesses")
  printf ":CORRECTIONS_APPROVED: %d\n:CORRECTIONS_PROPOSED: %d\n:END:\n", na + 0, np + 0
  if (best != "") {
    printf "Observed: the licence in effect for package %s is %s, by a correction proposed by %s on %s and approved by %s on %s (corrections/%s/%s). The reason given: %s\n", pkg, ZP[best, "SAYS"], ZP[best, "PROPOSED_BY"], ZP[best, "PROPOSED_AT"], ZP[best, "APPROVED_BY"], ZP[best, "APPROVED_AT"], pkg, best, ZP[best, "WHY"]
    printf "Judged: nothing. A correction is a person saying so and a second person agreeing; this tool did not check it against any text.\n"
  }
  if (head == "") {
    printf "Observed: no machine guess: %s\n", why
  } else {
    hb = head
    printf "Observed: the machine guess%s is guesses/%s/%s, made %s by %s version %s from %s (sha256 %s): %s.\n", (best != "" ? " (kept, and outranked by the correction above)" : ""), pkg, hb, GP[hb, "MADE_AT"], GP[hb, "METHOD"], GP[hb, "METHOD_VERSION"], GP[hb, "FILE_READ"], GP[hb, "FILE_SHA256"], (GP[hb, "SUMMARY"] == "" ? "nothing to score" : GP[hb, "SUMMARY"])
    if (GP[hb, "FORMAT"] == "dep5" && GP[hb, "STANDARD_STANZAS_NOT_SCORED"] + 0 > 0) printf "Observed: %s paragraphs carry only standard short names (%s), taken as stated and not scored.\n", GP[hb, "STANDARD_STANZAS_NOT_SCORED"], GP[hb, "STANDARD_NAMES"]
    for (j = 1; j <= sn[hb]; j++) {
      h = sorder[hb, j]
      line = "- " h " (lines " S[hb, h, "LINES"] ", " S[hb, h, "WORDS"] " words" (S[hb, h, "NAME"] != "" ? ", named " S[hb, h, "NAME"] : "") "): " (S[hb, h, "BAND"] == "gap" ? "a gap" : S[hb, h, "BAND"] " confidence") ", " S[hb, h, "CONFIDENCE"]
      if (comps[hb, h] != "") line = line "; matches " comps[hb, h]
      if (S[hb, h, "GAP_KIND"] != "") line = line "; a gap of kind " S[hb, h, "GAP_KIND"]
      if (S[hb, h, "CLOSEST"] != "" && S[hb, h, "BAND"] == "gap") line = line "; closest " S[hb, h, "CLOSEST"]
      print line
    }
    printf "Judged: the band edges are %s, not measured; method %s version %s. The guess atom lists, for each stanza, the words that matched no reference.\n", GP[hb, "BAND_PERCENTS"], GP[hb, "METHOD"], GP[hb, "METHOD_VERSION"]
    if (ng > 1) {
      printf "Observed: the history of guesses for this package has %d entries, oldest first:\n", ng
      for (i = 1; i <= ng; i++) printf "- guesses/%s/%s: %s (%s)\n", pkg, gorder[i], GP[gorder[i], "MADE_AT"], (GP[gorder[i], "SUMMARY"] == "" ? "nothing to score" : GP[gorder[i], "SUMMARY"])
    } else printf "Observed: this is the only guess so far for this package; a later one will be linked to it by PREVIOUS and NEXT.\n"
  }
  if (np + na > 0) {
    for (i = 1; i <= nz; i++) {
      b = zorder[i]
      printf "- correction corrections/%s/%s: %s says %s (%s); %s\n", pkg, b, ZP[b, "PROPOSED_BY"], ZP[b, "SAYS"], ZP[b, "STATE"], (ZP[b, "STATE"] == "approved" ? "approved by " ZP[b, "APPROVED_BY"] " on " ZP[b, "APPROVED_AT"] : "waiting for someone else to approve it")
    }
  }
  printf "To offer a correction: tell the project by an issue or by mail; a maintainer records it with  orgfs stack correct %s --says LICENCE --by NAME --why REASON  and a different person approves it with  orgfs stack approve CORRECTION --by NAME.\n", pkg
}
'

# PKG DIR -> the section on stdout.  WHY is what to say when there is no guess.
sc_section() {
  _sp=$1; _sd=$2; _why=${3:-"no copyright file was read for this package, so there was nothing to score"}
  sc_head "$_sd" "$_sp"
  : > "$TMP/sc/flat"
  for _g in "$_sd/guesses/$_sp"/*.org; do [ -f "$_g" ] && $AWK "$PROPS_AWK" "$_g" >> "$TMP/sc/flat"; done
  for _g in "$_sd/corrections/$_sp"/*.org; do [ -f "$_g" ] && $AWK "$PROPS_AWK" "$_g" >> "$TMP/sc/flat"; done
  $AWK -v pkg="$_sp" -v head="${SC_HEAD##*/}" -v why="$_why" "$SECTION_AWK" "$TMP/sc/flat"
}

# put SECTION (a file) into the tool atom ATOM: it replaces a licence guess section or goes before the first gap record
sc_put() { # ATOM SECTIONFILE
  $AWK -v sec="$2" '
    function emit(   l) { while ((getline l < sec) > 0) print l; close(sec); print ""; done = 1 }
    /^\*\* licence guess$/ { skip = 1; if (!done) emit(); next }
    skip && /^\*+ / { skip = 0 }
    skip { next }
    !done && /^\*\* gap / { emit() }
    { print }
    END { if (!done) { print ""; emit() } }' "$1" | $AWK '{ L[NR] = $0 } END { n = NR; while (n > 0 && L[n] == "") n--; for (i = 1; i <= n; i++) print L[i] }' > "$TMP/sc/atomout" || return 1
  cp "$TMP/sc/atomout" "$1"
}

# bring the licence guess section of the tool atoms of DIR up to date; MODE seen: only the atoms read here (a stack run),
# all: every atom that names a package (a correction was made)
sc_refresh() { # DIR MODE [PKG]
  for _a in "$1"/tool-*.org; do
    [ -f "$_a" ] || continue
    _p=$(prop_of PACKAGE "$_a"); _p=${_p%%:*}
    [ -n "$_p" ] || continue
    [ -z "${3:-}" ] || [ "$_p" = "$3" ] || continue
    if [ "$2" = seen ]; then head -n 1 "$_a" | grep -q ':SEEN_HERE:' || continue; fi
    _why="the copyright file of this package could not be read (see the gap record), so there was nothing to score"
    sc_section "$_p" "$1" "$_why" > "$TMP/sc/section"
    sc_put "$_a" "$TMP/sc/section" || die "stack: cannot update the licence guess of $_a"
  done
}

# after a stack run: score every package whose copyright file was read here
sc_all() { # DIR
  sc_refs "$1"
  : > "$TMP/sc/done"
  for _a in "$1"/tool-*.org; do
    [ -f "$_a" ] || continue
    head -n 1 "$_a" | grep -q ':SEEN_HERE:' || continue
    _p=$(prop_of PACKAGE "$_a"); _p=${_p%%:*}; _c=$(prop_of COPYRIGHT_PATH "$_a")
    [ -n "$_p" ] && [ -n "$_c" ] && [ -r "$_c" ] || continue
    grep -qx "$_p" "$TMP/sc/done" && continue
    printf '%s\n' "$_p" >> "$TMP/sc/done"
    sc_record "$_p" "$_c" "$1" || true
  done
  sc_refresh "$1" seen
}

# ---- corrections: a person says what the licence is, a second person agrees; the machine guess stays beside it
# one plain line, not empty, no control characters, at most 500 bytes
st_plain() { # WHAT VALUE
  [ -n "$2" ] || die "stack: $1 is needed"
  [ "$(printf '%s' "$2" | tr -d '\000-\037' | wc -c | tr -d ' ')" = "$(printf '%s' "$2" | wc -c | tr -d ' ')" ] || die "stack: $1 must be one plain line (no tab, newline or other control character)"
  [ "$(printf '%s' "$2" | wc -c | tr -d ' ')" -le 500 ] || die "stack: $1 is longer than 500 bytes"
  [ -n "$(printf '%s' "$2" | tr -d ' ')" ] || die "stack: $1 is empty"
}
st_name_key() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -s ' ' | sed -e 's/^ //' -e 's/ $//'; }

st_correct() { # PACKAGE (--says --by --why [--stack DIR])
  _pkg=${1:-}; [ -n "$_pkg" ] || die "stack correct: need PACKAGE"
  case $_pkg in *[!A-Za-z0-9.+_-]*|[!A-Za-z0-9]*) die "stack correct: a package name is letters, digits, dot, plus, dash and underscore";; esac
  st_plain "--says" "$O_SAYS"; st_plain "--by" "$O_BY"; st_plain "--why" "$O_WHY"
  _dir=${O_STACK:-stack}
  [ -d "$_dir" ] || die "stack correct: there is no stack directory $_dir (name it with --stack DIR)"
  _found=0
  for _a in "$_dir"/tool-*.org; do
    [ -f "$_a" ] || continue
    _p=$(prop_of PACKAGE "$_a"); [ "${_p%%:*}" = "$_pkg" ] && _found=1
  done
  [ "$_found" = 1 ] || die "stack correct: no tool atom in $_dir names the package $_pkg"
  mkdir -p "$TMP/sc" || die "stack: no temp space"
  ST_NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  sc_head "$_dir" "$_pkg"
  _then=none; [ -z "$SC_HEAD" ] || _then="[[file:../../guesses/$_pkg/${SC_HEAD##*/}]]"
  _cd=$_dir/corrections/$_pkg
  mkdir -p "$_cd" || die "stack correct: cannot create $_cd"
  _id=$(date -u +%Y%m%dT%H%M%SZ)-$(sc_slug "$O_BY"); _n=1; _base=$_id
  while [ -e "$_cd/$_base.org" ]; do _n=$((_n + 1)); _base=$_id-$_n; done
  {
    printf '* correction %s :CORRECTION:\n:PROPERTIES:\n:ORGFS_CORRECTION: corrections/%s/%s.org\n:PACKAGE: %s\n:SAYS: %s\n:STATE: proposed\n' "$_pkg" "$_pkg" "$_base" "$_pkg" "$O_SAYS"
    printf ':PROPOSED_BY: %s\n:PROPOSED_AT: %s\n:WHY: %s\n:GUESS_THEN: %s\n:END:\n' "$O_BY" "$ST_NOW" "$O_WHY" "$_then"
    printf 'Observed: %s proposed on %s that the licence of package %s is %s, because: %s\n' "$O_BY" "$ST_NOW" "$_pkg" "$O_SAYS" "$O_WHY"
    printf 'Judged: nothing. It is a claim by the person named, entered as typed; it is not in effect until someone else approves it, and the machine guess it was made against is linked above and stays.\n'
  } > "$_cd/$_base.org"
  sc_refresh "$_dir" all "$_pkg"
  printf 'correction: wrote %s/corrections/%s/%s.org (STATE proposed, by %s); another person approves it with: orgfs stack approve %s/%s --by NAME --stack %s\n' "$_dir" "$_pkg" "$_base" "$O_BY" "$_pkg" "$_base" "$_dir"
}

st_approve() { # CORRECTION (--by [--stack DIR]) where CORRECTION is PACKAGE/ID, an ID, or a path
  _arg=${1:-}; [ -n "$_arg" ] || die "stack approve: need CORRECTION"
  st_plain "--by" "$O_BY"
  _dir=${O_STACK:-stack}
  [ -d "$_dir/corrections" ] || die "stack approve: there are no corrections in $_dir (name the stack directory with --stack DIR)"
  _f=
  for _try in "$_dir/corrections/${_arg%.org}.org" "$_arg"; do
    [ -f "$_try" ] && { _f=$_try; break; }
  done
  if [ -z "$_f" ]; then
    _m=0
    for _try in "$_dir"/corrections/*/"${_arg%.org}.org"; do [ -f "$_try" ] && { _m=$((_m + 1)); _f=$_try; }; done
    [ "$_m" -le 1 ] || die "stack approve: $_arg names $_m corrections; say PACKAGE/ID"
  fi
  [ -n "$_f" ] || die "stack approve: no correction $_arg in $_dir/corrections"
  _real=$(cd "$(dirname "$_f")" && pwd -P)/$(basename "$_f"); _root=$(cd "$_dir/corrections" && pwd -P)
  case $_real in "$_root"/*) :;; *) die "stack approve: $_f is not a correction of $_dir";; esac
  _state=$(prop_of STATE "$_f"); _by=$(prop_of PROPOSED_BY "$_f"); _pkg=$(prop_of PACKAGE "$_f")
  if [ "$_state" = approved ]; then
    printf 'approve: %s is already approved (by %s on %s); nothing changed\n' "$_f" "$(prop_of APPROVED_BY "$_f")" "$(prop_of APPROVED_AT "$_f")"
    return 0
  fi
  [ "$_state" = proposed ] || die "stack approve: $_f has STATE '$_state', not proposed"
  if [ "$(st_name_key "$_by")" = "$(st_name_key "$O_BY")" ]; then
    die "stack approve: refused. $_by proposed this correction, and the person who proposes a correction cannot approve it; someone else must"
  fi
  mkdir -p "$TMP/sc" || die "stack: no temp space"
  ST_NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  $AWK -v by="$O_BY" -v at="$ST_NOW" '
    BEGIN { done = 0 }
    !done && $0 == ":STATE: proposed" { print ":STATE: approved"; next }
    !done && $0 == ":END:" { print ":APPROVED_BY: " by; print ":APPROVED_AT: " at; done = 1 }
    { print }
    END { printf "Observed: %s approved this correction on %s. It now outranks the machine guess in the tool atom; the guess stays beside it.\n", by, at }' "$_f" > "$TMP/sc/corr" || die "stack approve: cannot write the approval"
  cp "$TMP/sc/corr" "$_f"
  sc_refresh "$_dir" all "$_pkg"
  printf 'approve: %s approved by %s at %s (STATE approved; proposed by %s)\n' "$_f" "$O_BY" "$ST_NOW" "$_by"
}

# The document `orgfs who` writes, as HTML.  It reads only the shapes who writes: headings with a
# :CUSTOM_ID: (the id of the element), paragraphs of one line, lists two deep, example blocks, and links
# of the form [[#id][label]].  Nothing is added to what the document says.
WHO_HTML_AWK='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
function links(s,   out, i, j, k, id, lab) {
  out = ""
  while ((i = index(s, "[[#")) > 0) {
    out = out substr(s, 1, i - 1); s = substr(s, i + 3)
    j = index(s, "]["); k = index(s, "]]")
    if (j == 0 || k == 0 || j > k) { out = out "[[#"; continue }
    id = substr(s, 1, j - 1); lab = substr(s, j + 2, k - j - 2)
    out = out "<a href=\"#" id "\">" lab "</a>"; s = substr(s, k + 2)
  }
  return out s
}
function closelist() { if (cur > 0) { printf "</li>\n"; while (cur > 0) { printf "</ul>\n"; cur--; if (cur > 0) printf "</li>\n" } } }
function item(depth, text) {
  if (depth > cur) { printf "<ul>\n"; cur++ }
  else { while (cur > depth) { printf "</li>\n</ul>\n"; cur-- }; printf "</li>\n" }
  printf "<li>%s", text
}
function heading(   t) {
  t = esc(htxt)
  printf "<h%d%s>%s</h%d>\n", hl + 1, (hid != "") ? " id=\"" hid "\"" : "", links(t), hl + 1
  want = 0; hid = ""
}
function para(s,   t) {
  t = links(esc(s))
  if (t ~ /^Observed: /) t = "<span class=\"tag\">observed</span>" substr(t, 11)
  else if (t ~ /^Judged: /) t = "<span class=\"tag\">judged</span>" substr(t, 9)
  printf "<p>%s</p>\n", t
}
BEGIN { cur = 0; want = 0; indr = 0; pre = 0 }
pre { if ($0 ~ /^#\+END_EXAMPLE/) { printf "</pre>\n"; pre = 0 } else print esc($0); next }
indr { if ($0 == ":END:") { indr = 0; heading() } else if ($0 ~ /^:CUSTOM_ID:/) { hid = $0; sub(/^:CUSTOM_ID:[ \t]*/, "", hid) }; next }
want { if ($0 == ":PROPERTIES:") { indr = 1; next } else heading() }
/^#\+TITLE:/ { next }
/^#\+BEGIN_EXAMPLE/ { closelist(); printf "<pre>\n"; pre = 1; next }
/^\*+ / { closelist(); n = 0; while (substr($0, n + 1, 1) == "*") n++; hl = n; htxt = substr($0, n + 2); want = 1; hid = ""; next }
/^ *- / { match($0, /^ */); item(int(RLENGTH / 2) + 1, links(esc(substr($0, RLENGTH + 3)))); next }
/^[ \t]*$/ { closelist(); next }
{ closelist(); para($0) }
END { if (want) heading(); closelist() }
'

# ---- the page for the tools orgfs stands on: stack.html, from a stack directory (atoms, guesses, corrections)
# input: the flat properties of every atom (paths relative to the stack directory)
STACK_HTML_AWK='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
function base(p) { sub(/^.*\//, "", p); return p }
function pk(p,   a, n) { n = split(p, a, "/"); return a[2] }
function plural(n, one, many) { return n == 1 ? "1 " one : n " " many }
function cap(s) { return toupper(substr(s, 1, 1)) substr(s, 2) }
# the Debian release the host names itself (READ_ENV: "...; Debian GNU/Linux 12 (bookworm)"), or nothing
function codename(env,   m) {
  if (match(env, /Debian GNU\/Linux [0-9.]+ \([a-z]+\)/)) { m = substr(env, RSTART, RLENGTH); sub(/^.*\(/, "", m); sub(/\)$/, "", m); return m }
  return ""
}
function usedfor(t) {
  if (t == "sh") return "ran every script and every make recipe of this build"
  if (t == "awk") return "did orgfs'"'"'s text handling (orgfs uses gawk or mawk)"
  if (t == "make") return "ran make check, make prove-red and make site"
  if (t == "git") return "fetched the commit that was built and checked it out"
  if (t == "python3") return "ran the test suites (tests/run_all.py) and the planted-fault runs"
  if (t == "emacs") return "ran tests/org_check.el, the check in which Org reads every composed file"
  if (t == "org") return "was the second reader in that check (Org is the library inside Emacs)"
  if (t == "rsync") return "copied the finished site into the folder the web server serves"
  if (t == "nginx") return "serves the page you are reading"
  return ""
}
function gapsof(f, t,   i, h, k, shape, how, why1, route, line) {
  if (NG[f] == 0) { printf "<p><span class=\"tag\">observed</span>No gap records in this tool&#39;s atom.</p>\n"; return }
  printf "<h3>Gaps</h3>\n<ul>\n"
  for (i = 1; i <= NG[f]; i++) {
    h = GA[f, i]; k = GK[f, h, "WHAT_KIND"]; shape = GK[f, h, "WHAT_SHAPE"]; how = GK[f, h, "HOW"]; why1 = GK[f, h, "WHY"]; route = GK[f, h, "ROUTE"]
    if (k == "commits") line = "Which commits make this version distinct: not read yet (needs the upstream tree)."
    else { line = (substr(shape, 1, length(t)) == t ? shape : cap(shape)) ": " how; if (line !~ /[.]$/) line = line "."; if (why1 != "") line = line " Why: " why1 (why1 ~ /[.]$/ ? "" : ".") }
    printf "<li><span class=\"tag\">gap</span>%s%s</li>\n", esc(line), (route != "" && k != "commits" ? " What would fill it: " esc(route) "." : "")
  }
  printf "</ul>\n"
}
BEGIN { FS = "\t"; nt = 0 }
{
  f = $1; h = $2; k = $3; v = $4
  if (f ~ /^tool-/) {
    if (k ~ /^__/) { T[f, k] = v; next }
    if (k == "ORGFS_ATOM") { MH[f] = h; TF[f] = 1 }
    if (h == MH[f]) T[f, k] = v
    else if (h == "licence guess") LG[f, k] = v
    else if (h ~ /^gap /) { if (!((f, h) in GS)) { GS[f, h] = 1; GA[f, ++NG[f]] = h }; GK[f, h, k] = v }
  } else if (f ~ /^guesses\//) {
    P = pk(f)
    if (!(f in GF)) { GF[f] = 1; GL[P, ++GN[P]] = f }
    if (h ~ /^guess /) GP[f, k] = v
    else if (h ~ /^stanza /) {
      if (!((f, h) in SH)) { SH[f, h] = 1; SO[f, ++SN[f]] = h }
      S[f, h, k] = v
      if (k ~ /^COMPONENT_/) { c = v; sub(/;.*$/, "", c); SC[f, h] = SC[f, h] (SC[f, h] == "" ? "" : ", ") c }
    }
  } else if (f ~ /^corrections\//) {
    P = pk(f)
    if (!(f in ZF)) { ZF[f] = 1; ZL[P, ++ZN[P]] = f }
    ZP[f, k] = v
  }
}
END {
  n = split(order, ord, " ")
  for (i = 1; i <= n; i++) { t = ord[i]; f = "tool-" t ".org"; if (f in TF) { nt++; TL[nt] = f; TN[nt] = t } }
  f0 = TL[1]
  if (live == 1) {
    printf "<h1>The machine that built this page, and how sure we are of its licences</h1>\n"
    printf "<p>This page was built and tested by the machine described below; it read its own tools while building it. The build is <a href=\"/ci/runs/%s.log\">run %s</a>, of commit <a href=\"https://github.com/inputloop/orgfs/commit/%s\">%s</a>.</p>\n", esc(brun), esc(brun), esc(bcommit), esc(substr(bcommit, 1, 12))
    printf "<p class=\"status\">Status: orgfs %s, before 1.0. %s tools read by <code>orgfs stack</code> on %s (%s) between %s and the end of that build; the facts below are the ones in the atoms, not new ones. Nothing on this page says the tests passed: the log of the run does.</p>\n", version, nt, esc(T[f0, "READ_ON"]), esc(T[f0, "READ_ENV"]), esc(T[f0, "READ_AT"])
  } else {
    printf "<h1>The tools orgfs stands on, and how sure we are of their licences</h1>\n"
    printf "<p>These are the tools of an example machine, <code>%s</code>, read at %s. They were not read by the machine that built this page, so nothing below says what built it.</p>\n", esc(T[f0, "READ_ON"]), esc(T[f0, "READ_AT"])
    if (asked == 1) printf "<p><span class=\"tag\">observed</span>This build asked for a stack read on the build machine and did not get one: %s.</p>\n", esc(why)
    printf "<p class=\"status\">Status: orgfs %s, before 1.0. %s tools read by <code>orgfs stack</code> on %s at %s; the facts below are the ones in the atoms, not new ones. Nothing on this page says the tests passed; run <code>make check</code>.</p>\n", version, nt, esc(T[f0, "READ_ON"]), esc(T[f0, "READ_AT"])
  }
  printf "<p><span class=\"tag\">observed</span>Each tool below is an atom (an Org file) that quotes the command that gave its version and the licence names its Debian package states in its own copyright file. This page adds a <em>confidence</em>: how much of the wording of that copyright file also stands in a licence text this host already holds in a machine-readable form (the files in <code>/usr/share/common-licenses</code> and the <code>License:</code> paragraphs of machine-readable copyright files on the same host).</p>\n"
  printf "<p><span class=\"tag\">observed</span>The measure is <em>shingle containment</em>, version 1: lower-case the words, cut them into runs of 4, and count which words of a stanza lie inside a run that a reference also holds. The score is that share. The words that match no reference are listed in the guess, because they are where the file says something the reference does not. The reference texts themselves are atoms, each with its name, path, SHA-256 and where its name came from. No network call and no model call is made.</p>\n"
  printf "<p><span class=\"tag\">judged</span>The bands are a gap of at most 4 per cent of the words for <em>high</em>, 9 for <em>moderate</em> and 17 for <em>low</em>; more than that stays a gap, and says what kind. The numbers 4, 9 and 17 are house numbers, invented, not measured. Would be wrong if two stanzas with the same meaning get bands more than one step apart, or one with a different meaning gets a high band; the corrections below are where that would show.</p>\n"
  if (live == 1) printf "<p><span class=\"tag\">judged</span>The line &quot;How this build used it&quot; under each tool is what the Makefile and the CI script call; this page did not watch the tools run. Would be wrong if the log of the run shows a step that ran a different tool.</p>\n"
  printf "<p><span class=\"tag\">asked</span>Corwin Brust, 2026-11-08, 00:50: &quot;let&#39;s see if we can score licenses per our confidence we understanding the meaning of the words&quot; and &quot;provide access to the history (if there is any) of each of our guesses&quot;.</p>\n"
  if (live == 1) printf "<p><span class=\"tag\">asked</span>Corwin Brust, 2026-11-08, 08:32: &quot;orgfs showing it&#39;s own toolchain is the MVP for the site&quot;.</p>\n"
  for (i = 1; i <= nt; i++) {
    f = TL[i]; t = TN[i]; pkg = T[f, "PACKAGE"]; sub(/:.*$/, "", pkg)
    printf "<h2 id=\"tool-%s\">%s</h2>\n", esc(t), esc(t)
    printf "<dl>\n"
    if (live == 1 && usedfor(t) != "") printf "<dt>How this build used it</dt><dd>%s</dd>\n", esc(usedfor(t))
    if (live == 1) printf "<dt>Read</dt><dd>on %s at %s, during this build</dd>\n", esc(T[f, "READ_ON"]), esc(T[f, "READ_AT"])
    else printf "<dt>Read</dt><dd>on %s (%s) at %s, not on the machine that built this page</dd>\n", esc(T[f, "READ_ON"]), esc(T[f, "READ_ENV"]), esc(T[f, "READ_AT"])
    cmd = T[f, "__CMD"]; sub(/^\$ /, "", cmd)
    printf "<dt>Version</dt><dd>%s", esc(T[f, "VERSION"] == "" ? (T[f, "PRESENT"] == "yes" ? "the tool printed none (see the gap below); the package version is under Package" : "not read") : T[f, "VERSION"])
    if (T[f, "VERSION"] != "" && cmd != "") printf "<br>as it reported itself, by <code>%s</code>", esc(cmd)
    printf "</dd>\n"
    if (pkg == "") { printf "<dt>Package</dt><dd>not read (see the gap records below and in <a href=\"stack/%s\">the atom</a>)</dd>\n</dl>\n", esc(f); gapsof(f, t); continue }
    src = T[f, "SOURCE_PACKAGE"]; cn = codename(T[f, "READ_ENV"])
    printf "<dt>Package</dt><dd>%s %s", esc(pkg), esc(T[f, "PACKAGE_VERSION"])
    printf "; source package %s; upstream version %s", esc(src), esc(T[f, "UPSTREAM_VERSION"])
    if (cn != "") printf ". Debian pages, as links only (nothing is fetched): <a href=\"https://packages.debian.org/%s/%s\">packages.debian.org/%s/%s</a> and <a href=\"https://tracker.debian.org/pkg/%s\">tracker.debian.org/pkg/%s</a>", esc(cn), esc(pkg), esc(cn), esc(pkg), esc(src), esc(src)
    else printf ". The host does not name a Debian release, so no link to Debian is given"
    printf "</dd>\n"
    printf "<dt>Licence names the package states</dt><dd>%s</dd>\n", esc(T[f, "LICENSES"] == "" ? "none: the copyright file has no License: line" : T[f, "LICENSES"])
    best = ""
    for (j = 1; j <= ZN[pkg]; j++) { z = ZL[pkg, j]; if (ZP[z, "STATE"] == "approved" && (best == "" || ZP[z, "APPROVED_AT"] > ZP[best, "APPROVED_AT"] || (ZP[z, "APPROVED_AT"] == ZP[best, "APPROVED_AT"] && z > best))) best = z }
    gh = GL[pkg, GN[pkg]]
    for (j = 1; j <= GN[pkg]; j++) if (GP[GL[pkg, j], "NEXT"] == "") gh = GL[pkg, j]
    if (best != "") printf "<dt>In effect</dt><dd><strong>%s</strong>, an approved correction proposed by %s and approved by %s on %s (reason: %s). <a href=\"stack/%s\">The correction</a>.</dd>\n", esc(ZP[best, "SAYS"]), esc(ZP[best, "PROPOSED_BY"]), esc(ZP[best, "APPROVED_BY"]), esc(ZP[best, "APPROVED_AT"]), esc(ZP[best, "WHY"]), esc(best)
    else if (gh != "") printf "<dt>In effect</dt><dd>The machine guess below; no correction has been approved.</dd>\n"
    else printf "<dt>In effect</dt><dd>Nothing: there is no guess for this package.</dd>\n"
    if (gh == "") { printf "</dl>\n<p><span class=\"tag\">observed</span>No guess: the copyright file of this package was not read here.</p>\n"; gapsof(f, t); continue }
    if (GP[gh, "SUMMARY"] != "") printf "<dt>Confidence</dt><dd>%s (method %s, version %s)</dd>\n", esc(GP[gh, "SUMMARY"]), esc(GP[gh, "METHOD"]), esc(GP[gh, "METHOD_VERSION"])
    else if (GP[gh, "STANDARD_STANZAS_NOT_SCORED"] + 0 > 0) printf "<dt>Confidence</dt><dd>No number: the file names its licences in a form a program can read (%s paragraphs), so they are taken as stated and nothing was left to score (method %s, version %s).</dd>\n", esc(GP[gh, "STANDARD_STANZAS_NOT_SCORED"]), esc(GP[gh, "METHOD"]), esc(GP[gh, "METHOD_VERSION"])
    else printf "<dt>Confidence</dt><dd>No number: nothing in the copyright file was left to score (method %s, version %s).</dd>\n", esc(GP[gh, "METHOD"]), esc(GP[gh, "METHOD_VERSION"])
    printf "<dt>Machine guess%s</dt><dd>made %s by %s version %s from the %s copyright file <code>%s</code> (SHA-256 <code>%s</code>); <a href=\"stack/%s\">the guess atom</a>.</dd>\n", (best != "" ? " (kept)" : ""), esc(GP[gh, "MADE_AT"]), esc(GP[gh, "METHOD"]), esc(GP[gh, "METHOD_VERSION"]), esc(GP[gh, "FORMAT"]), esc(GP[gh, "FILE_READ"]), esc(GP[gh, "FILE_SHA256"]), esc(gh)
    printf "<dt>History</dt><dd>%s:", plural(GN[pkg], "guess", "guesses")
    for (j = 1; j <= GN[pkg]; j++) { g = GL[pkg, j]; printf "%s <a href=\"stack/%s\">%s</a> (%s)", (j > 1 ? ";" : ""), esc(g), esc(GP[g, "MADE_AT"]), esc(GP[g, "SUMMARY"] == "" ? "nothing to score" : GP[g, "SUMMARY"]) }
    printf ". Each links to the one before and after it. A new guess is added only when the copyright file, the reference texts or the method changed.</dd>\n"
    printf "<dt>Corrections</dt><dd>"
    if (ZN[pkg] == 0) printf "none yet"
    for (j = 1; j <= ZN[pkg]; j++) { z = ZL[pkg, j]; printf "%s<a href=\"stack/%s\">%s says %s</a> (%s%s)", (j > 1 ? "; " : ""), esc(z), esc(ZP[z, "PROPOSED_BY"]), esc(ZP[z, "SAYS"]), esc(ZP[z, "STATE"]), (ZP[z, "STATE"] == "approved" ? " by " esc(ZP[z, "APPROVED_BY"]) : "") }
    printf ". <a href=\"#correct\">How to offer one</a>.</dd>\n</dl>\n"
    if (GP[gh, "FORMAT"] == "dep5" && GP[gh, "STANDARD_STANZAS_NOT_SCORED"] + 0 > 0)
      printf "<p><span class=\"tag\">observed</span>%s paragraphs of this machine-readable file carry only standard short names (%s). They state their licence in a form a program can read, so they are taken as stated and not scored.</p>\n", esc(GP[gh, "STANDARD_STANZAS_NOT_SCORED"]), esc(GP[gh, "STANDARD_NAMES"])
    gapsof(f, t)
    if (SN[gh] == 0) { printf "<p><span class=\"tag\">observed</span>Nothing in this file was left to score.</p>\n"; continue }
    printf "<div class=\"scroll\" role=\"region\" aria-label=\"Stanzas scored for %s\" tabindex=\"0\">\n<table>\n<caption>Stanzas of the copyright file of %s, scored (guess %s)</caption>\n<thead><tr><th scope=\"col\">Stanza</th><th scope=\"col\">Words</th><th scope=\"col\">Confidence</th><th scope=\"col\">Matches</th></tr></thead>\n<tbody>\n", esc(pkg), esc(pkg), esc(base(gh))
    for (j = 1; j <= SN[gh]; j++) {
      h = SO[gh, j]
      b = S[gh, h, "BAND"]; gk = S[gh, h, "GAP_KIND"]
      conf = (b == "gap") ? "a gap" (gk != "" ? " (" gk ")" : "") : b " confidence"
      printf "<tr><th scope=\"row\">%s%s<br>lines %s</th><td>%s</td><td>%s<br>%s</td><td>%s</td></tr>\n", esc(S[gh, h, "STANZA"] == "" ? h : "stanza " S[gh, h, "STANZA"]), (S[gh, h, "NAME"] != "" ? ", " esc(S[gh, h, "NAME"]) : ""), esc(S[gh, h, "LINES"]), esc(S[gh, h, "WORDS"]), esc(S[gh, h, "CONFIDENCE"]), esc(conf), esc(SC[gh, h] != "" ? SC[gh, h] : (S[gh, h, "CLOSEST"] != "" ? "closest: " S[gh, h, "CLOSEST"] : "no reference"))
    }
    printf "</tbody>\n</table>\n</div>\n"
  }
  printf "<h2 id=\"correct\">Offer a correction</h2>\n"
  printf "<p><span class=\"tag\">observed</span>A guess is a guess. If you read a copyright file and see that a stanza says something else, open an issue at <a href=\"https://github.com/inputloop/orgfs/issues\">github.com/inputloop/orgfs/issues</a> or send mail to <a href=\"mailto:corwin@bru.st\">corwin@bru.st</a>, and say the package, the licence you say it is, and why. A maintainer records it with <code>orgfs stack correct PACKAGE --says LICENCE --by NAME --why REASON</code>; it then shows here as <em>proposed</em>. A different person approves it with <code>orgfs stack approve CORRECTION --by NAME</code>; the person who proposed it cannot. Only an approved correction outranks the guess, and the guess stays on this page and in its history either way. This site is static, so there is no form.</p>\n"
  printf "<h2>Not checked</h2>\n<ul>\n"
  printf "<li>That a name typed in <code>--by</code> is the person it names: orgfs does not authenticate it, so the rule that a proposer cannot approve is about names, not people.</li>\n"
  printf "<li>That the standard short names list (<code>share/dep5-names.txt</code>) matches the DEP-5 specification: it was written from memory, and the specification is not on the host.</li>\n"
  printf "<li>That any band is right. The edges are invented, and no reader has yet compared a band with a lawyer&#39;s reading.</li>\n"
  printf "<li>Paragraphs of a machine-readable file whose names are standard are not scored, even where their text might disagree with the name.</li>\n"
  printf "<li>Which commits make each version distinct: that needs the upstream tree of each tool, which is not read yet.</li>\n"
  if (live == 1) {
    printf "<li>That the tools read are the ones that ran the tests: they are read after the tests, on the same machine, and a tool replaced between the two would show here as the new one.</li>\n"
    printf "<li>That the Debian links lead where the package names say: they are links, and nothing is fetched.</li>\n"
    printf "<li>That earlier builds had the same tools: the tool atoms are written again by each build and only the licence guesses keep a history.</li>\n"
  }
  printf "</ul>\n"
}
'

# Is the stack the build machine's own?  Sets SK_LIVE (1 only if every claim of "this machine built this page" holds)
# and, when it is 0, SK_WHY (the reason, in plain words).  Nothing here is read from the network.
#   asked   --live was given (make site STACK=DIR does)
#   holds   a build run named STAMP-HASH12 and a 40-hex commit that begins with that hash; every tool atom is tagged
#           SEEN_HERE (not CARRIED), was read on this host (uname -n), and was read at or after the build's own stamp
SK_LIVE=0; SK_WHY=; SK_HOST=; SK_EMACS=; SK_ORG=; SK_OCLINE=; SK_OCWHY=
site_live() { # STACKDIR
  SK_LIVE=0; SK_WHY=; SK_OCLINE=; SK_OCWHY=; SK_EMACS=; SK_ORG=
  SK_HOST=$(st_sane "$(uname -n 2>/dev/null)")
  [ -n "$1" ] || return 0
  if [ "$O_LIVE" != 1 ]; then SK_WHY="this site was built from an example stack that was read on another machine"; return 0; fi
  if [ -z "$O_BRUN" ]; then SK_WHY="no build run was named (--build-run), so there is no log to link and no start time to compare"; return 0; fi
  printf '%s' "$O_BRUN" | grep -Eq '^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$' || { SK_WHY="the build run name is not STAMP-HASH12"; return 0; }
  printf '%s' "$O_BCOMMIT" | grep -Eq '^[0-9a-f]{40}$' || { SK_WHY="no 40-character commit was named (--build-commit)"; return 0; }
  _h12=${O_BCOMMIT%"${O_BCOMMIT#????????????}"}
  [ "${O_BRUN#*Z-}" = "$_h12" ] || { SK_WHY="the build run $O_BRUN does not name the commit $O_BCOMMIT"; return 0; }
  _sn=$(printf '%s' "${O_BRUN%%-*}" | tr -d TZ)
  _n=0
  for _f in "$1"/tool-*.org; do
    [ -f "$_f" ] || continue
    _n=$((_n + 1)); _b=${_f##*/}
    _tag=$(head -n 1 "$_f" | sed -n 's/^\* [^ ]*  *//p')
    [ "$_tag" = ":SEEN_HERE:" ] || { SK_WHY="the atom $_b is not marked as read on this machine (its heading tag is '$_tag'; a carried atom came from a seed)"; return 0; }
    _on=$(prop_of READ_ON "$_f")
    [ "$_on" = "$SK_HOST" ] || { SK_WHY="the atom $_b was read on '$_on', and this site is built on '$SK_HOST'"; return 0; }
    _at=$(prop_of READ_AT "$_f"); _an=$(printf '%s' "$_at" | tr -d ':TZ-')
    case $_an in ''|*[!0-9]*) SK_WHY="the atom $_b has no usable READ_AT"; return 0;; esac
    [ "$_an" -ge "$_sn" ] || { SK_WHY="the atom $_b was read at $_at, before this build began (${O_BRUN%%-*}): the stack step did not run in this build"; return 0; }
  done
  [ "$_n" -gt 0 ] || { SK_WHY="there are no tool atoms in $1"; return 0; }
  SK_LIVE=1
  SK_EMACS=$(prop_of VERSION "$1/tool-emacs.org" 2>/dev/null); SK_ORG=$(prop_of VERSION "$1/tool-org.org" 2>/dev/null)
  if [ -z "$O_BLOG" ]; then SK_OCWHY="no log of this build was named (--build-log)"
  elif [ ! -r "$O_BLOG" ]; then SK_OCWHY="the log of this build, $O_BLOG, cannot be read here"
  else
    # the first org_check summary line (OK, NOT CHECKED or FAILED; not the "ok ..." progress lines before it) of the check phase of this run's log ("== check" up to the next "== ")
    SK_OCLINE=$($AWK '/^== / { ph = $2 } ph == "check" && /^org_check: (OK|NOT CHECKED|FAILED)/ { print; exit }' "$O_BLOG" | head -n 1 | st_sane_stdin)
    [ -n "$SK_OCLINE" ] || SK_OCWHY="the check phase of the log of this build has no org_check line yet"
  fi
  return 0
}
st_sane_stdin() { tr '\t' ' ' | tr -d '\000-\010\013-\037' | head -n 1; }

site_stack() { # OUT STACKDIR
  _so=$1; _sd=$2
  [ -d "$_sd" ] || die "site: no stack directory $_sd"
  mkdir -p "$TMP/sc" || die "site: no temp space"
  : > "$TMP/sc/siteflat"
  ( cd "$_sd" && for _f in tool-*.org guesses/*/*.org corrections/*/*.org; do
      [ -f "$_f" ] || continue
      $AWK "$PROPS_AWK" "$_f"
      case $_f in tool-*.org)
        # the command that gave the version is the first "$ " line of the atom's first quoted block; the tag is the heading's own
        $AWK -v f="$_f" 'BEGIN { OFS = "\t" } /^#\+BEGIN_EXAMPLE/ && !seen { inb = 1; next } inb && /^\$ / { c = $0; gsub(/\t/, " ", c); print f, "", "__CMD", c; seen = 1; inb = 0 } /^#\+END_EXAMPLE/ { inb = 0 }' "$_f";;
      esac
    done ) >> "$TMP/sc/siteflat" 2>/dev/null
  # the atoms themselves, so that every link on the page leads somewhere
  for _f in "$_sd"/story.org "$_sd"/tool-*.org "$_sd"/guesses/*/*.org "$_sd"/corrections/*/*.org "$_sd"/references/*.org; do
    [ -f "$_f" ] || continue
    _rel=${_f#"$_sd"/}
    mkdir -p "$_so/stack/$(dirname "$_rel")" || die "site: cannot create $_so/stack"
    cp "$_f" "$_so/stack/$_rel"
  done
  {
    if [ "$SK_LIVE" = 1 ]; then html_head "The machine that built this page" stack; else html_head "The tools orgfs stands on" stack; fi
    $AWK -v order="$ST_TOOLS" -v version="$VERSION" -v live="$SK_LIVE" -v asked="${O_LIVE:-0}" -v why="$SK_WHY" -v brun="$O_BRUN" -v bcommit="$O_BCOMMIT" "$STACK_HTML_AWK" "$TMP/sc/siteflat" < /dev/null
    html_foot
  } > "$_so/stack.html"
}

site_who() { # OUT: who.org and who.html, or a page that says there was no history to read
  _wrepo=${O_REPO:-}
  if [ -z "$_wrepo" ]; then
    _wtop=$(git -C "$HERE/.." rev-parse --show-toplevel 2>/dev/null) || _wtop=
    _where=$(cd "$HERE/.." && pwd -P)
    [ -z "$_wtop" ] || [ "$_wtop" != "$_where" ] || _wrepo=$HERE/..
  fi
  {
    html_head "Who worked on this, over time" who
    printf '<h1>Who worked on this, over time</h1>\n'
    if [ -n "$_wrepo" ]; then
      WHO_SINCE=; WHO_UNTIL=; WHO_CMD_REPO=REPO
      who_doc "$_wrepo" "the repository this site was built from" "$1/who.org"
      cat <<EOF
<p class="status">Status: orgfs $VERSION, before 1.0. This page is the output of <code>orgfs who</code> over the history of the repository this site was built from, turned into HTML, and nothing in it is added by hand. Names and emails are as the commits give them. Nothing on this page says the tests passed; run <code>make check</code>.</p>
<p>In the command, REPO is the repository this site was built from. The same document, as the Org file Emacs reads: <a href="who.org">who.org</a>. To run it on your own repository, see <em>Try it on your own repository</em> in the README at <a href="https://github.com/inputloop/orgfs">github.com/inputloop/orgfs</a>.</p>
EOF
      $AWK "$WHO_HTML_AWK" "$1/who.org"
      cat <<EOF
<h2>Not checked</h2>
<ul>
<li>That the log is the whole history: a shallow clone, a rewritten history or a squashed import shows less than happened.</li>
<li>Whether any two headings are one person; the page does not guess.</li>
<li>Work that git does not record: a co-author named only in a message, a committer who is not the author, work done elsewhere.</li>
</ul>
EOF
    else
      cat <<EOF
<p class="status">Status: orgfs $VERSION, before 1.0. Nothing on this page says the tests passed; run <code>make check</code>.</p>
<p><span class="tag">observed</span>This site was built by a copy of orgfs that is not inside a git repository, and no repository was named, so there was no history to read.</p>
<h2>Not checked</h2>
<ul>
<li><span class="tag">judged</span>NOT CHECKED: who worked on orgfs, over time. To fill it, build the site from a checkout: <code>sh bin/orgfs site examples/licensing.d _site</code>, or name a repository with <code>--repo DIR</code>.</li>
</ul>
EOF
    fi
    html_foot
  } > "$1/who.html"
}

# ------------------------------------------------------------------ site
esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
esc_s() { printf '%s' "$1" | esc; }
cur() { [ "$1" = "$2" ] && printf ' aria-current="page"'; return 0; }

write_css() {
  cat > "$1" <<'CSS'
:root {
  color-scheme: light dark;
  --bg: #ffffff; --fg: #111111; --mut: #4a4a4a; --link: #0b3d91; --visited: #5b2a86;
  --rule: #6b6b6b; --band: #f0f0f0;
  /* One width for the whole page: about 66 characters of the body font (ch is the width of "0",
     about .55em in a system sans, so 66ch is near 36rem). Set in rem, once, on body: a ch value on
     each element would be measured in that element's own font and give every element its own edge. */
  --measure: 36rem; --sp: 1.6rem;
  --s-1: 0.875rem; --s0: 1rem; --s1: 1.2rem; --s2: 1.44rem; --s3: 1.728rem; --s4: 2.074rem;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #121212; --fg: #eeeeee; --mut: #c4c4c4; --link: #9ec1ff; --visited: #d4b8ff; --rule: #8a8a8a; --band: #1e1e1e; }
}
html { font-size: 100%; -webkit-text-size-adjust: 100%; }
body {
  background: var(--bg); color: var(--fg);
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif; font-size: var(--s0); line-height: 1.6;
  margin: 0 auto; max-width: var(--measure); padding: 0 1.25rem 4rem;
}
p, ul, ol, dl, blockquote, pre { margin: 0 0 var(--sp); }
li { margin: 0 0 .4rem; }
a { color: var(--link); text-underline-offset: .15em; }
a:visited { color: var(--visited); }
a:focus-visible, .scroll:focus-visible, pre:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }
.skip { position: absolute; left: -999px; }
.skip:focus { left: 1rem; top: 1rem; background: var(--bg); border: 2px solid var(--fg); padding: .5rem .75rem; z-index: 1; }
header { border-bottom: 2px solid var(--rule); padding: 1.25rem 0 .75rem; margin-bottom: var(--sp); }
.brand { font-size: var(--s3); font-weight: 700; line-height: 1.2; margin: 0; letter-spacing: -.01em; }
nav ul { list-style: none; margin: .6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }
nav li { margin: 0; }
nav a { display: inline-block; padding: .25rem 0; }
nav a[aria-current="page"] { font-weight: 700; text-decoration: none; border-bottom: 3px solid currentColor; }
h1 { font-size: var(--s4); line-height: 1.15; margin: calc(var(--sp) * 1.25) 0 var(--sp); letter-spacing: -.01em; }
h2 { font-size: var(--s2); line-height: 1.25; margin: calc(var(--sp) * 2) 0 calc(var(--sp) * .5); padding-top: calc(var(--sp) * .5); border-top: 1px solid var(--rule); }
h3 { font-size: var(--s1); line-height: 1.3; margin: var(--sp) 0 .4rem; }
code, pre { font-family: ui-monospace, "Cascadia Mono", Menlo, Consolas, monospace; font-size: .92em; }
code { overflow-wrap: anywhere; }
pre { background: var(--band); border: 1px solid var(--rule); border-left-width: 6px; padding: .75rem 1rem; overflow-x: auto; white-space: pre; line-height: 1.45; }
.status { font-family: ui-monospace, "Cascadia Mono", Menlo, Consolas, monospace; font-size: var(--s-1); background: var(--band); border-left: 6px solid var(--fg); padding: .6rem .9rem; }
.tag { display: inline-block; font-size: var(--s-1); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; border: 1px solid var(--fg); padding: 0 .4rem; margin-right: .5rem; }
blockquote { border-left: 4px solid var(--rule); padding: 0 0 0 1rem; margin-left: 0; }
blockquote p { margin: 0 0 .4rem; }
blockquote footer { border: 0; margin: 0; padding: 0; font-size: var(--s-1); color: var(--mut); }
.scroll { overflow-x: auto; margin: 0 0 var(--sp); }
table { border-collapse: collapse; width: 100%; font-size: var(--s-1); font-variant-numeric: tabular-nums; }
caption { text-align: left; font-weight: 700; font-size: var(--s0); padding: 0 0 .5rem; }
th, td { padding: .5rem .75rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
thead th { background: var(--band); border-bottom: 2px solid var(--fg); }
tbody tr:nth-child(even) { background: var(--band); }
tbody th { white-space: nowrap; }
td.yes { font-weight: 700; }
td.no { color: var(--mut); }
dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1.25rem; }
dt { font-weight: 700; }
dd { margin: 0; overflow-wrap: anywhere; }
.go { font-size: var(--s1); font-weight: 700; }
.gap { border: 2px solid var(--rule); border-left-width: 8px; padding: .75rem 1rem 0; margin: 0 0 var(--sp); }
.gap h3 { margin-top: 0; }
footer { border-top: 2px solid var(--rule); margin-top: calc(var(--sp) * 2); padding-top: .75rem; color: var(--mut); font-size: var(--s-1); }
@media (max-width: 40rem) {
  body { padding: 0 1rem 3rem; }
  h1 { font-size: var(--s3); }
  dl { grid-template-columns: 1fr; }
  dt { margin-top: .5rem; }
}
@media print {
  :root { --bg: #ffffff; --fg: #000000; --mut: #000000; --link: #000000; --visited: #000000; --rule: #000000; --band: #ffffff; }
  body { font-size: 11pt; line-height: 1.4; max-width: none; padding: 0; }
  nav, .skip { display: none; }
  a { text-decoration: underline; }
  a[href^="https:"]::after { content: " (" attr(href) ")"; font-size: .85em; overflow-wrap: anywhere; }
  pre { white-space: pre-wrap; overflow: visible; border: 1px solid #000000; }
  .scroll { overflow: visible; }
  table, tr, .gap, blockquote, pre { break-inside: avoid; }
  h1, h2, h3, caption { break-after: avoid; }
  tbody tr:nth-child(even) { background: none; }
  @page { margin: 18mm; }
}
CSS
}

# the expanded declaration as HTML: headings, paragraphs, lists, property drawers and tables only
ORG_HTML_AWK='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
function inl(s,   out) {
  s = esc(s); out = ""
  while (match(s, /=[^= ][^=]*=/)) { out = out substr(s, 1, RSTART - 1) "<code>" substr(s, RSTART + 1, RLENGTH - 2) "</code>"; s = substr(s, RSTART + RLENGTH) }
  return out s
}
function closep() { if (para) { print "</p>"; para = 0 } if (inul) { print "</ul>"; inul = 0 } }
function closet() { if (intab) { print "</tbody>\n</table>\n</div>"; intab = 0 } }
BEGIN { para = 0; inul = 0; intab = 0; indrw = 0; ntab = 0 }
indrw { if ($0 == ":END:") { print "</dl>"; indrw = 0; next }
  if (match($0, /^:[A-Za-z_-]+:/)) { k = substr($0, 2, RLENGTH - 2); v = substr($0, RLENGTH + 1); sub(/^[ \t]+/, "", v); printf "<dt>%s</dt><dd>%s</dd>\n", esc(k), esc(v) }
  next }
/^\*+ / { closep(); closet(); n = 0; while (substr($0, n + 1, 1) == "*") n++; h = n + 1; if (h > 6) h = 6; t = substr($0, n + 2); printf "<h%d>%s</h%d>\n", h, inl(t), h; next }
/^:PROPERTIES:$/ { closep(); closet(); print "<dl>"; indrw = 1; next }
/^#\+NAME:/ { next }
/^\|/ {
  if ($0 ~ /^\|[-+|]*$/) next
  closep()
  n = split($0, c, "|")
  if (!intab) { ntab++; printf "<div class=\"scroll\" role=\"region\" aria-label=\"Table %d of the declaration\" tabindex=\"0\">\n<table>\n<caption>The table of atoms and their hashes</caption>\n<thead><tr>", ntab
    for (m = 2; m < n; m++) { sub(/^ +/, "", c[m]); sub(/ +$/, "", c[m]); printf "<th scope=\"col\">%s</th>", inl(c[m]) }
    print "</tr></thead>\n<tbody>"; intab = 1; next }
  printf "<tr>"
  for (m = 2; m < n; m++) { sub(/^ +/, "", c[m]); sub(/ +$/, "", c[m]); if (m == 2) printf "<th scope=\"row\">%s</th>", inl(c[m]); else printf "<td>%s</td>", inl(c[m]) }
  print "</tr>"; next }
/^[ \t]*$/ { closep(); closet(); next }
/^- / { closet(); if (para) { print "</p>"; para = 0 } if (!inul) { print "<ul>"; inul = 1 } printf "<li>%s</li>\n", inl(substr($0, 3)); next }
{ closet(); if (inul) { print "</ul>"; inul = 0 } if (!para) { printf "<p>"; para = 1 } else printf "\n"; printf "%s", inl($0) }
END { closep(); closet() }
'

html_head() { # TITLE PAGE
  cat <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'">
<title>$1 - orgfs</title>
<link rel="stylesheet" href="orgfs.css">
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<header>
<p class="brand">orgfs</p>
<nav aria-label="Site">
<ul>
<li><a href="index.html"$(cur index "$2")>About</a></li>
$([ "${_allpublic:-0}" != 1 ] || printf '<li><a href="declaration.html"%s>The declaration</a></li>\n' "$(cur declaration "$2")")
<li><a href="made.html"$(cur made "$2")>How this was made</a></li>
<li><a href="who.html"$(cur who "$2")>Who worked on this</a></li>
<li><a href="gaps.html"$(cur gaps "$2")>A view with its gaps</a></li>
<li><a href="licensing.html"$(cur licensing "$2")>Licensing stack</a></li>
$([ "${_stackpage:-0}" != 1 ] || printf '<li><a href="stack.html"%s>%s</a></li>\n' "$(cur stack "$2")" "$([ "${_stacklive:-0}" = 1 ] && echo 'The machine that built this' || echo 'Tools it stands on')")
<li><a href="rights.html"$(cur rights "$2")>Your rights on this site</a></li>
</ul>
</nav>
</header>
<main id="main">
EOF
}

